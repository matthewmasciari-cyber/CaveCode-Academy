@page "/minigames/cpp/mission-4"
@using CaveCode.CourseEngine
@using Microsoft.JSInterop
@inject CourseEngineService CourseEngine
@inject ProgressionService ProgressionService
@inject AchievementService AchievementService
@inject IJSRuntime JS

<PageTitle>C++ Engine Foundry Mission 4 | CaveCode Academy</PageTitle>

@if (!AccessReady)
{
    <main class="m4-gate"><section><strong>C++</strong><h1>Preparing Mission 4</h1><p>Checking Chapter 1 and Mission 3 completion.</p></section></main>
}
else if (!AccessGranted)
{
    <main class="m4-gate">
        <section>
            <strong>C++</strong>
            <h1>Sensor Package Recovery is locked</h1>
            <p>Complete C++ Chapter 1 and Engine Foundry Mission 3 first.</p>
            <NavLink href="/minigames/cpp/mission-3">Open Mission 3 →</NavLink>
        </section>
    </main>
}
else
{
    <main class="m4-shell">
        <header>
            <div>
                <p>ENGINE FOUNDRY · MISSION 4 · PASS 7E-3B-2</p>
                <h1>Rebuild the Sensor Data Package</h1>
                <span>Repair a C++ struct that groups pressure, temperature, and alarm state.</span>
            </div>
            <nav>
                <NavLink href="/minigames/cpp">Mission 1</NavLink>
                <NavLink href="/minigames/cpp/mission-2">Mission 2</NavLink>
                <NavLink href="/minigames/cpp/mission-3">Mission 3</NavLink>
                <NavLink class="selected" href="/minigames/cpp/mission-4">Mission 4</NavLink>
                <NavLink href="/minigames/cpp/mission-5">Mission 5</NavLink>
                <NavLink href="/minigames">Hub</NavLink>
            </nav>
        </header>

        <section class="notice">
            <strong>Mission foundation</strong>
            <span>Live requirements, damaged profiles, hints, and simulated diagnostics are active. Scoring and rewards are deferred.</span>
        </section>

        <section class="record-summary" aria-label="Saved Mission 4 record">
            <div><small>Best score</small><strong>@SavedState.BestScore.ToString("N0")</strong></div>
            <div><small>Fastest clear</small><strong>@FastestClearLabel</strong></div>
            <div><small>Total clears</small><strong>@SavedState.TotalClears</strong></div>
            <div><small>Mission XP</small><strong>@SavedState.TotalXpEarned.ToString("N0")</strong></div>
        </section>

        <section class="profiles">
            <div><h2>@CurrentProfile.Title</h2><p>@CurrentProfile.Description</p></div>
            <div class="profile-buttons">
                @foreach (DamageProfile profile in Profiles)
                {
                    <button class="@(SelectedProfile == profile.Id ? "selected" : "")"
                            @onclick="() => SelectProfile(profile.Id)">
                        <strong>@profile.ShortName</strong><span>@profile.Focus</span>
                    </button>
                }
            </div>
        </section>

        <div class="grid">
            <aside class="panel">
                <h2>Sensor package checklist</h2>
                <strong>@Checks.Count(c => c.Met) / 6</strong>
                @foreach (MissionCheck check in Checks)
                {
                    <div class="check @(check.Met ? "met" : "")">
                        <b>@(check.Met ? "✓" : "○")</b>
                        <span><strong>@check.Label</strong><small>@check.Description</small></span>
                    </div>
                }
                <div class="status"><small>MISSION STATUS</small><strong>@MissionStatus</strong><span>@WorkspaceMessage</span></div>
                <section class="score-panel">
                    <div><small>Projected</small><strong>@ProjectedScore / 1000</strong></div>
                    <div><small>Requirements</small><strong>@RequirementPoints / 840</strong></div>
                    <div><small>Time bonus</small><strong>@CurrentTimeBonus / 160</strong></div>
                    <div><small>Hint penalty</small><strong>-@HintPenalty</strong></div>
                    <div><small>Elapsed</small><strong>@ElapsedLabel</strong></div>
                </section>
                @if (SubmissionComplete)
                {
                    <section class="result @(MissionPassed ? "passed" : "failed")">
                        <strong>@(MissionPassed ? "MISSION PASSED" : "MISSION FAILED")</strong>
                        <span>@FinalScore / 1000 · @FinalElapsedLabel</span>
                        <p>@ResultMessage</p>
                        @if (RewardProcessing)
                        {
                            <small>Saving Mission 4 rewards…</small>
                        }
                        else if (!string.IsNullOrWhiteSpace(RewardMessage))
                        {
                            <small>@RewardMessage</small>
                        }
                        @if (MissionAchievement?.NewlyUnlocked == true)
                        {
                            <small>Achievement unlocked: Sensor Package Restored · Title available: Systems Data Builder</small>
                        }
                    </section>
                }
            </aside>

            <section class="editor-panel">
                <div class="toolbar"><strong>SensorPackage.cpp</strong><span>@LineCount lines</span></div>
                <textarea @bind="EditorCode" @bind:event="oninput" spellcheck="false"></textarea>
                <div class="controls">
                    <button class="primary" @onclick="RunSimulation">Run simulation</button>
                    <button @onclick="ResetWorkspace">Reset profile</button>
                    <button @onclick="ToggleHint">@(HintVisible ? "Hide hint" : "Hint")</button>
                    <button class="submit" disabled="@SubmissionComplete" @onclick="SubmitMission">Submit mission</button>
                    @if (SubmissionComplete)
                    {
                        <button @onclick="NewAttempt">New attempt</button>
                    }
                </div>
                @if (HintVisible)
                {
                    <div class="hint"><strong>@CurrentProfile.HintTitle</strong><p>@CurrentProfile.HintText</p></div>
                }
            </section>

            <aside class="side">
                <section class="panel">
                    <h2>Struct reference</h2>
                    <code>struct SensorData</code>
                    <p><code>int pressure;</code></p>
                    <p><code>double temperature;</code></p>
                    <p><code>bool alarmActive;</code></p>
                </section>
                <section class="console">
                    <strong>SIMULATED OUTPUT</strong>
                    @if (ConsoleLines.Count == 0)
                    {
                        <p>[READY] Run diagnostics.</p>
                    }
                    else
                    {
                        @foreach (string line in ConsoleLines)
                        {
                            <p>@line</p>
                        }
                    }
                </section>
            </aside>
        </div>
    </main>
}

<style>
    .m4-shell,.m4-gate{min-height:100vh;box-sizing:border-box;color:var(--text,#edf4ff);background:var(--bg,#08111f);font-family:Inter,system-ui,sans-serif}
    .m4-shell{padding:22px}.m4-gate{display:grid;place-items:center;padding:24px}.m4-gate section,.panel,.editor-panel,.profiles,.console{background:var(--surface-soft,#111c2c);border:1px solid var(--border,#2b3b52);border-radius:13px}
    .m4-gate section{width:min(620px,100%);padding:32px;text-align:center}.m4-gate a,.m4-shell a,.controls button,.profile-buttons button{color:var(--text,#edf4ff);background:var(--surface-strong,#172539);border:1px solid var(--border,#2b3b52);border-radius:9px;padding:10px 13px;text-decoration:none;font-weight:800;cursor:pointer}
    header{max-width:1600px;margin:0 auto 15px;display:flex;justify-content:space-between;gap:18px;align-items:center}header p{color:var(--accent,#61dafb);font-size:10px;font-weight:900}header span,.profiles p,.notice span,.status span,.check small,.hint p{color:var(--text-muted,#aab8cb)}nav{display:flex;flex-wrap:wrap;gap:8px}.selected{border-color:var(--accent,#61dafb)!important}
    .notice{max-width:1600px;margin:0 auto 15px;padding:12px 15px;background:var(--accent-surface,rgba(97,218,251,.1));border:1px solid var(--accent-border,#4f7990);border-radius:10px;display:flex;gap:12px}
    .profiles{max-width:1600px;margin:0 auto 15px;padding:16px;display:grid;grid-template-columns:.8fr 1.2fr;gap:16px}.profile-buttons{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.profile-buttons button{text-align:left}.profile-buttons span{display:block;margin-top:4px;font-size:8px;color:var(--text-muted,#aab8cb)}
    .grid{max-width:1600px;margin:auto;display:grid;grid-template-columns:265px minmax(470px,1fr) 345px;gap:14px}.panel{padding:16px}.check{display:grid;grid-template-columns:24px 1fr;gap:8px;padding:9px;margin:7px 0;background:var(--surface,#0d1726);border:1px solid var(--border,#2b3b52);border-radius:8px}.check small{display:block;font-size:8px}.check.met{border-color:var(--accent-border,#4f7990)}.status{display:grid;gap:4px;padding:10px;margin-top:10px;background:var(--surface,#0d1726);border-radius:8px}
        .record-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));max-width:1600px;gap:10px;margin:0 auto 15px}
    .record-summary div{display:grid;gap:4px;padding:12px;background:var(--surface-soft,#111c2c);border:1px solid var(--border,#2b3b52);border-radius:10px}
    .record-summary small{color:var(--text-muted,#aab8cb);font-size:8px;text-transform:uppercase}
    .result small{color:var(--accent-soft,#9feaff);font-size:9px}
    .score-panel{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;margin-top:10px}
    .score-panel div{display:grid;gap:3px;padding:9px;background:var(--surface,#0d1726);border:1px solid var(--border,#2b3b52);border-radius:8px}
    .score-panel small,.result span,.result p{color:var(--text-muted,#aab8cb);font-size:9px}
    .result{display:grid;gap:5px;padding:10px;margin-top:10px;border-radius:8px}
    .result.passed{background:rgba(64,190,110,.12);border:1px solid rgba(96,230,140,.55)}
    .result.failed{background:rgba(230,90,90,.11);border:1px solid rgba(255,120,120,.55)}
    .controls .submit{color:#fff;background:#1769d2;border-color:#7eb8ff}
    .controls .submit:disabled{opacity:.5;cursor:not-allowed}
    .editor-panel{overflow:hidden;display:flex;flex-direction:column}.toolbar{padding:13px;display:flex;justify-content:space-between;background:var(--surface,#0d1726)}textarea{min-height:565px;flex:1;resize:none;padding:18px;color:var(--text,#edf4ff);background:var(--surface-strong,#172539);border:0;font:13px/1.6 Consolas,monospace}.controls{display:flex;gap:9px;padding:12px;background:var(--surface,#0d1726)}.controls .primary{color:var(--accent-contrast,#07111f);background:var(--accent,#61dafb)}.hint{padding:12px 14px;background:var(--accent-surface,rgba(97,218,251,.1))}
    .side{display:grid;gap:14px}.console{padding:14px;min-height:260px;background:#07100c;font:10px Consolas,monospace}
    @@media(max-width:1240px){.grid{grid-template-columns:240px 1fr}.side{grid-column:1/-1;grid-template-columns:1fr 1fr}}
    @@media(max-width:820px){header{align-items:flex-start;flex-direction:column}.record-summary{grid-template-columns:repeat(2,minmax(0,1fr))}.profiles,.grid,.side{grid-template-columns:1fr}.profile-buttons{grid-template-columns:1fr}.side{grid-column:auto}}
</style>

@code {
    private const string FullCode =
        "#include <iostream>\n\nclass SensorData\n{\n    int pressure;\n    int temperature;\n}\n\nint main()\n{\n    SensorData pumpSensor;\n    pumpSensor.pressure = 48;\n    pumpSensor.temperature = 72.5;\n    std::cout << \"Pressure: \" << pressure << \"\\n\";\n    return 0;\n}\n";
    private const string FieldCode =
        "#include <iostream>\n\nstruct SensorData\n{\n    int pressure;\n    int temperature;\n};\n\nint main()\n{\n    SensorData pumpSensor;\n    pumpSensor.pressure = 48;\n    pumpSensor.temperature = 72.5;\n    pumpSensor.alarmActive = false;\n    std::cout << \"Pressure: \" << pumpSensor.pressure << \"\\n\";\n    return 0;\n}\n";
    private const string AccessCode =
        "#include <iostream>\n\nstruct SensorData\n{\n    int pressure;\n    double temperature;\n    bool alarmActive;\n};\n\nint main()\n{\n    SensorData pumpSensor;\n    pressure = 48;\n    temperature = 72.5;\n    alarmActive = false;\n    std::cout << \"Pressure: \" << pressure << \"\\n\";\n    return 0;\n}\n";

    private bool AccessReady, AccessGranted, ChapterReady, MissionThreeReady, HintVisible, HasRun;
    private bool SubmissionComplete, MissionPassed;
    private bool RewardProcessing, RewardsProcessed;
    private int HintsUsed, FinalScore, FinalElapsedSeconds, AccumulatedSeconds;
    private DateTimeOffset? AttemptStartedAt;
    private string ResultMessage = "";
    private string RewardMessage = "";
    private string AttemptId = Guid.NewGuid().ToString("N");
    private MissionFourState SavedState = new();
    private AchievementUnlockResult? MissionAchievement;
    private string SelectedProfile = "full", EditorCode = FullCode, WorkspaceMessage = "Repair all six struct requirements.";
    private List<string> ConsoleLines = new();

    private IReadOnlyList<DamageProfile> Profiles => new[]
    {
        new DamageProfile("full","Full Sensor Package Failure","Full Incident","Repair the complete struct and member-access flow","The declaration, fields, terminator, assignments, and output are damaged.","Start with the struct","Use struct SensorData with int pressure, double temperature, bool alarmActive, and finish with };"),
        new DamageProfile("fields","Sensor Field Failure","Field Types","Repair the temperature type and alarm field","The struct exists, but its field types are incomplete.","Match fields to data","Use double temperature and bool alarmActive."),
        new DamageProfile("access","Member Access Failure","Dot Operator","Repair assignments and output through pumpSensor","The struct is correct, but its object members are not accessed correctly.","Use the object name","Prefix each field with pumpSensor.")
    };

    private DamageProfile CurrentProfile => Profiles.First(p => p.Id == SelectedProfile);
    private int LineCount => EditorCode.Replace("\r\n","\n").Split('\n').Length;
    private string MissionStatus => Checks.All(c=>c.Met) ? "Sensor package structurally ready" : HasRun ? "Diagnostics found unresolved repairs" : "Incident loaded";
    private int PassedRequirementCount => Checks.Count(c => c.Met);
    private int RequirementPoints => PassedRequirementCount * 140;
    private int ElapsedSeconds => SubmissionComplete
        ? FinalElapsedSeconds
        : AccumulatedSeconds +
          (AttemptStartedAt.HasValue
              ? Math.Max(0, (int)(DateTimeOffset.UtcNow - AttemptStartedAt.Value).TotalSeconds)
              : 0);
    private int CurrentTimeBonus => Math.Clamp(160 - (ElapsedSeconds / 5) * 5, 0, 160);
    private int HintPenalty => HintsUsed * 40;
    private int ProjectedScore => Math.Clamp(RequirementPoints + CurrentTimeBonus - HintPenalty, 0, 1000);
    private string ElapsedLabel => FormatTime(ElapsedSeconds);
    private string FinalElapsedLabel => FormatTime(FinalElapsedSeconds);
    private string FastestClearLabel =>
        SavedState.FastestSeconds.HasValue
            ? FormatTime((int)Math.Round(SavedState.FastestSeconds.Value))
            : "--:--";

    private IReadOnlyList<MissionCheck> Checks => new[]
    {
        new MissionCheck("Struct declaration","Declare struct SensorData.",Has(@"struct\s+SensorData\s*\{")),
        new MissionCheck("Pressure field","Add int pressure.",Has(@"int\s+pressure\s*;")),
        new MissionCheck("Temperature field","Add double temperature.",Has(@"double\s+temperature\s*;")),
        new MissionCheck("Alarm field","Add bool alarmActive.",Has(@"bool\s+alarmActive\s*;")),
        new MissionCheck("Struct terminator","End the struct with };.",Has(@"\}\s*;")),
        new MissionCheck("Object member access","Use pumpSensor for all fields.",EditorCode.Contains("pumpSensor.pressure")&&EditorCode.Contains("pumpSensor.temperature")&&EditorCode.Contains("pumpSensor.alarmActive"))
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            CourseProgressSnapshot progress = await CourseEngine.GetProgressAsync(CourseIds.Cpp);
            ChapterReady = progress.ModuleCompleted.Length > 7 && progress.ModuleCompleted[7];
            MissionThreeState state = await JS.InvokeAsync<MissionThreeState>("caveCodeCppMinigame.getMissionThreeState");
            MissionThreeReady = state.Completed;
            SavedState = await JS.InvokeAsync<MissionFourState>("caveCodeCppMinigame.getMissionFourState");
            AccessGranted = ChapterReady && MissionThreeReady;
        }
        catch { AccessGranted = false; }
        AccessReady = true;
        await InvokeAsync(StateHasChanged);
    }

    private void SelectProfile(string id)
    {
        SelectedProfile=id;
        EditorCode=id=="fields"?FieldCode:id=="access"?AccessCode:FullCode;
        HintVisible=false;HasRun=false;HintsUsed=0;
        SubmissionComplete=false;MissionPassed=false;FinalScore=0;FinalElapsedSeconds=0;
        AccumulatedSeconds=0;AttemptStartedAt=null;ResultMessage="";
        RewardMessage="";RewardProcessing=false;RewardsProcessed=false;
        MissionAchievement=null;AttemptId=Guid.NewGuid().ToString("N");
        ConsoleLines.Clear();
        WorkspaceMessage=CurrentProfile.Title+" restored to its damaged state.";
    }

    private void RunSimulation()
    {
        if (SubmissionComplete) return;
        EnsureClock();
        HasRun=true;ConsoleLines.Clear();
        ConsoleLines.Add("[SIM] Sensor Package diagnostics started.");
        foreach(var check in Checks) ConsoleLines.Add(check.Met?$"[OK] {check.Label}":$"[WARN] Unresolved: {check.Label}");
        WorkspaceMessage=$"{Checks.Count(c=>c.Met)} of 6 requirements currently pass.";
    }

    private void ResetWorkspace()=>SelectProfile(SelectedProfile);
    private void ToggleHint()
    {
        bool opening = !HintVisible;
        HintVisible = opening;
        if (opening && !SubmissionComplete)
        {
            HintsUsed += 1;
            EnsureClock();
        }
    }

    private async Task SubmitMission()
    {
        if (SubmissionComplete) return;
        StopClock();

        FinalElapsedSeconds = AccumulatedSeconds;
        MissionPassed = Checks.All(c => c.Met);
        FinalScore = Math.Clamp(
            RequirementPoints +
            Math.Clamp(160 - (FinalElapsedSeconds / 5) * 5, 0, 160) -
            HintPenalty,
            0,
            1000);

        SubmissionComplete = true;
        HasRun = true;
        ResultMessage = MissionPassed
            ? "All six sensor-package requirements passed. Rewards remain disabled until Pass 7E-3B-2."
            : $"{PassedRequirementCount} of 6 requirements passed. Start a new attempt after repairing the remaining checks.";

        ConsoleLines.Add(
            MissionPassed
                ? $"[RESULT] PASS · {FinalScore}/1000"
                : $"[RESULT] FAIL · {FinalScore}/1000");

        if (MissionPassed)
        {
            await ProcessRewardsAsync();
        }
    }

    private async Task ProcessRewardsAsync()
    {
        if (RewardProcessing || RewardsProcessed) return;
        RewardProcessing = true;
        RewardMessage = "";

        try
        {
            MissionFourRecord result =
                await JS.InvokeAsync<MissionFourRecord>(
                    "caveCodeCppMinigame.recordMissionFourClear",
                    AttemptId,
                    FinalScore,
                    FinalElapsedSeconds,
                    SelectedProfile);

            int validatedLines =
                EditorCode.Replace("\r\n", "\n")
                    .Split('\n')
                    .Count(line => !string.IsNullOrWhiteSpace(line));

            await ProgressionService.AwardMinigameRunAsync(
                CourseIds.Cpp,
                result.RewardKey,
                result.XpAwarded,
                validatedLines);

            await AchievementService.AwardMinigameCrystalsAsync(
                result.RewardKey,
                result.CrystalsAwarded);

            MissionAchievement =
                await AchievementService.UnlockChapterAsync(
                    "cpp-minigame",
                    4);

            SavedState = result.State;
            RewardsProcessed = true;

            RewardMessage =
                $"+{result.XpAwarded} C++ XP, ◆ {result.CrystalsAwarded} crystals, and {validatedLines} validated C++ lines saved.";

            try
            {
                await JS.InvokeVoidAsync(
                    "caveCodeProgression.syncLeaderboardProfile");
            }
            catch { }
        }
        catch (Exception error)
        {
            RewardMessage =
                "Mission passed, but reward saving failed: " +
                error.Message;
        }
        finally
        {
            RewardProcessing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void NewAttempt()
    {
        SelectProfile(SelectedProfile);
        WorkspaceMessage = CurrentProfile.Title + " loaded as a new scored attempt.";
    }

    private void EnsureClock()
    {
        if (!AttemptStartedAt.HasValue)
        {
            AttemptStartedAt = DateTimeOffset.UtcNow;
        }
    }

    private void StopClock()
    {
        if (!AttemptStartedAt.HasValue) return;
        AccumulatedSeconds += Math.Max(
            0,
            (int)(DateTimeOffset.UtcNow - AttemptStartedAt.Value).TotalSeconds);
        AttemptStartedAt = null;
    }

    private static string FormatTime(int seconds) =>
        $"{seconds / 60:00}:{seconds % 60:00}";
    private bool Has(string pattern)=>System.Text.RegularExpressions.Regex.IsMatch(EditorCode,pattern);
    private sealed record MissionCheck(string Label,string Description,bool Met);
    private sealed record DamageProfile(string Id,string Title,string ShortName,string Focus,string Description,string HintTitle,string HintText);
    private sealed class MissionThreeState{public bool Completed{get;set;}}

    private sealed class MissionFourState
    {
        public bool Completed { get; set; }
        public int BestScore { get; set; }
        public double? FastestSeconds { get; set; }
        public int TotalClears { get; set; }
        public int TotalXpEarned { get; set; }
        public int TotalCrystalsEarned { get; set; }
    }

    private sealed class MissionFourRecord
    {
        public string RewardKey { get; set; } = "";
        public int XpAwarded { get; set; }
        public int CrystalsAwarded { get; set; }
        public MissionFourState State { get; set; } = new();
    }
}
