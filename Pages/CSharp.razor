    private string NextStageLabel()
    {
        TrainingStage next = (int)CurrentStage < (int)TrainingStage.Complete
            ? (TrainingStage)((int)CurrentStage + 1)
            : TrainingStage.Complete;

        return StageLabel(next).ToLowerInvariant();
    }

    private IEnumerable<string> ConceptPoints(Lesson lesson)
    {
        yield return "Read the declaration from left to right: type, name, assignment, value, ending.";
        yield return "C# is case-sensitive, so capitalization is part of the code.";
        yield return "The game preview applies this module's result after you pass a stage.";
    }

    private PreviewState Preview
    {
        get
        {
            PreviewState state = new();

            for (int index = 0; index < Lessons.Count; index++)
            {
                if (ModuleCompleted[index])
                {
                    ApplyPreviewEffect(state, index + 1);
                }
            }

            if (!ModuleCompleted[CurrentModuleIndex] && StagePassed)
            {
                ApplyPreviewEffect(state, CurrentModuleIndex + 1);
            }

            return state;
        }
    }

    private static void ApplyPreviewEffect(PreviewState state, int module)
    {
        switch (module)
        {
            case 1: state.Health = 100; break;
            case 2: state.Stone = 0; break;
            case 3: state.Name = "Miner"; break;
            case 4: state.HasPickaxe = true; break;
            case 5: state.Speed = 2.5; break;
            case 6: state.Health = 80; break;
            case 7: state.Stone += 3; break;
            case 8:
                state.Name = "Miner"; state.Health = 100; state.Stone = 0;
                state.HasPickaxe = true; state.Speed = 2.5;
                break;
            case 9: state.Status = "Alive-state comparison ready."; break;
            case 10: state.Status = "Pickaxe equality check ready."; break;
            case 11: state.Stone += 1; break;
            case 12: state.Status = state.HasPickaxe ? "Ready to mine." : "Find a pickaxe."; break;
            case 13: state.Status = state.Health >= 75 ? "Healthy" : state.Health > 0 ? "Hurt" : "Defeated"; break;
            case 14: state.Status = "Both mining requirements are checked."; break;
            case 15: state.Status = "Alternate light sources are supported."; break;
            case 16: state.Stone += 1; state.Status = "Mining permission rule passed."; break;
            case 17: state.Status = "Reusable method created."; break;
            case 18: state.Stone += 2; break;
            case 19: state.Status = "Methods can return game-rule results."; break;
            case 20: state.X = 2; break;
            case 21: state.Y = 2; break;
            case 22: state.X = 3; break;
            case 23: state.Status = "Map boundary protected."; break;
            case 24: state.X = 4; state.Y = 3; state.Status = "WASD movement ready."; break;
            case 25: state.Inventory = "Stone, Wood"; break;
            case 26: state.Rocks = 3; break;
            case 27: state.Rocks = 4; break;
            case 28: state.Rocks = 3; state.Stone += 1; break;
            case 29: state.Status = "Every rock can be visited."; break;
            case 30: state.Status = "Indexed world loop ready."; break;
            case 31: state.Rocks = 6; break;
            case 32: state.Rocks = 3; state.Stone += 3; state.Status = "Rock mining method active."; break;
            case 33: state.Status = "Player class blueprint created."; break;
            case 34: state.Status = "Player properties added."; break;
            case 35: state.Name = "Miner"; state.Health = 100; break;
            case 36: state.Name = "Miner"; state.Status = "Player object spawned."; break;
            case 37: state.Slimes = 1; state.SlimeHealth = 30; break;
            case 38: state.Slimes = 1; state.SlimeHealth = 20; break;
            case 39: state.Inventory = "Stone, Copper, Potion"; break;
            case 40:
                state.Slimes = 0; state.SlimeHealth = 0; state.Stone += 5;
                state.Status = "Slime defeated. Final reward collected.";
                break;
        }
    }

    private string PlayerStyle() =>
        $"left:{18 + Math.Clamp(Preview.X, 0, 9) * 30}px; top:{18 + Math.Clamp(Preview.Y, 0, 7) * 30}px;";

    private static string RockStyle(int index)
    {
        (int x, int y)[] positions =
        {
            (1, 1), (6, 1), (3, 4), (8, 5), (2, 7), (7, 3), (5, 6), (9, 2)
        };

        (int x, int y) = positions[index % positions.Length];
        return $"left:{18 + x * 30}px; top:{18 + y * 30}px;";
    }
