@page "/updates"
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Updates · CaveCode Academy</PageTitle>

<div class="updates-page">
    <div class="updates-home-slot">
        <AcademyHomeButton />
    </div>

    <header class="updates-hero">
        <div class="updates-logo-only">
            <img class="cavecode-context-logo-image"
                 src="branding/cavecode-academy-logo.svg?v=1"
                 alt=""
                 width="64"
                 height="44" />
        </div>

        <div class="updates-hero-row">
            <aside class="updates-stat updates-stat--left" aria-label="Community validated lines">
                <span class="updates-stat-label">Community lines</span>
                <strong class="updates-stat-value">@FormatCount(CommunityLines)</strong>
                <small>Validated lines from the leaderboard</small>
            </aside>

            <div class="updates-hero-center">
                <p class="eyebrow">SHIP LOG</p>
                <h1 tabindex="-1">Updates</h1>
                <p class="cavecode-page-intro"
                   data-cavecode-contrast-pass="page-header-contrast-v1">
                    Automatic list of recent improvements from successful deploys.
                    Each tile is a commit that landed on the live site.
                </p>
            </div>

            <aside class="updates-stat updates-stat--right" aria-label="CaveCode codebase size">
                <span class="updates-stat-label">CaveCode codebase</span>
                <strong class="updates-stat-value">@FormatCount(RepoLines)</strong>
                <small>Lines of code in this repo</small>
            </aside>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <section class="updates-message">@Error</section>
    }
    else if (!Ready)
    {
        <section class="updates-message">Loading updates…</section>
    }
    else if (Entries.Count == 0)
    {
        <section class="updates-message">No updates published yet.</section>
    }
    else
    {
        <p class="updates-meta">
            @if (!string.IsNullOrWhiteSpace(GeneratedAtLabel))
            {
                <span>Feed built @GeneratedAtLabel</span>
            }
            @if (!string.IsNullOrWhiteSpace(DeploySha))
            {
                <span> · deploy @DeploySha</span>
            }
            <span> · @Entries.Count updates</span>
        </p>

        <div class="updates-grid">
            @foreach (var item in Entries)
            {
                <article class="update-tile">
                    <div class="update-tile-top">
                        <time datetime="@item.At">@FormatWhen(item.At)</time>
                        <span class="update-badges">
                            @if (!string.IsNullOrWhiteSpace(item.Kind))
                            {
                                <span class="update-kind">@item.Kind</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Sha))
                            {
                                <span class="update-sha">@item.Sha</span>
                            }
                        </span>
                    </div>
                    <h2>@item.Title</h2>
                    @if (!string.IsNullOrWhiteSpace(item.Description))
                    {
                        <p class="update-desc">@item.Description</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.Url))
                    {
                        <a class="update-link"
                           href="@item.Url"
                           target="_blank"
                           rel="noopener noreferrer">
                            View commit →
                        </a>
                    }
                </article>
            }
        </div>
    }
</div>

<style>
    .updates-page {
        min-height: 100vh;
        padding: 28px 18px 70px;
        color: var(--text);
        background:
            radial-gradient(circle at 50% 0%, var(--accent-surface), transparent 42%),
            var(--bg);
        font-family: Inter, system-ui, sans-serif;
    }

    .updates-home-slot {
        width: min(1100px, 100%);
        margin: 0 auto 18px;
    }

    .updates-hero {
        width: min(1100px, 100%);
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .updates-logo-only {
        display: flex;
        justify-content: center;
        width: 100%;
        margin: 0 0 16px;
    }


    .updates-hero-row {
        display: grid;
        grid-template-columns: minmax(140px, 1fr) minmax(240px, 1.5fr) minmax(140px, 1fr);
        gap: 16px;
        align-items: start;
        width: 100%;
    }

    .updates-hero-center {
        text-align: center;
        min-width: 0;
    }

    .updates-hero-center .eyebrow {
        margin: 0 0 6px;
        color: var(--accent);
        font-size: 10px;
        font-weight: 900;
        letter-spacing: 1.1px;
        text-transform: uppercase;
    }

    .updates-hero-center h1 {
        margin: 0;
        font-size: clamp(36px, 6vw, 66px);
        letter-spacing: -2px;
        line-height: 1;
        color: var(--text);
    }

    .updates-hero-center .cavecode-page-intro {
        max-width: 34rem;
        margin: 12px auto 0;
        color: var(--text-muted);
        line-height: 1.55;
    }

    .updates-stat {
        padding: 16px 14px;
        border-radius: 16px;
        border: 1px solid var(--border);
        background: var(--surface);
        box-shadow: 0 12px 40px var(--shadow);
        text-align: center;
    }

    .updates-stat-label {
        display: block;
        margin-bottom: 6px;
        color: var(--text-muted);
        font-size: 10px;
        font-weight: 900;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .updates-stat-value {
        display: block;
        font-size: clamp(22px, 3vw, 32px);
        font-weight: 900;
        letter-spacing: -0.5px;
        color: var(--text);
        font-variant-numeric: tabular-nums;
    }

    .updates-stat small {
        display: block;
        margin-top: 6px;
        color: var(--text-muted);
        font-size: 11px;
        line-height: 1.35;
    }

    .updates-meta {
        width: min(960px, 100%);
        margin: 22px auto 0;
        color: var(--text-muted);
        font-size: 12px;
        text-align: center;
    }

    .updates-message {
        width: min(960px, 100%);
        margin: 28px auto 0;
        padding: 18px 20px;
        color: var(--text-muted);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        text-align: center;
    }

    .updates-grid {
        width: min(960px, 100%);
        margin: 18px auto 0;
        display: grid;
        gap: 12px;
    }

    .update-tile {
        padding: 16px 18px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        box-shadow: 0 12px 40px var(--shadow);
        text-align: left;
    }

    .update-tile-top {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 8px;
    }

    .update-tile time {
        color: var(--text-muted);
        font-size: 12px;
        font-weight: 700;
    }

    .update-badges {
        display: inline-flex;
        gap: 6px;
        align-items: center;
    }

    .update-kind {
        padding: 3px 8px;
        color: var(--text);
        background: var(--surface-strong);
        border: 1px solid var(--border);
        border-radius: 999px;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .update-sha {
        padding: 3px 8px;
        color: var(--accent-contrast);
        background: var(--accent);
        border-radius: 999px;
        font-size: 11px;
        font-weight: 800;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    }

    .update-tile h2 {
        margin: 0;
        font-size: 16px;
        line-height: 1.35;
        font-weight: 800;
        color: var(--text);
    }

    .update-desc {
        margin: 8px 0 0;
        color: var(--text-muted);
        font-size: 13px;
        line-height: 1.45;
    }

    .update-link {
        display: inline-block;
        margin-top: 10px;
        color: var(--accent);
        font-size: 12px;
        font-weight: 800;
        text-decoration: none;
    }

    .update-link:hover {
        text-decoration: underline;
    }

    @@media (max-width: 820px) {
        .updates-hero-row {
            grid-template-columns: 1fr;
        }

        .updates-stat--left { order: 2; }
        .updates-hero-center { order: 1; }
        .updates-stat--right { order: 3; }
    }
</style>

@code {
    private bool Ready;
    private string? Error;
    private string? GeneratedAtLabel;
    private string? DeploySha;
    private long CommunityLines;
    private long RepoLines;
    private List<UpdateEntry> Entries = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var url = Nav.ToAbsoluteUri($"updates.json?v={DateTime.UtcNow.Ticks}").ToString();
            using var request = new HttpRequestMessage(HttpMethod.Get, url);
            request.Headers.CacheControl = new System.Net.Http.Headers.CacheControlHeaderValue
            {
                NoCache = true,
                NoStore = true
            };
            using var response = await Http.SendAsync(request);
            response.EnsureSuccessStatusCode();
            var feed = await response.Content.ReadFromJsonAsync<UpdatesFeed>(
                new System.Text.Json.JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });

            if (feed is null)
            {
                Error = "Updates feed was empty.";
                Ready = true;
                return;
            }

            GeneratedAtLabel = FormatWhen(feed.GeneratedAt);
            DeploySha = feed.DeploySha;
            RepoLines = feed.Repo?.CodeLines ?? 0;
            Entries = (feed.Updates ?? new List<UpdateEntry>())
                .Where(u => !string.IsNullOrWhiteSpace(u.Title))
                .ToList();
            Ready = true;
        }
        catch (Exception ex)
        {
            Error = "Could not load updates yet. After the next successful deploy, this page fills in automatically.";
            Console.WriteLine(ex);
            Ready = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await JS.InvokeAsync<object>("caveCodeProgression.ready");
            var board = await JS.InvokeAsync<LeaderboardPayload>(
                "caveCodeProgression.getLeaderboard",
                "overall",
                (object?)null);

            long sum = 0;
            if (board?.Entries != null)
            {
                foreach (var e in board.Entries)
                {
                    sum += Math.Max(0, e.TotalLines);
                }
            }

            CommunityLines = sum;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }
    }

    private static string FormatWhen(string? iso)
    {
        if (string.IsNullOrWhiteSpace(iso))
        {
            return "";
        }

        if (DateTimeOffset.TryParse(iso, out var dto))
        {
            return dto.ToLocalTime().ToString("MMM d, yyyy · h:mm tt");
        }

        return iso;
    }

    private static string FormatCount(long value)
    {
        if (value <= 0)
        {
            return "—";
        }

        return value.ToString("N0");
    }

    private sealed class UpdatesFeed
    {
        public string? GeneratedAt { get; set; }
        public string? DeploySha { get; set; }
        public RepoStats? Repo { get; set; }
        public List<UpdateEntry>? Updates { get; set; }
    }

    private sealed class RepoStats
    {
        public long CodeLines { get; set; }
        public long FileCount { get; set; }
    }

    private sealed class UpdateEntry
    {
        public string? Id { get; set; }
        public string? Sha { get; set; }
        public string? Title { get; set; }
        public string? Description { get; set; }
        public string? Kind { get; set; }
        public string? At { get; set; }
        public string? Url { get; set; }
    }

    private sealed class LeaderboardPayload
    {
        public List<LeaderboardEntryDto>? Entries { get; set; }
    }

    private sealed class LeaderboardEntryDto
    {
        public long TotalLines { get; set; }
    }
}
