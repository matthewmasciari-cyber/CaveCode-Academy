@page "/"

<PageTitle>CaveCode Academy</PageTitle>

<div class="academy-home">
    <header class="home-header">
        <NavLink class="home-brand" href="/" Match="NavLinkMatch.All">
            <span class="home-brand-mark">&lt;/&gt;</span>
            <span>
                <strong>CaveCode Academy</strong>
                <small>Learn by building worlds.</small>
            </span>
        </NavLink>

        <div class="home-header-actions">
            <nav aria-label="Academy navigation">
                <NavLink href="/settings">Appearance</NavLink>
                <AchievementNavLink />
                <LeaderboardNavLink />
                <MinigameNavLink />
                <a href="#paths">Learning paths</a>
            </nav>
            <AuthPanel Compact="true" />
        </div>
    </header>

    <main>
        <section class="hero">
            <div class="hero-copy">
                <p class="eyebrow">CHOOSE YOUR PATH</p>
                <h1>One academy. Multiple ways to learn code.</h1>
                <p class="hero-description">
                    Build practical projects, practice each concept in stages, and watch your skills grow into complete applications.
                </p>
                <div class="hero-actions">
                    <NavLink class="primary-action" href="/csharp">Continue C# Cave Adventure →</NavLink>
                    <NavLink class="secondary-action" href="/settings">Customize appearance</NavLink>
                </div>
            </div>

            <div class="hero-terminal" aria-label="Academy terminal preview">
                <div class="terminal-bar"><span>CAVECODE TERMINAL</span><span>READY</span></div>
                <p><span>&gt;</span> academy.select_path()</p>
                <p class="terminal-success">C# Cave Adventure and Python Automation Quest are available.</p>
                <p><span>&gt;</span> progress.unlock_projects()</p>
                <p class="terminal-muted">Advanced paths unlock through mastery.</p>
            </div>
        </section>

        <section class="path-section" id="paths">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">LEARNING PATHS</p>
                    <h2>Choose what you want to build</h2>
                </div>
                <span class="path-count">2 available · 3 in development</span>
            </div>

            <div class="path-grid">
                <article class="path-card available csharp-card">
                    <div class="path-topline">
                        <span class="language-mark">C#</span>
                        <span class="status available-status">Available now</span>
                    </div>
                    <h3>C# Cave Adventure</h3>
                    <p>Build a growing cave-exploration game while mastering C# foundations, logic, collections, classes, and combat.</p>
                    <CourseResume Course="csharp" />
                    <div class="skill-tags"><span>40 modules</span><span>8-stage practice</span><span>Live game preview</span></div>
                    <NavLink class="path-action" href="/csharp">Enter the cave →</NavLink>
                </article>
                <article class="path-card available python-card">
                    <div class="path-topline">
                        <span class="language-mark">Py</span>
                        <span class="status available-status">Available now</span>
                    </div>
                    <h3>Python Automation Quest</h3>
                    <p>Restore an underground facility while learning Python through sensors, alarms, sequences, data, files, and Raspberry Pi concepts.</p>
                    <CourseResume Course="python" />
                    <div class="skill-tags"><span>40 modules</span><span>Automation simulation</span><span>Optional hardware path</span></div>
                    <NavLink class="path-action" href="/python">Enter the control room →</NavLink>
                </article>

                @foreach (LearningPath path in ComingSoonPaths)
                {
                    <article class="path-card locked">
                        <div class="path-topline">
                            <span class="language-mark">@path.Mark</span>
                            <span class="status locked-status"><LockMark Compact="true" /> Coming soon</span>
                        </div>
                        <h3>@path.Title</h3>
                        <p>@path.Description</p>
                        <div class="skill-tags">
                            @foreach (string tag in path.Tags)
                            {
                                <span>@tag</span>
                            }
                        </div>
                        <button class="path-action locked-action" type="button" disabled>Course in development</button>
                    </article>
                }
            </div>
        </section>

        <section class="minigame-section" id="minigames">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">MINIGAMES</p>
                    <h2>Use everything you have learned</h2>
                </div>

                <NavLink class="minigame-hub-link"
                         href="/minigames">
                    View minigame hub →
                </NavLink>
            </div>

            <div class="minigame-card-grid">
                <article class="minigame-home-card csharp-minigame-card">
                    <span>C# CAVE ADVENTURE</span>
                    <h3>Cave Defense</h3>
                    <p>
                        Open gates, manage supplies, control movement,
                        and defeat the slime commander with C#.
                    </p>

                    <div>
                        <small>5 chapter events</small>
                        <small>XP and Code Crystals</small>
                        <small>Endless mode</small>
                    </div>

                    <NavLink href="/minigames/csharp">
                        Play Cave Defense →
                    </NavLink>
                </article>

                <article class="minigame-home-card python-minigame-card">
                    <span>PYTHON AUTOMATION QUEST</span>
                    <h3>Control Room</h3>
                    <p>
                        Restore sensors, safety logic, sequences,
                        monitoring, and emergency controls with Python.
                    </p>

                    <div>
                        <small>5 facility events</small>
                        <small>Validated lines</small>
                        <small>Endless mode</small>
                    </div>

                    <NavLink href="/minigames/python">
                        Enter the Control Room →
                    </NavLink>
                </article>
            </div>
        </section>

        <section class="unlock-section">
            <div>
                <p class="eyebrow">PROGRESSION THAT MATTERS</p>
                <h2>Languages stay open. Advanced projects are earned.</h2>
                <p>Core languages will be selectable by interest. Combined projects and specialist labs will unlock when their prerequisite skills are complete.</p>
            </div>
            <div class="unlock-grid">
                <div><span>C# + SQL</span><strong>Persistent Game World</strong></div>
                <div><span>HTML/CSS + JavaScript</span><strong>Browser Game Studio</strong></div>
                <div><span>Python + SQL</span><strong>Automation & Data Lab</strong></div>
            </div>
        </section>
    </main>

    <footer>
        <span>CaveCode Academy</span>
        <NavLink href="/settings">Viewing preferences</NavLink>
    </footer>
</div>

<style>
    .academy-home { min-height: 100vh; color: var(--text); background: radial-gradient(circle at 75% 0%, var(--accent-surface), transparent 32%), var(--bg); font-family: Inter, system-ui, sans-serif; }
    .home-header { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 18px clamp(20px, 5vw, 72px); border-bottom: 1px solid var(--border); background: color-mix(in srgb, var(--surface) 88%, transparent); backdrop-filter: blur(12px); }
    .home-brand { display: flex; align-items: center; gap: 12px; color: var(--text); text-decoration: none; }
    .home-brand-mark { display: grid; width: 44px; height: 44px; place-items: center; color: var(--accent-contrast); background: var(--accent); border-radius: 12px; font-weight: 950; }
    .home-brand strong, .home-brand small { display: block; }
    .home-brand small { margin-top: 2px; color: var(--text-muted); font-size: 11px; }
    .home-header-actions { display: flex; align-items: center; gap: 12px; }
    .home-header nav { display: flex; gap: 8px; }
    .home-header nav a { padding: 9px 12px; color: var(--text-muted); text-decoration: none; border-radius: 8px; font-size: 12px; font-weight: 800; }
    .home-header nav a:hover, .home-header nav a.active { color: var(--text); background: var(--surface-raised); }
    .academy-home main { width: min(1180px, calc(100% - 36px)); margin: 0 auto; }
    .hero { display: grid; grid-template-columns: 1.15fr .85fr; gap: clamp(32px, 6vw, 90px); align-items: center; min-height: 560px; padding: 76px 0 66px; }
    .eyebrow { margin: 0 0 10px; color: var(--accent); font-size: 11px; font-weight: 900; letter-spacing: 1.4px; }
    .hero h1 { max-width: 780px; margin: 0; font-size: clamp(42px, 6vw, 76px); line-height: .98; letter-spacing: -3px; }
    .hero-description { max-width: 660px; margin: 24px 0 0; color: var(--text-muted); font-size: 17px; line-height: 1.7; }
    .hero-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
    .primary-action, .secondary-action { padding: 13px 17px; border-radius: 10px; text-decoration: none; font-weight: 850; }
    .primary-action { color: var(--accent-contrast); background: var(--accent); }
    .primary-action:hover { background: var(--accent-hover); }
    .secondary-action { color: var(--text); background: var(--surface-raised); border: 1px solid var(--border); }
    .hero-terminal { overflow: hidden; min-height: 270px; padding: 22px; color: var(--accent-soft); background: var(--code-bg); border: 1px solid var(--border-strong); border-radius: 16px; box-shadow: 0 24px 80px var(--shadow); font: 13px/1.7 Consolas, Monaco, monospace; }
    .terminal-bar { display: flex; justify-content: space-between; margin: -22px -22px 22px; padding: 11px 14px; color: var(--text-muted); background: var(--surface); border-bottom: 1px solid var(--border); font-size: 10px; font-weight: 850; }
    .hero-terminal span { color: var(--accent); }
    .terminal-success { color: var(--accent-soft); }
    .terminal-muted { color: var(--text-muted); }
    .path-section { padding: 66px 0 80px; border-top: 1px solid var(--border); }
    .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 26px; }
    .section-heading h2, .unlock-section h2 { margin: 0; font-size: clamp(28px, 4vw, 42px); }
    .path-count { color: var(--text-muted); font-size: 12px; }
    .path-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    .path-card { position: relative; display: flex; min-height: 330px; flex-direction: column; padding: 24px; overflow: hidden; background: var(--surface); border: 1px solid var(--border); border-radius: 16px; }
    .path-card.available { background: linear-gradient(145deg, var(--accent-surface), var(--surface) 62%); border-color: var(--accent-border); }
    .path-card.locked::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(120deg, transparent 30%, color-mix(in srgb, var(--text) 3%, transparent)); }
    .path-topline { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .language-mark { display: grid; min-width: 48px; height: 48px; padding: 0 10px; place-items: center; color: var(--accent-contrast); background: var(--accent); border-radius: 12px; font-weight: 950; }
    .locked .language-mark { color: var(--text); background: var(--surface-strong); }
    .status { padding: 6px 9px; border-radius: 99px; font-size: 10px; font-weight: 850; }
    .available-status { color: var(--accent-soft); background: var(--accent-surface); border: 1px solid var(--accent-border); }
    .locked-status { color: var(--text-muted); background: var(--surface-raised); border: 1px solid var(--border); }
    .path-card h3 { margin: 24px 0 10px; font-size: 24px; }
    .path-card p { margin: 0; color: var(--text-muted); line-height: 1.65; }
    .skill-tags { display: flex; flex-wrap: wrap; gap: 7px; margin: 20px 0; }
    .skill-tags span { padding: 6px 8px; color: var(--text-muted); background: var(--surface-soft); border: 1px solid var(--border); border-radius: 6px; font-size: 10px; }
    .path-action { width: 100%; padding: 12px 14px; margin-top: auto; color: var(--accent-contrast); text-align: center; text-decoration: none; background: var(--accent); border: 0; border-radius: 9px; font-weight: 850; }
    .locked-action { color: var(--text-dim); background: var(--surface-strong); border: 1px solid var(--border); cursor: not-allowed; }
    .unlock-section { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; padding: 72px 0; border-top: 1px solid var(--border); }
    .unlock-section > div:first-child > p:last-child { color: var(--text-muted); line-height: 1.7; }
    .unlock-grid { display: grid; gap: 10px; }
    .unlock-grid div { padding: 17px; background: var(--surface); border: 1px solid var(--border); border-radius: 11px; }
    .unlock-grid span, .unlock-grid strong { display: block; }
    .unlock-grid span { color: var(--accent); font-size: 10px; font-weight: 850; text-transform: uppercase; letter-spacing: .7px; }
    .unlock-grid strong { margin-top: 5px; }
    footer { display: flex; justify-content: space-between; gap: 20px; padding: 24px clamp(20px, 5vw, 72px); color: var(--text-muted); background: var(--surface); border-top: 1px solid var(--border); font-size: 11px; }
    footer a { color: var(--text-muted); }
    @@media (max-width: 820px) { .hero, .unlock-section { grid-template-columns: 1fr; } .hero { padding-top: 54px; } .path-grid { grid-template-columns: 1fr; } .home-header nav a:last-child { display: none; } }
    @@media (max-width: 720px) { .home-header { align-items: flex-start; } .home-header-actions { align-items: flex-end; flex-direction: column; } }
    @@media (max-width: 520px) { .home-header { align-items: flex-start; } .home-header nav { display: block; } .hero h1 { letter-spacing: -1.5px; } .section-heading { display: block; } .path-count { display: block; margin-top: 10px; } }

    /* Homepage dark-surface contrast */
    .hero-terminal {
        color: var(--dark-panel-text);
    }

    .hero-terminal .terminal-muted,
    .hero-terminal .terminal-bar {
        color: var(--dark-panel-muted);
    }

    .hero-terminal .terminal-bar {
        background: var(--code-bg);
        border-color: var(--border-strong);
    }


    .locked-status { display: inline-flex; align-items: center; gap: 6px; }
    .locked-status .lock-mark { color: var(--text-muted); }

    .minigame-section {
        padding: 72px 0;
        border-top: 1px solid var(--border);
    }

    .minigame-hub-link {
        color: var(--accent);
        text-decoration: none;
        font-size: 11px;
        font-weight: 900;
    }

    .minigame-card-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .minigame-home-card {
        display: flex;
        min-height: 310px;
        flex-direction: column;
        padding: 23px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 15px;
        box-shadow: 0 18px 60px var(--shadow);
    }

    .csharp-minigame-card {
        background:
            radial-gradient(
                circle at 90% 0%,
                rgba(255, 145, 74, .15),
                transparent 35%
            ),
            var(--surface);
    }

    .python-minigame-card {
        background:
            radial-gradient(
                circle at 90% 0%,
                rgba(85, 216, 255, .15),
                transparent 35%
            ),
            var(--surface);
    }

    .minigame-home-card > span {
        color: var(--accent);
        font-size: 9px;
        font-weight: 950;
        letter-spacing: .9px;
    }

    .minigame-home-card h3 {
        margin: 11px 0 8px;
        font-size: 26px;
    }

    .minigame-home-card p {
        color: var(--text-muted);
        line-height: 1.65;
    }

    .minigame-home-card > div {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin: 15px 0;
    }

    .minigame-home-card small {
        padding: 6px 8px;
        color: var(--text-muted);
        background: var(--surface-soft);
        border: 1px solid var(--border);
        border-radius: 6px;
        font-size: 9px;
    }

    .minigame-home-card > a {
        width: 100%;
        padding: 12px;
        margin-top: auto;
        color: var(--accent-contrast);
        text-align: center;
        text-decoration: none;
        background: var(--accent);
        border-radius: 9px;
        font-weight: 900;
    }

    @@media (max-width: 760px) {
        .minigame-card-grid {
            grid-template-columns: 1fr;
        }
    }

</style>

@code {
    private sealed record LearningPath(string Mark, string Title, string Description, string[] Tags);

    private static readonly LearningPath[] ComingSoonPaths =
    {
        new("JS", "JavaScript Web Forge", "Create interactive websites and browser games while learning the language of the modern web.", new[] { "Web apps", "Browser games", "Interfaces" }),
        new("SQL", "SQL Database Dungeon", "Master queries by managing players, items, quests, and persistent world data.", new[] { "Queries", "Databases", "Game data" }),
        new("HTML", "HTML & CSS Workshop", "Build the structure and visual systems behind polished websites and game interfaces.", new[] { "Layouts", "Responsive design", "UI styling" })
    };
}
