            args.Value is bool value
                ? value
                : bool.TryParse(
                    args.Value?.ToString(),
                    out bool parsed
                ) && parsed;

        UpdateAppearance(
            await ThemeService.SetReducedMotionAsync(enabled)
        );
    }

