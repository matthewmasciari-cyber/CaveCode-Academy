    private IEnumerable<(string Label, List<TitleUnlockOption> Options)> TitleLanguageGroups
    {
        get
        {
            var groups = new (string Key, string Label, string[] Match)[]
            {
                ("starter", "Starter", new[] { "Cave Explorer", "Academy Pathfinder" }),
                ("csharp", "C#", new[] { "Code Apprentice", "Logic Pathfinder", "Systems Builder", "C# Adventurer", "CaveCode Champion" }),
                ("python", "Python", new[] { "Control Room", "Automation", "Python" }),
                ("cpp", "C++", new[] { "Engine", "Memory Steward", "C++" }),
                ("htmlcss", "HTML & CSS", new[] { "Markup", "Interface" }),
                ("gcl", "GCL+", new[] { "Control Cadet", "Sequence", "Interlock", "Timing Specialist", "Line Boss" }),
                ("arduino", "Arduino", new[] { "Pin Rookie", "Sketch Smith", "Sensor Apprentice", "Shield Builder", "Board Captain" }),
                ("raspi", "Raspberry Pi", new[] { "GPIO", "Pi Tinkerer", "Sense Hacker", "Automation Hand", "Lab Lead" }),
                ("javascript", "JavaScript", new[] { "Console Cadet", "DOM Jockey", "Event Wrangler", "Module Pilot", "Web Forge" }),
                ("other", "Other", Array.Empty<string>())
            };
            var used = new HashSet<string>();
            foreach (var g in groups)
            {
                List<TitleUnlockOption> opts;
                if (g.Key == "other")
                    opts = TitleOptions.Where(o => !used.Contains(o.Title)).ToList();
                else if (g.Key == "starter")
                    opts = TitleOptions.Where(o => g.Match.Any(m => o.Title.Equals(m, StringComparison.OrdinalIgnoreCase))).ToList();
                else
                    opts = TitleOptions.Where(o => g.Match.Any(m => o.Title.Contains(m, StringComparison.OrdinalIgnoreCase))).ToList();
                foreach (var o in opts) used.Add(o.Title);
                if (opts.Count > 0)
                    yield return (g.Label, opts);
            }
        }
    }

    private async Task LoadCrystalShopAsync()
    {
        try
        {
            var catalog = await JS.InvokeAsync<CrystalShopCatalog>("caveCodeCrystalShop.getCatalog");
            CrystalBalance = catalog?.Balance ?? 0;
            OwnedEmblems = catalog?.Items?
                .Where(i => i.Owned)
                .Select(i => i.Id)
                .ToList()
                ?? new List<string> { "crystal", "cave", "terminal", "code" };
        }
        catch
        {
            CrystalBalance = 0;
        }

        try
        {
            await JS.InvokeVoidAsync("eval", "window.lucide && window.lucide.createIcons && window.lucide.createIcons()");
        }
        catch { }
    }

    private async Task OnEmblemClick(EmblemChoice emblem)
    {
        if (OwnedEmblems.Contains(emblem.Id))
        {
            await SelectEmblem(emblem.Id);
            return;
        }

        if (emblem.Cost > 0)
        {
            PendingEmblemPurchase = emblem;
            ShopToast = "";
            return;
        }

        await ConfirmBuyEmblem(emblem);
    }

    private void CancelBuyEmblem()
    {
        PendingEmblemPurchase = null;
    }

    private async Task ConfirmBuyEmblem(EmblemChoice emblem)
    {
        try
        {
            var result = await JS.InvokeAsync<CrystalBuyResult>("caveCodeCrystalShop.buy", emblem.Id);
            if (result is null || !result.Success)
            {
                ProfileSaveMessage = result?.Message ?? "Not enough Code Crystals.";
                await LoadCrystalShopAsync();
                return;
            }

            CrystalBalance = result.Balance;
            if (result.Owned is { Count: > 0 })
            {
                OwnedEmblems = result.Owned;
            }
            else if (!OwnedEmblems.Contains(emblem.Id))
            {
                OwnedEmblems.Add(emblem.Id);
            }

            ProfileSaveMessage = emblem.Cost > 0
                ? $"Unlocked {emblem.Name} for {emblem.Cost} crystals."
                : $"Unlocked {emblem.Name}.";
            await SelectEmblem(emblem.Id);
            await LoadCrystalShopAsync();
            ShopToast = ProfileSaveMessage;
            PendingEmblemPurchase = null;
        }
        catch
        {
            ProfileSaveMessage = "Could not complete purchase.";
            PendingEmblemPurchase = null;
        }
    }

