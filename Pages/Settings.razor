    private async Task SelectTitle(TitleUnlockOption option)
    {
        if (!option.Unlocked)
        {
            ProfileSaveMessage = "Claim the matching chapter reward first.";
            return;
        }

        Profile = await ProfileService.SetTitleAsync(option.Title);
        ProfileSaveMessage = "Title equipped.";
    }

    private static string TitleRequirement(TitleUnlockOption option)
    {
        if (option.Unlocked)
        {
            return option.Title == "Cave Explorer"
                ? "Available from the beginning"
                : "Claimed chapter reward";
        }

        string requirement = option.Requirement;
        string chapter = "";
        int index = requirement.LastIndexOf("Chapter ", StringComparison.OrdinalIgnoreCase);
        if (index >= 0) chapter = requirement[(index + 8)..].Trim();

        if (requirement.Contains("C# Cave Adventure", StringComparison.OrdinalIgnoreCase))
            return string.IsNullOrWhiteSpace(chapter) ? "Claim the matching C# chapter reward" : $"Claim C# Chapter {chapter} reward";

        if (requirement.Contains("Python Automation Quest", StringComparison.OrdinalIgnoreCase))
            return string.IsNullOrWhiteSpace(chapter) ? "Claim the matching Python chapter reward" : $"Claim Python Chapter {chapter} reward";

        return "Claim the matching chapter reward";
    }

    private async Task SelectEmblem(string emblem)
    {
        if (!OwnedEmblems.Contains(emblem)) { ProfileSaveMessage = "Unlock this emblem in the shop first."; return; }
        Profile = await ProfileService.SetEmblemAsync(emblem);
        ProfileSaveMessage = "Emblem saved.";
    }

