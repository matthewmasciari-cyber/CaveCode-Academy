    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        Preferences =
            await ThemeService.GetPreferencesAsync();

        Profile =
            await ProfileService.GetPreferencesAsync();

        TitleOptions =
            await AchievementService.GetTitleOptionsAsync();

        await LoadCrystalShopAsync();

        Ready = true;
        try { await JS.InvokeVoidAsync("eval", "window.lucide && window.lucide.createIcons && window.lucide.createIcons()"); } catch { }

        await InvokeAsync(StateHasChanged);
    }

