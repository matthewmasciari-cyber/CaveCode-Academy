@page "/settings"
@using CaveCode.Components
@using System.Linq
@inject ThemeService ThemeService
@inject IJSRuntime JS
@inject ProfileService ProfileService
@inject AchievementService AchievementService

<PageTitle>User Settings · CaveCode Academy</PageTitle>

<div class="settings-page">
    <header class="settings-header">
        <AcademyHomeButton />

        <div>
            <!-- CAVECODE_OFFICIAL_BRANDING_PASS_2_V1 -->
            <div class="cavecode-page-brandline"
                 aria-label="CaveCode Academy branding">
                <span class="cavecode-context-logo-surface cavecode-context-logo-surface--page">
                    <img class="cavecode-context-logo-image"
                         src="branding/cavecode-academy-logo.svg?v=1"
                         alt="" />
                </span>
                <span>CaveCode Academy</span>
            </div>
            <p class="eyebrow">USER SETTINGS</p>
            <h1>Appearance, accessibility, and profile</h1>
            <p>
                Choose a comfortable viewing style and personalize how your
                CaveCode account appears. Changes save in this browser.
            </p>
        </div>
    </header>

    @if (!Ready)
    {
        <div class="loading-card">Loading user settings…</div>
    }
    else
    {
        <main class="settings-layout">
            <section class="settings-panel profile-panel">
                <div class="setting-heading">
                    <div>
                        <span>01</span>
                        <h2>Profile customization</h2>
                    </div>

                    <p>
                        Choose the name, earned title, and emblem shown
                        throughout CaveCode.
                    </p>
                </div>

                <div class="profile-grid">
                    <div class="profile-editor">
                        <DisplayNameRenameControl />

                        <div class="field-label">
                            <span>Title</span>
                            <div class="title-language-sections">
                                @foreach (var group in TitleLanguageGroups)
                                {
                                    <div class="title-lang-block">
                                        <div class="title-lang-label">@group.Label</div>
                                        <div class="title-choice-grid">
                                            @foreach (TitleUnlockOption option in group.Options)
                                            {
                                                <button type="button"
                                                        class="title-choice @(Profile.Title == option.Title ? "selected" : "") @(!option.Unlocked ? "locked" : "")"
                                                        disabled="@(!option.Unlocked)"
                                                        @onclick="() => SelectTitle(option)">
                                                    <span class="title-choice-top">
                                                        <TitleEffect Title="@option.Title" />
                                                    </span>
                                                    <small>@option.Requirement</small>
                                                    <span class="title-state">@(option.Unlocked ? (Profile.Title == option.Title ? "Equipped" : "Unlocked") : "Locked")</span>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="field-label">
                            <span>Emblem</span>
                            <div class="emblem-shop settings-shop-panel">
                                <div class="emblem-shop-header">
                                    <h3>Emblem shop</h3>
                                    <span class="crystal-balance">@CrystalBalance Code Crystals</span>
                                </div>
                                <p class="emblem-shop-note">Earn crystals by completing modules (+3, or +8 at chapter end) and claiming chapter achievements. Common emblems are free.</p>
                                @if (PendingEmblemPurchase is not null)
                                {
                                    <div class="shop-confirm" role="dialog" aria-label="Confirm emblem purchase">
                                        <p>
                                            Unlock <strong>@PendingEmblemPurchase.Name</strong> for
                                            <strong>@PendingEmblemPurchase.Cost</strong> Code Crystals?
                                            (Balance: @CrystalBalance)
                                        </p>
                                        <div class="shop-confirm-actions">
                                            <button type="button" class="confirm-buy" @onclick="() => ConfirmBuyEmblem(PendingEmblemPurchase!)">Confirm purchase</button>
                                            <button type="button" class="confirm-cancel" @onclick="CancelBuyEmblem">Cancel</button>
                                        </div>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(ShopToast))
                                {
                                    <div class="shop-toast">@ShopToast</div>
                                }

                                @foreach (var rarity in EmblemRarityOrder)
                                {
                                    <div class="emblem-rarity-block">
                                        <div class="emblem-rarity-label">@rarity</div>
                                        <div class="emblem-grid">
                                            @foreach (EmblemChoice emblem in Emblems.Where(e => e.Rarity == rarity))
                                            {
                                                var owned = OwnedEmblems.Contains(emblem.Id);
                                                <button type="button"
                                                        class="emblem-choice @(Profile.Emblem == emblem.Id ? "selected" : "") @(!owned ? "locked" : "owned")"
                                                        aria-pressed="@(Profile.Emblem == emblem.Id)"
                                                        @onclick="() => OnEmblemClick(emblem)">
                                                    <strong class="emblem-glyph"><i data-lucide="@emblem.Symbol"></i></strong>
                                                    <small>@emblem.Name</small>
                                                    <span class="price">@(owned ? "Owned" : (emblem.Cost == 0 ? "Free" : emblem.Cost + " crystals"))</span>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <aside class="profile-preview"
                           aria-label="Profile preview">
                        <p>PROFILE PREVIEW</p>

                        <div class="preview-identity">
                            <span class="preview-emblem">
                                <i data-lucide="@SelectedEmblem.Symbol"></i>
                            </span>

                            <div>
                                <strong>@PreviewDisplayName</strong>
                                <TitleEffect Title="@Profile.Title" />
                            </div>
                        </div>

                    </aside>
                </div>

                <div class="panel-footer">
                    <span>@ProfileSaveMessage</span>

                    <button type="button"
                            @onclick="ResetProfile">
                        Reset profile
                    </button>
                </div>
            </section>

            <section class="settings-panel">
                <div class="setting-heading">
                    <div>
                        <span>02</span>
                        <h2>Color theme</h2>
                    </div>

                    <p>
                        Changes accent colors and the overall visual identity.
                    </p>
                </div>

                <div class="theme-grid">
                    @foreach (ThemeChoice theme in Themes)
                    {
                        <button type="button"
                                class="theme-choice @(Preferences.Theme == theme.Id ? "selected" : "")"
                                style="--preview-bg:@theme.Background; --preview-surface:@theme.Surface; --preview-accent:@theme.Accent"
                                aria-pressed="@(Preferences.Theme == theme.Id)"
                                @onclick="() => SelectTheme(theme.Id)">
                            <span class="theme-preview">
                                <i></i>
                                <i></i>
                                <i></i>
                            </span>

                            <strong>@theme.Name</strong>
                            <small>@theme.Description</small>
                        </button>
                    }
                </div>
            </section>

            <section class="settings-panel">
                <div class="setting-heading">
                    <div>
                        <span>03</span>
                        <h2>Appearance mode</h2>
                    </div>

                    <p>
                        Use a dark interface, a light interface, or match the
                        device.
                    </p>
                </div>

                <div class="segmented-control">
                    @foreach (ModeChoice mode in Modes)
                    {
                        <button type="button"
                                class="@(Preferences.Mode == mode.Id ? "selected" : "")"
                                aria-pressed="@(Preferences.Mode == mode.Id)"
                                @onclick="() => SelectMode(mode.Id)">
                            <span>@mode.Icon</span>
                            @mode.Name
                        </button>
                    }
                </div>
            </section>

            <section class="settings-panel">
                <div class="setting-heading">
                    <div>
                        <span>04</span>
                        <h2>Text size</h2>
                    </div>

                    <p>
                        Increase interface text without changing browser zoom.
                    </p>
                </div>

                <div class="segmented-control text-sizes">
                    @foreach (TextSizeChoice size in TextSizes)
                    {
                        <button type="button"
                                class="@(Preferences.TextSize == size.Id ? "selected" : "")"
                                aria-pressed="@(Preferences.TextSize == size.Id)"
                                @onclick="() => SelectTextSize(size.Id)">
                            <span style="font-size:@size.PreviewSize">
                                Aa
                            </span>

                            @size.Name
                        </button>
                    }
                </div>
            </section>

            <section class="settings-panel compact-panel">
                <div class="setting-heading">
                    <div>
                        <span>05</span>
                        <h2>Motion</h2>
                    </div>

                    <p>
                        Reduce transitions, pulsing indicators, and interface
                        animation.
                    </p>
                </div>

                <label class="toggle-row">
                    <span>
                        <strong>Reduce animations</strong>
                        <small>
                            Recommended for motion sensitivity or
                            lower-powered devices.
                        </small>
                    </span>

                    <input type="checkbox"
                           checked="@Preferences.ReducedMotion"
                           @onchange="ToggleReducedMotion" />

                    <i aria-hidden="true"></i>
                </label>
            </section>

            <div class="settings-footer">
                <span>@AppearanceSaveMessage</span>

                <button type="button"
                        @onclick="ResetAppearance">
                    Reset appearance settings
                </button>
            </div>
        </main>
    }
</div>

<style>
    /* CAVECODE_SETTINGS_VISUAL_REFACTOR_83B */
    .settings-page {
        min-height: 100vh;
        padding: 40px 18px 70px;
        color: var(--text);
        background:
            radial-gradient(
                circle at 15% 0%,
                var(--accent-surface),
                transparent 30%
            ),
            var(--bg);
        font-family: Inter, system-ui, sans-serif;
    }

    .settings-header,
    .settings-layout {
        width: min(980px, 100%);
        margin: 0 auto;
    }

    .settings-header > a {
        display: inline-block;
        margin-bottom: 28px;
        color: var(--text-muted);
        text-decoration: none;
        font-size: 12px;
        font-weight: 800;
    }

    .settings-header > a:hover {
        color: var(--accent);
    }

    .settings-header h1 {
        margin: 0;
        font-size: clamp(34px, 5vw, 54px);
        letter-spacing: -1.5px;
    }

    .settings-header > div > p:last-child {
        max-width: 680px;
        margin: 13px 0 0;
        color: var(--text-muted);
        line-height: 1.6;
    }

    .eyebrow {
        margin: 0 0 7px;
        color: var(--accent);
        font-size: 10px;
        font-weight: 900;
        letter-spacing: 1.2px;
    }

    .settings-layout {
        display: grid;
        gap: 16px;
        margin-top: 36px;
    }

    .settings-panel,
    .loading-card {
        padding: 24px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 15px;
        box-shadow: 0 16px 60px var(--shadow);
    }

    .loading-card {
        width: min(980px, 100%);
        margin: 36px auto 0;
        color: var(--text-muted);
    }

    .setting-heading {
        display: flex;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 20px;
    }

    .setting-heading > div {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .setting-heading > div > span {
        display: grid;
        width: 28px;
        height: 28px;
        place-items: center;
        color: var(--accent-contrast);
        background: var(--accent);
        border-radius: 8px;
        font-size: 10px;
        font-weight: 900;
    }

    .setting-heading h2 {
        margin: 0;
        font-size: 20px;
    }

    .setting-heading > p {
        max-width: 430px;
        margin: 3px 0 0;
        color: var(--text-muted);
        font-size: 12px;
        line-height: 1.5;
        text-align: right;
    }

    .profile-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.65fr) minmax(280px, .75fr);
        gap: 22px;
        align-items: start;
    }

    .profile-editor {
        display: grid;
        gap: 14px;
    }

    .field-label {
        display: grid;
        gap: 7px;
    }

    .field-label > span {
        color: var(--text-muted);
        font-size: 11px;
        font-weight: 850;
        letter-spacing: .3px;
    }

    .field-label input,
    .field-label select {
        width: 100%;
        min-height: 45px;
        padding: 10px 12px;
        color: var(--text);
        background: var(--surface-soft);
        border: 1px solid var(--border);
        border-radius: 9px;
        outline: none;
    }

    .field-label input:focus,
    .field-label select:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px var(--accent-surface);
    }

    .field-label small {
        color: var(--text-dim);
        font-size: 9px;
    }


    .title-choice-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
        width: 100%;
    }

    .title-choice {
        display: grid;
        grid-template-rows: auto minmax(36px, auto) auto;
        min-width: 0;
        min-height: 118px;
        gap: 9px;
        padding: 15px 16px;
        overflow: hidden;
        color: var(--text);
        text-align: left;
        white-space: normal;
        background: var(--surface-soft);
        border: 1px solid var(--border);
        border-radius: 12px;
        cursor: pointer;
        transition:
            transform .16s ease,
            border-color .16s ease,
            background .16s ease,
            box-shadow .16s ease;
    }

    .title-choice:hover:not(:disabled) {
        transform: translateY(-2px);
        border-color: var(--accent-border);
        box-shadow: 0 10px 24px var(--shadow);
    }

    .title-choice.selected {
        background:
            linear-gradient(
                145deg,
                var(--accent-surface),
                var(--surface-soft)
            );
        border-color: var(--accent);
        box-shadow:
            0 0 0 2px var(--accent-surface),
            0 12px 28px var(--shadow);
    }

    .title-choice.locked {
        color: var(--text-muted);
        opacity: .72;
        cursor: not-allowed;
    }

    .title-choice-top {
        display: flex;
        min-width: 0;
        align-items: flex-start;
        justify-content: space-between;
        gap: 10px;
        font-size: 14px;
        line-height: 1.3;
    }

    .title-choice-top > * {
        min-width: 0;
    }

    .title-choice-top strong,
    .title-choice-top span {
        overflow-wrap: anywhere;
    }

    .title-choice small {
        display: block;
        min-width: 0;
        color: var(--text-muted);
        font-size: 10px;
        line-height: 1.5;
        overflow-wrap: anywhere;
    }

    .title-state {
        display: inline-flex;
        width: fit-content;
        min-height: 25px;
        align-items: center;
        justify-content: center;
        margin-top: auto;
        padding: 5px 8px;
        color: var(--text-muted);
        background: var(--surface-raised);
        border: 1px solid var(--border);
        border-radius: 999px;
        font-size: 8px;
        font-weight: 950;
        letter-spacing: .65px;
        line-height: 1;
    }

    .title-choice.selected .title-state {
        color: var(--accent-contrast);
        background: var(--accent);
        border-color: var(--accent);
    }

    .emblem-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 8px;
    }

    .emblem-choice {
        display: grid;
        gap: 5px;
        min-height: 74px;
        place-items: center;
        color: var(--text-muted);
        background: var(--surface-soft);
        border: 1px solid var(--border);
        border-radius: 10px;
        cursor: pointer;
    }

    .emblem-choice:hover {
        color: var(--text);
        border-color: var(--border-strong);
    }

    .emblem-choice.selected {
        color: var(--accent-soft);
        background: var(--accent-surface);
        border-color: var(--accent-border);
    }

    .emblem-glyph { display: inline-flex; align-items: center; justify-content: center; }
    .emblem-glyph i, .preview-emblem i { width: 1.15em; height: 1.15em; }
    .emblem-choice strong {
        font-size: 21px;
    }

    .emblem-choice small {
        font-size: 9px;
    }

    .profile-preview {
        align-self: stretch;
        padding: 18px;
        color: var(--dark-panel-text, #eef4f8);
        background:
            radial-gradient(
                circle at 85% 0%,
                var(--accent-surface),
                transparent 42%
            ),
            var(--code-bg);
        border: 1px solid var(--border-strong);
        border-radius: 13px;
    }

    .profile-preview > p {
        margin: 0 0 18px;
        color: var(--code-muted, #aab7c4);
        font-size: 9px;
        font-weight: 900;
        letter-spacing: 1.1px;
    }

    .preview-identity {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .preview-emblem {
        display: grid;
        width: 48px;
        height: 48px;
        place-items: center;
        color: var(--accent-contrast);
        background: var(--accent);
        border-radius: 13px;
        box-shadow: 0 0 24px var(--accent-glow);
        font-size: 21px;
        font-weight: 900;
    }

    .preview-identity strong,
    .preview-identity small {
        display: block;
    }

    .preview-identity strong {
        font-size: 17px;
    }

    .preview-identity small {
        margin-top: 3px;
        color: var(--code-muted, #aab7c4);
        font-size: 10px;
    }

    .preview-achievement {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 22px;
        padding: 12px;
        background: rgba(255, 255, 255, .045);
        border: 1px solid rgba(255, 255, 255, .09);
        border-radius: 10px;
    }

    .preview-achievement > span {
        color: var(--accent);
        font-size: 18px;
    }

    .preview-achievement small,
    .preview-achievement strong {
        display: block;
    }

    .preview-achievement small {
        color: var(--code-muted, #aab7c4);
        font-size: 8px;
        letter-spacing: .8px;
    }

    .preview-achievement strong {
        margin-top: 3px;
        font-size: 11px;
    }

    .panel-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        margin-top: 16px;
        color: var(--text-muted);
        font-size: 10px;
    }

    .panel-footer button,
    .settings-footer button {
        padding: 9px 12px;
        color: var(--text-muted);
        background: transparent;
        border: 1px solid var(--border);
        border-radius: 8px;
        cursor: pointer;
    }

    .panel-footer button:hover,
    .settings-footer button:hover {
        color: var(--text);
        border-color: var(--danger-border);
    }

    .theme-grid {
        display: grid;
        grid-template-columns:
            repeat(auto-fit, minmax(145px, 1fr));
        gap: 10px;
    }

    .theme-choice {
        padding: 10px;
        color: var(--text);
        text-align: left;
        background: var(--surface-soft);
        border: 1px solid var(--border);
        border-radius: 11px;
        cursor: pointer;
    }

    .theme-choice:hover {
        border-color: var(--border-strong);
        transform: translateY(-2px);
    }

    .theme-choice.selected {
        border-color: var(--accent);
        box-shadow: 0 0 0 2px var(--accent-surface);
    }

    .theme-choice strong,
    .theme-choice small {
        display: block;
    }

    .theme-choice strong {
        margin-top: 10px;
        font-size: 12px;
    }

    .theme-choice small {
        margin-top: 4px;
        color: var(--text-muted);
        font-size: 9px;
        line-height: 1.4;
    }

    .theme-preview {
        position: relative;
        display: block;
        height: 76px;
        overflow: hidden;
        background: var(--preview-bg);
        border-radius: 8px;
    }

    .theme-preview i {
        position: absolute;
        display: block;
        background: var(--preview-surface);
        border-radius: 4px;
    }

    .theme-preview i:nth-child(1) {
        inset: 9px 34px 9px 9px;
    }

    .theme-preview i:nth-child(2) {
        right: 9px;
        top: 9px;
        width: 18px;
        height: 28px;
        background: var(--preview-accent);
    }

    .theme-preview i:nth-child(3) {
        right: 9px;
        bottom: 9px;
        width: 18px;
        height: 22px;
    }

    .segmented-control {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
    }

    .segmented-control button {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 52px;
        color: var(--text-muted);
        background: var(--surface-soft);
        border: 1px solid var(--border);
        border-radius: 9px;
        cursor: pointer;
        font-weight: 800;
    }

    .segmented-control button:hover {
        color: var(--text);
        background: var(--surface-hover);
    }

    .segmented-control button.selected {
        color: var(--accent-soft);
        background: var(--accent-surface);
        border-color: var(--accent-border);
    }

    .text-sizes {
        grid-template-columns: repeat(3, 1fr);
    }

    .compact-panel {
        display: grid;
        grid-template-columns: 1fr;
    }

    .toggle-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 15px;
        background: var(--surface-soft);
        border: 1px solid var(--border);
        border-radius: 10px;
        cursor: pointer;
    }

    .toggle-row > span strong,
    .toggle-row > span small {
        display: block;
    }

    .toggle-row > span small {
        margin-top: 4px;
        color: var(--text-muted);
        font-size: 10px;
    }

    .toggle-row input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .toggle-row i {
        position: relative;
        flex: 0 0 48px;
        height: 27px;
        background: var(--surface-strong);
        border: 1px solid var(--border-strong);
        border-radius: 99px;
        transition: .2s;
    }

    .toggle-row i::after {
        content: "";
        position: absolute;
        top: 3px;
        left: 3px;
        width: 19px;
        height: 19px;
        background: var(--text-muted);
        border-radius: 50%;
        transition: .2s;
    }

    .toggle-row input:checked + i {
        background: var(--accent-surface);
        border-color: var(--accent-border);
    }

    .toggle-row input:checked + i::after {
        left: 24px;
        background: var(--accent);
    }

    .settings-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 6px 2px;
        color: var(--text-muted);
        font-size: 11px;
    }

    @@media (max-width: 900px) {
        .profile-grid {
            grid-template-columns: 1fr;
        }

        .profile-preview {
            min-height: 150px;
        }
    }

    @@media (max-width: 780px) {
        .theme-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .setting-heading {
            display: block;
        }

        .setting-heading > p {
            margin-top: 10px;
            text-align: left;
        }

        .title-choice-grid {
            grid-template-columns: 1fr;
        }

        .title-choice {
            min-height: 108px;
        }
    }

    @@media (max-width: 520px) {
        .settings-page {
            padding-inline: 10px;
        }

        .settings-panel {
            padding: 17px;
