@code {
    private const string FullIncidentCode =
        "#include <iostrem>\n\n" +
        "int main\n" +
        "{\n" +
        "    int engineTemperature = \"85\";\n" +
        "    bool coolingPumpReady = yes;\n\n" +
        "    cout << \"Engine temperature: \" << engineTemperature << \"\\n\"\n\n" +
        "    if coolingPumpReady\n" +
        "    {\n" +
        "        std::cout << \"Cooling pump ready.\\n\";\n" +
        "    }\n\n" +
        "    return;\n" +
        "}\n";

    private const string VariablesIncidentCode =
        "#include <iostream>\n\n" +
        "int main()\n" +
        "{\n" +
        "    double engineTemperature = 85;\n" +
        "    int coolingPumpReady = 1;\n\n" +
        "    std::cout << \"Engine temperature: \" << engineTemperature << \"\\n\";\n\n" +
        "    if (coolingPumpReady)\n" +
        "    {\n" +
        "        std::cout << \"Cooling pump ready.\\n\";\n" +
        "    }\n\n" +
        "    return 0;\n" +
        "}\n";

    private const string ControlFlowIncidentCode =
        "#include <iostream>\n\n" +
        "int main()\n" +
        "{\n" +
        "    int engineTemperature = 85;\n" +
        "    bool coolingPumpReady = true;\n\n" +
        "    std::cout << \"Temperature available.\\n\";\n\n" +
        "    if (engineTemperature)\n" +
        "    {\n" +
        "        std::cout << \"Cooling status unknown.\\n\";\n" +
        "    }\n\n" +
        "    return 0;\n" +
        "}\n";

    private bool AccessReady;
    private bool AccessGranted;
    private bool ProgressLoadFailed;
    private int CompletedChapterModules;

    private string SelectedProfile = "full";
    private string EditorCode = FullIncidentCode;
    private bool IsRunning;
    private bool HasRun;
    private bool HintVisible;
    private int HintsUsed;
    private bool SubmissionComplete;
    private bool MissionPassed;
    private int FinalScore;
    private int FinalElapsedSeconds;
    private string ResultMessage = "";
    private string RewardMessage = "";
    private bool RewardProcessing;
    private bool RewardsProcessed;
    private string AttemptId = Guid.NewGuid().ToString("N");
    private CppMinigameState SavedState = new();
    private AchievementUnlockResult? MissionAchievement;
    private DateTimeOffset? AttemptStartedAt;
    private int AccumulatedSeconds;
    private string WorkspaceMessage =
        "Select an incident profile and restore the startup sequence.";

    private List<string> ConsoleLines = new();

    private IReadOnlyList<DamageProfile> DamageProfiles =>
        new[]
        {
            new DamageProfile(
                "full",
                "Full Startup Failure",
                "Full Incident",
                "Repair the complete startup program",
                "Headers, entry point, variables, output, control flow, and exit logic are damaged.",
                "Start with the program frame",
                "Repair the iostream header and int main() first. Then use an int for temperature, a bool for pump readiness, valid std::cout statements, an if condition, and return 0."),
            new DamageProfile(
                "variables",
                "Variables & Types Failure",
                "Variables & Types",
                "Repair int and bool declarations",
                "The program runs structurally, but the engine values use the wrong C++ types.",
                "Match the value to its type",
                "The temperature is a whole number, so use int. Pump readiness has only true or false states, so use bool."),
            new DamageProfile(
                "control",
                "Control Flow & Output Failure",
                "Control Flow & Output",
                "Repair output and the if condition",
                "The variables are correct, but the program reports the wrong information and checks the wrong condition.",
                "Report and test the stored values",
                "Print engineTemperature in the temperature line. The if statement should inspect coolingPumpReady and report that the cooling pump is ready.")
        };

    private DamageProfile CurrentProfile =>
        DamageProfiles.First(
            profile =>
                profile.Id == SelectedProfile);

    private int EditorLineCount =>
        string.IsNullOrEmpty(EditorCode)
            ? 1
            : EditorCode
                .Replace("\r\n", "\n")
                .Split('\n')
                .Length;

    private string WorkshopStatus =>
        SubmissionComplete
            ? MissionPassed
                ? "Mission passed"
                : "Mission failed"
            : IsRunning
                ? "Mission simulation active"
                : HasRun
                    ? "Mission simulation stopped"
                    : "Incident loaded";

    private int PassedRequirementCount =>
        PreviewChecks.Count(check => check.Met);

    private int RequirementPoints =>
        PassedRequirementCount * 140;

    private int ElapsedSeconds =>
        SubmissionComplete
            ? FinalElapsedSeconds
            : AccumulatedSeconds +
              (AttemptStartedAt.HasValue
                  ? Math.Max(
                      0,
                      (int)(DateTimeOffset.UtcNow - AttemptStartedAt.Value)
                          .TotalSeconds)
                  : 0);

    private int CurrentTimeBonus =>
        Math.Clamp(160 - (ElapsedSeconds / 5) * 5, 0, 160);

    private int HintPenalty =>
        HintsUsed * 40;

    private int ProjectedScore =>
        Math.Clamp(
            RequirementPoints + CurrentTimeBonus - HintPenalty,
            0,
            1000);

    private string ElapsedLabel =>
        FormatTime(ElapsedSeconds);

    private string FinalElapsedLabel =>
        FormatTime(FinalElapsedSeconds);

    private string FastestClearLabel =>
        SavedState.FastestSeconds.HasValue
            ? FormatTime(
                Math.Max(
                    0,
                    (int)Math.Round(
                        SavedState.FastestSeconds.Value)))
            : "--:--";

    private IReadOnlyList<PreviewCheck> PreviewChecks =>
        new[]
        {
            new PreviewCheck(
                "Program frame",
                "Use #include <iostream> and int main().",
                HasExactText("#include <iostream>") &&
                HasPattern(@"int\s+main\s*\(\s*\)")),
            new PreviewCheck(
                "Temperature variable",
                "Declare int engineTemperature = 85.",
                HasPattern(
                    @"int\s+engineTemperature\s*=\s*85\s*;")),
            new PreviewCheck(
                "Pump-ready variable",
                "Declare bool coolingPumpReady = true.",
                HasPattern(
                    @"bool\s+coolingPumpReady\s*=\s*true\s*;")),
            new PreviewCheck(
                "Temperature report",
                "Print the label and engineTemperature value.",
                HasExactText("std::cout") &&
                HasExactText("\"Engine temperature: \"") &&
                HasExactText("engineTemperature")),
            new PreviewCheck(
                "Pump control flow",
                "Check coolingPumpReady and report the ready state.",
                HasPattern(
                    @"if\s*\(\s*coolingPumpReady\s*\)") &&
                HasExactText("\"Cooling pump ready.")),
            new PreviewCheck(
                "Successful exit",
                "Return zero from main.",
                HasPattern(@"return\s+0\s*;"))
        };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            CourseProgressSnapshot progress =
                await CourseEngine.GetProgressAsync(
                    CourseIds.Cpp);

            CompletedChapterModules =
                progress.ModuleCompleted
                    .Take(8)
                    .Count(completed => completed);

            AccessGranted =
                progress.ModuleCompleted.Length > 7 &&
                progress.ModuleCompleted[7];

            SavedState =
                await JS.InvokeAsync<CppMinigameState>(
                    "caveCodeCppMinigame.getState");
        }
        catch
        {
            ProgressLoadFailed = true;
            AccessGranted = false;
        }

        AccessReady = true;
        await InvokeAsync(StateHasChanged);
    }

    private void SelectProfile(string profileId)
    {
        DamageProfile? profile =
            DamageProfiles.FirstOrDefault(
                item =>
                    item.Id == profileId);

        if (profile is null)
        {
            return;
        }

        SelectedProfile = profile.Id;
        EditorCode =
            profile.Id switch
            {
                "variables" =>
                    VariablesIncidentCode,
                "control" =>
                    ControlFlowIncidentCode,
                _ =>
                    FullIncidentCode
            };

        IsRunning = false;
        HasRun = false;
        HintVisible = false;
        HintsUsed = 0;
        SubmissionComplete = false;
        MissionPassed = false;
        FinalScore = 0;
        FinalElapsedSeconds = 0;
        ResultMessage = "";
        RewardMessage = "";
        RewardProcessing = false;
        RewardsProcessed = false;
        MissionAchievement = null;
        AttemptId = Guid.NewGuid().ToString("N");
        AttemptStartedAt = null;
        AccumulatedSeconds = 0;
        ConsoleLines.Clear();
        WorkspaceMessage =
            profile.Title +
            " loaded. Restore all six requirements.";
    }

    private void StartSimulation()
    {
        if (SubmissionComplete)
        {
            return;
        }

        if (!AttemptStartedAt.HasValue)
        {
            AttemptStartedAt = DateTimeOffset.UtcNow;
        }

        IsRunning = true;
        HasRun = true;
        WorkspaceMessage =
            "Mission preview inspected the current startup sequence.";

        ConsoleLines.Clear();
        ConsoleLines.Add(
            "[SIM] Engine Foundry Mission 1 preview started.");
        ConsoleLines.Add(
            "[SIM] No native compiler or executable is running.");
        ConsoleLines.Add(
            $"[PROFILE] {CurrentProfile.Title}");

        foreach (PreviewCheck check in PreviewChecks)
        {
            ConsoleLines.Add(
                check.Met
                    ? $"[OK] {check.Label}"
                    : $"[WARN] Unresolved requirement: {check.Label}");
        }

        if (PreviewChecks.All(check => check.Met))
        {
            ConsoleLines.Add(
                "[SIM] All authored startup requirements are present.");
            ConsoleLines.Add(
                "[SIM] Engine temperature: 85");
            ConsoleLines.Add(
                "[SIM] Cooling pump ready.");
            ConsoleLines.Add(
                "[SIM] Startup sequence restored.");
        }
        else
        {
            ConsoleLines.Add(
                "[WARN] Startup sequence remains incomplete.");
        }
    }

    private void PauseSimulation()
    {
        if (!IsRunning)
        {
            return;
        }

        StopAttemptClock();
        IsRunning = false;
        WorkspaceMessage =
            "Mission simulation paused. Editor contents are unchanged.";
        ConsoleLines.Add(
            "[PAUSED] Simulated startup loop paused.");
    }

    private void ResetWorkspace()
    {
        SelectProfile(SelectedProfile);
        WorkspaceMessage =
            CurrentProfile.Title +
            " restored to its original damaged state.";
    }

    private void ToggleHint()
    {
        bool opening = !HintVisible;
        HintVisible = opening;

        if (opening && !SubmissionComplete)
        {
            HintsUsed += 1;

            if (!AttemptStartedAt.HasValue)
            {
                AttemptStartedAt = DateTimeOffset.UtcNow;
            }
        }
    }

    private async Task SubmitMission()
    {
        if (SubmissionComplete)
        {
            return;
        }

        StopAttemptClock();
        FinalElapsedSeconds = ElapsedSeconds;
        MissionPassed =
            PreviewChecks.All(check => check.Met);
        FinalScore = Math.Clamp(
            RequirementPoints +
            Math.Clamp(
                160 - (FinalElapsedSeconds / 5) * 5,
                0,
                160) -
            HintPenalty,
            0,
            1000);
        SubmissionComplete = true;
        IsRunning = false;
        HasRun = true;

        ResultMessage =
            MissionPassed
                ? "All six startup requirements passed. Rewards remain disabled until Pass 7D."
                : $"{PassedRequirementCount} of 6 requirements passed. Repair the pending evidence and start a new attempt.";

        ConsoleLines.Add(
            MissionPassed
                ? $"[RESULT] PASS · {FinalScore}/1000"
                : $"[RESULT] FAIL · {FinalScore}/1000");

        if (MissionPassed)
        {
            await ProcessRewardsAsync();
        }
    }

    private async Task ProcessRewardsAsync()
    {
        if (RewardsProcessed || RewardProcessing)
        {
            return;
        }

        RewardProcessing = true;
        RewardMessage = "";

        try
        {
            CppMinigameRecordResult record =
                await JS.InvokeAsync<CppMinigameRecordResult>(
                    "caveCodeCppMinigame.recordClear",
                    AttemptId,
                    FinalScore,
                    Math.Max(0, FinalElapsedSeconds),
                    SelectedProfile);

            int validatedLines =
                EditorCode
                    .Replace("\r\n", "\n")
                    .Split('\n')
                    .Count(
                        line =>
                            !string.IsNullOrWhiteSpace(line));

            await ProgressionService.AwardMinigameRunAsync(
                CourseIds.Cpp,
                record.RewardKey,
                record.XpAwarded,
                validatedLines);

            await AchievementService
                .AwardMinigameCrystalsAsync(
                    record.RewardKey,
                    record.CrystalsAwarded);

            MissionAchievement =
                await AchievementService
                    .UnlockChapterAsync(
                        "cpp-minigame",
                        1);

            SavedState = record.State;
            RewardsProcessed = true;

            string recordText =
                record.NewBestScore &&
                record.NewFastestTime
                    ? " New best score and fastest clear."
                    : record.NewBestScore
                        ? " New best score."
                        : record.NewFastestTime
                            ? " New fastest clear."
                            : "";

            RewardMessage =
                $"+{record.XpAwarded} C++ XP, " +
                $"◆ {record.CrystalsAwarded} crystals, and " +
                $"{validatedLines} validated C++ lines saved." +
                recordText;

            try
            {
                await JS.InvokeVoidAsync(
                    "caveCodeProgression.syncLeaderboardProfile");
            }
            catch
            {
                // Local rewards remain valid if cloud sync is unavailable.
            }
        }
        catch (Exception error)
        {
            RewardMessage =
                "The mission passed, but the local reward save " +
                "did not finish: " +
                error.Message;
        }
        finally
        {
            RewardProcessing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void NewAttempt()
    {
        SelectProfile(SelectedProfile);
        WorkspaceMessage =
            CurrentProfile.Title +
            " loaded as a new scored attempt.";
    }

    private void StopAttemptClock()
    {
        if (!AttemptStartedAt.HasValue)
        {
            return;
        }

        AccumulatedSeconds += Math.Max(
            0,
            (int)(DateTimeOffset.UtcNow - AttemptStartedAt.Value)
                .TotalSeconds);
        AttemptStartedAt = null;
    }

    private static string FormatTime(int seconds) =>
        $"{seconds / 60:00}:{seconds % 60:00}";

    private bool HasExactText(string value) =>
        EditorCode.Contains(
            value,
            StringComparison.Ordinal);

    private bool HasPattern(string pattern) =>
        System.Text.RegularExpressions.Regex.IsMatch(
            EditorCode,
            pattern,
            System.Text.RegularExpressions.RegexOptions.CultureInvariant);

    private static string ConsoleLineClass(string line)
    {
        if (line.StartsWith("[OK]", StringComparison.Ordinal))
        {
            return "console-ok";
        }

        if (line.StartsWith("[WARN]", StringComparison.Ordinal))
        {
            return "console-warn";
        }

        if (line.StartsWith("[PAUSED]", StringComparison.Ordinal))
        {
            return "console-pause";
        }

        return "console-sim";
    }

    private sealed record PreviewCheck(
        string Label,
        string Description,
        bool Met);

    private sealed record DamageProfile(
        string Id,
        string Title,
        string ShortName,
        string Focus,
        string IncidentReport,
        string HintTitle,
        string HintText);

    private sealed class CppMinigameState
    {
        public bool Mission1Completed { get; set; }
        public int BestScore { get; set; }
        public double? FastestSeconds { get; set; }
        public int TotalClears { get; set; }
        public int TotalXpEarned { get; set; }
        public int TotalCrystalsEarned { get; set; }
        public int LastScore { get; set; }
        public double LastElapsedSeconds { get; set; }
        public string LastProfile { get; set; } = "";
    }

    private sealed class CppMinigameRecordResult
    {
        public string RewardKey { get; set; } = "";
        public int XpAwarded { get; set; }
        public int CrystalsAwarded { get; set; }
        public bool FirstClear { get; set; }
        public bool NewBestScore { get; set; }
        public bool NewFastestTime { get; set; }
        public bool DuplicateAttempt { get; set; }
        public CppMinigameState State { get; set; } = new();
    }
}
