@page "/minigames/cpp"
@using CaveCode.CourseEngine
@using Microsoft.JSInterop
@inject CourseEngineService CourseEngine
@inject ProgressionService ProgressionService
@inject AchievementService AchievementService
@inject IJSRuntime JS

<PageTitle>C++ Engine Foundry Minigame | CaveCode Academy</PageTitle>

@if (!AccessReady)
{
    <main class="foundry-access-screen">
        <section>
            <span class="foundry-access-mark">C++</span>
            <p class="foundry-eyebrow">ENGINE FOUNDRY</p>
            <h1>Preparing the minigame workshop</h1>
            <p>Checking your C++ Chapter 1 checkpoint on this device.</p>
        </section>
    </main>
}
else if (!AccessGranted)
{
    <main class="foundry-access-screen">
        <section>
            <span class="foundry-access-mark">C++</span>
            <p class="foundry-eyebrow">CHAPTER 1 ACCESS GATE</p>
            <h1>Engine Foundry is still locked</h1>

            @if (ProgressLoadFailed)
            {
                <p>
                    CaveCode could not read the local C++ course checkpoint.
                    Open the C++ course once, then return to this page.
                </p>
            }
            else
            {
                <p>
                    Complete all eight C++ Foundry Foundations modules before
                    entering the minigame workshop.
                </p>

                <div class="foundry-gate-progress">
                    <strong>@CompletedChapterModules / 8</strong>
                    <span>Chapter 1 modules complete</span>
                </div>
            }

            <div class="foundry-access-actions">
                <NavLink class="foundry-primary" href="/cpp">
                    Open C++ Chapter 1 →
                </NavLink>
                <NavLink class="foundry-secondary" href="/minigames">
                    Back to Minigames
                </NavLink>
            </div>
        </section>
    </main>
}
else
{
    <main class="cpp-foundry-shell">
        <header class="foundry-header">
            <div class="foundry-title-group">
                <span class="foundry-logo">C++</span>
                <div>
                    <p class="foundry-eyebrow">MISSION 1 REWARDS · PASS 7D</p>
                    <h1>Engine Foundry</h1>
                    <p>
                        Restore a damaged engine startup sequence using C++
                        variables, boolean state, control flow, and console output.
                    </p>
                </div>
            </div>

            <nav class="foundry-header-actions" aria-label="Engine Foundry navigation">
                <NavLink href="/minigames">Minigames</NavLink>
                <NavLink href="/minigames/cpp/mission-2">Mission 2</NavLink>
                <NavLink href="/cpp">C++ Course</NavLink>
            </nav>
        </header>

        <section class="foundry-phase-notice" aria-label="Mission preview limitations">
            <strong>Authored mission preview</strong>
            <span>
                Persistent records, C++ XP, validated lines, crystals,
                achievements, and leaderboard synchronization are active.
            </span>
        </section>

        <section class="foundry-record-summary" aria-label="Saved Engine Foundry record">
            <div>
                <span>Best score</span>
                <strong>@SavedState.BestScore.ToString("N0")</strong>
            </div>
            <div>
                <span>Fastest clear</span>
                <strong>@FastestClearLabel</strong>
            </div>
            <div>
                <span>Total clears</span>
                <strong>@SavedState.TotalClears</strong>
            </div>
            <div>
                <span>Foundry XP</span>
                <strong>@SavedState.TotalXpEarned.ToString("N0")</strong>
            </div>
        </section>

        <section class="foundry-incident-selector" aria-label="Mission damage profile">
            <div>
                <p class="foundry-eyebrow">MISSION 1 · RESTORE THE ENGINE STARTUP SEQUENCE</p>
                <h2>@CurrentProfile.Title</h2>
                <p>@CurrentProfile.IncidentReport</p>
            </div>

            <div class="foundry-profile-buttons">
                @foreach (DamageProfile profile in DamageProfiles)
                {
                    <button type="button"
                            class="foundry-profile-button @(SelectedProfile == profile.Id ? "selected" : "")"
                            aria-pressed="@(SelectedProfile == profile.Id)"
                            @onclick="() => SelectProfile(profile.Id)">
                        <strong>@profile.ShortName</strong>
                        <span>@profile.Focus</span>
                    </button>
                }
            </div>
        </section>

        <div class="foundry-workspace">
            <aside class="foundry-objectives">
                <div class="foundry-panel-heading">
                    <div>
                        <p class="foundry-eyebrow">MISSION REQUIREMENTS</p>
                        <h2>Startup repair checklist</h2>
                    </div>
                    <span>@PreviewChecks.Count(check => check.Met) / @PreviewChecks.Count</span>
                </div>

                <p class="foundry-panel-copy">
                    Repair all six authored requirements. Live evidence and
                    projected scoring update as you edit. All six must pass.
                </p>

                <div class="foundry-check-list">
                    @foreach (PreviewCheck check in PreviewChecks)
                    {
                        <div class="foundry-check @(check.Met ? "met" : "")">
                            <span>@(check.Met ? "✓" : "○")</span>
                            <div>
                                <strong>@check.Label</strong>
                                <small>@check.Description</small>
                                <em>@(check.Met ? "Requirement satisfied" : "Pending repair")</em>
                            </div>
                        </div>
                    }
                </div>

                <div class="foundry-build-status">
                    <span>WORKSHOP STATUS</span>
                    <strong>@WorkshopStatus</strong>
                    <small>@WorkspaceMessage</small>
                </div>

                <section class="foundry-score-panel" aria-label="Mission score">
                    <div>
                        <span>Projected score</span>
                        <strong>@ProjectedScore / 1000</strong>
                    </div>
                    <div>
                        <span>Requirements</span>
                        <strong>@RequirementPoints / 840</strong>
                    </div>
                    <div>
                        <span>Time bonus</span>
                        <strong>@CurrentTimeBonus / 160</strong>
                    </div>
                    <div>
                        <span>Hint penalty</span>
                        <strong>-@HintPenalty</strong>
                    </div>
                    <div>
                        <span>Elapsed</span>
                        <strong>@ElapsedLabel</strong>
                    </div>
                </section>

                @if (SubmissionComplete)
                {
                    <section class="foundry-result @(MissionPassed ? "passed" : "failed")"
                             role="status">
                        <strong>@(MissionPassed ? "MISSION PASSED" : "MISSION FAILED")</strong>
                        <span>@FinalScore / 1000 · @FinalElapsedLabel</span>
                        <p>@ResultMessage</p>

                        @if (RewardProcessing)
                        {
                            <small>Saving rewards and mission record…</small>
                        }
                        else if (!string.IsNullOrWhiteSpace(RewardMessage))
                        {
                            <small>@RewardMessage</small>
                        }

                        @if (MissionAchievement?.NewlyUnlocked == true)
                        {
                            <small>
                                Achievement unlocked: Engine Restored ·
                                Title available: Engine Technician
                            </small>
                        }
                    </section>
                }

                <div class="foundry-objective-footer">
                    <span>Target blueprint</span>
                    <strong>Read temperature → inspect pump state → report startup status</strong>
                </div>
            </aside>

            <section class="foundry-editor-panel" aria-label="C++ editor">
                <div class="foundry-editor-toolbar">
                    <div>
                        <span class="foundry-file-dot"></span>
                        <strong>EngineStartup.cpp</strong>
                    </div>
                    <span>@EditorLineCount line@(EditorLineCount == 1 ? "" : "s")</span>
                </div>

                <textarea class="foundry-editor"
                          aria-label="C++ practice editor"
                          spellcheck="false"
                          @bind="EditorCode"
                          @bind:event="oninput"></textarea>

                <div class="foundry-control-bar">
                    <button type="button"
                            class="foundry-primary"
                            @onclick="StartSimulation">
                        @(IsRunning
                            ? "Restart simulation"
                            : HasRun
                                ? "Run again"
                                : "Start simulation")
                    </button>

                    <button type="button"
                            class="foundry-secondary"
                            disabled="@(!IsRunning)"
                            @onclick="PauseSimulation">
                        Pause
                    </button>

                    <button type="button"
                            class="foundry-secondary"
                            @onclick="ResetWorkspace">
                        Reset
                    </button>

                    <button type="button"
                            class="foundry-secondary"
                            aria-pressed="@HintVisible"
                            @onclick="ToggleHint">
                        @(HintVisible ? "Hide hint" : "Hint")
                    </button>

                    <button type="button"
                            class="foundry-submit"
                            disabled="@SubmissionComplete"
                            @onclick="SubmitMission">
                        Submit mission
                    </button>

                    @if (SubmissionComplete)
                    {
                        <button type="button"
                                class="foundry-secondary"
                                @onclick="NewAttempt">
                            New attempt
                        </button>
                    }
                </div>

                @if (HintVisible)
                {
                    <aside class="foundry-hint" role="note">
                        <strong>@CurrentProfile.HintTitle</strong>
                        <p>@CurrentProfile.HintText</p>
                    </aside>
                }
            </section>

            <aside class="foundry-side-stack">
                <section class="foundry-reference-panel">
                    <div class="foundry-panel-heading">
                        <div>
                            <p class="foundry-eyebrow">MISSION REFERENCE</p>
                            <h2>Startup control logic</h2>
                        </div>
                    </div>

                    <dl class="foundry-reference-list">
                        <div>
                            <dt><code>int engineTemperature = 85;</code></dt>
                            <dd>Stores a whole-number sensor reading.</dd>
                        </div>
                        <div>
                            <dt><code>bool coolingPumpReady = true;</code></dt>
                            <dd>Stores whether the cooling pump is available.</dd>
                        </div>
                        <div>
                            <dt><code>if (coolingPumpReady)</code></dt>
                            <dd>Selects the correct startup message.</dd>
                        </div>
                        <div>
                            <dt><code>std::cout &lt;&lt; value;</code></dt>
                            <dd>Reports values and status to the simulated console.</dd>
                        </div>
                    </dl>
                </section>

                <section class="foundry-console-panel" aria-label="Simulated output console">
                    <div class="foundry-console-toolbar">
                        <div>
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                        <strong>SIMULATED OUTPUT</strong>
                    </div>

                    <div class="foundry-console"
                         role="log"
                         aria-live="polite">
                        @if (ConsoleLines.Count == 0)
                        {
                            <p class="console-muted">
                                [READY] Start the simulation to inspect the
                                current editor contents.
                            </p>
                        }
                        else
                        {
                            @foreach (string line in ConsoleLines)
                            {
                                <p class="@ConsoleLineClass(line)">@line</p>
                            }
                        }
                    </div>
                </section>
            </aside>
        </div>
    </main>
}

<style>
    .cpp-foundry-shell,
    .foundry-access-screen {
        box-sizing: border-box;
        min-height: 100vh;
        color: var(--text, #edf4ff);
        background: var(--bg, #08111f);
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .cpp-foundry-shell *,
    .foundry-access-screen * {
        box-sizing: border-box;
    }

    .cpp-foundry-shell button,
    .cpp-foundry-shell textarea,
    .foundry-access-screen a {
        font: inherit;
    }

    .foundry-access-screen {
        display: grid;
        place-items: center;
        padding: 28px;
    }

    .foundry-access-screen > section {
        width: min(620px, 100%);
        padding: 34px;
        text-align: center;
        background: var(--surface-soft, #111c2c);
        border: 1px solid var(--border, #2b3b52);
        border-radius: 18px;
        box-shadow: 0 24px 70px var(--shadow, rgba(0, 0, 0, .35));
    }

    .foundry-access-screen h1 {
        margin: 8px 0 12px;
        font-size: clamp(28px, 5vw, 42px);
    }

    .foundry-access-screen p {
        margin: 0 auto;
        max-width: 520px;
        color: var(--text-muted, #aab8cb);
        line-height: 1.65;
    }

    .foundry-access-mark,
    .foundry-logo {
        display: grid;
        place-items: center;
        color: var(--accent-contrast, #061120);
        background: var(--accent, #61dafb);
        border: 1px solid var(--accent-border, #9ae8ff);
        box-shadow: 0 12px 35px var(--shadow, rgba(0, 0, 0, .3));
        font-weight: 950;
        letter-spacing: -.05em;
    }

    .foundry-access-mark {
        width: 70px;
        height: 64px;
        margin: 0 auto 18px;
        border-radius: 15px;
        font-size: 18px;
    }

    .foundry-gate-progress {
        display: grid;
        gap: 3px;
        width: min(260px, 100%);
        padding: 16px;
        margin: 22px auto 0;
        background: var(--accent-surface, rgba(97, 218, 251, .1));
        border: 1px solid var(--accent-border, #4f7990);
        border-radius: 12px;
    }

    .foundry-gate-progress strong {
        font-size: 24px;
    }

    .foundry-gate-progress span {
        color: var(--text-muted, #aab8cb);
        font-size: 12px;
    }

    .foundry-access-actions {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 24px;
    }

    .cpp-foundry-shell {
        padding: 24px;
    }

    .foundry-header {
        display: flex;
        max-width: 1600px;
        align-items: center;
        justify-content: space-between;
        gap: 22px;
        margin: 0 auto 18px;
    }

    .foundry-title-group {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .foundry-logo {
        flex: 0 0 64px;
        height: 58px;
        border-radius: 13px;
        font-size: 16px;
    }

    .foundry-title-group h1 {
        margin: 0;
        font-size: clamp(26px, 4vw, 38px);
    }

    .foundry-title-group p:last-child {
        max-width: 760px;
        margin: 6px 0 0;
        color: var(--text-muted, #aab8cb);
        line-height: 1.5;
    }

    .foundry-eyebrow {
        margin: 0 0 5px;
        color: var(--accent, #61dafb);
        font-size: 10px;
        font-weight: 900;
        letter-spacing: .12em;
    }

    .foundry-header-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .foundry-header-actions a {
        padding: 9px 12px;
        color: var(--text, #edf4ff);
        text-decoration: none;
        background: var(--surface, #0d1726);
        border: 1px solid var(--border, #2b3b52);
        border-radius: 9px;
        font-size: 12px;
        font-weight: 800;
    }

    .foundry-header-actions a:hover,
    .foundry-header-actions a:focus-visible {
        border-color: var(--accent-border, #6ecde9);
        background: var(--accent-surface, rgba(97, 218, 251, .1));
    }

    .foundry-phase-notice {
        display: flex;
        max-width: 1600px;
        align-items: center;
        gap: 14px;
        padding: 12px 15px;
        margin: 0 auto 16px;
        background: var(--accent-surface, rgba(97, 218, 251, .1));
        border: 1px solid var(--accent-border, #4f7990);
        border-radius: 11px;
    }

    .foundry-phase-notice strong {
        flex: 0 0 auto;
        color: var(--accent-soft, #9feaff);
        font-size: 11px;
        letter-spacing: .07em;
        text-transform: uppercase;
    }

    .foundry-phase-notice span {
        color: var(--text-muted, #aab8cb);
        font-size: 12px;
        line-height: 1.45;
    }

    .foundry-incident-selector {
        display: grid;
        grid-template-columns: minmax(260px, .8fr) minmax(460px, 1.2fr);
        max-width: 1600px;
        gap: 18px;
        padding: 17px;
        margin: 0 auto 16px;
        background: var(--surface-soft, #111c2c);
        border: 1px solid var(--border, #2b3b52);
        border-radius: 14px;
    }

    .foundry-incident-selector h2 {
        margin: 0 0 7px;
        font-size: 18px;
    }

    .foundry-incident-selector > div > p:last-child {
        margin: 0;
        color: var(--text-muted, #aab8cb);
        font-size: 11px;
        line-height: 1.55;
    }

    .foundry-profile-buttons {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 9px;
    }

    .foundry-profile-button {
        min-width: 0;
        padding: 11px;
        text-align: left;
        color: var(--text, #edf4ff);
        background: var(--surface, #0d1726);
        border: 1px solid var(--border, #2b3b52);
        border-radius: 10px;
        cursor: pointer;
    }

    .foundry-profile-button strong,
    .foundry-profile-button span {
        display: block;
    }

    .foundry-profile-button strong {
        font-size: 10px;
    }

    .foundry-profile-button span {
        margin-top: 4px;
        color: var(--text-muted, #aab8cb);
        font-size: 8px;
        line-height: 1.35;
    }

    .foundry-profile-button.selected {
        background: var(--accent-surface, rgba(97, 218, 251, .1));
        border-color: var(--accent-border, #4f7990);
        box-shadow: inset 0 0 0 1px var(--accent-border, #4f7990);
    }

    .foundry-profile-button:focus-visible {
        outline: 3px solid var(--focus, #ffd166);
        outline-offset: 2px;
    }

    .foundry-workspace {
        display: grid;
        grid-template-columns: 255px minmax(460px, 1fr) 350px;
        max-width: 1600px;
        min-height: 690px;
        gap: 14px;
        margin: 0 auto;
    }

    .foundry-objectives,
    .foundry-editor-panel,
    .foundry-reference-panel,
    .foundry-console-panel {
        background: var(--surface-soft, #111c2c);
        border: 1px solid var(--border, #2b3b52);
        border-radius: 14px;
    }

    .foundry-objectives {
        display: flex;
        min-width: 0;
        flex-direction: column;
        padding: 17px;
    }

    .foundry-panel-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
    }

    .foundry-panel-heading h2 {
        margin: 0;
        font-size: 17px;
    }

    .foundry-panel-heading > span {
        padding: 5px 8px;
        color: var(--accent-soft, #9feaff);
        background: var(--accent-surface, rgba(97, 218, 251, .1));
        border: 1px solid var(--accent-border, #4f7990);
        border-radius: 999px;
        font-size: 10px;
        font-weight: 900;
    }

    .foundry-panel-copy {
        margin: 10px 0 15px;
        color: var(--text-muted, #aab8cb);
        font-size: 11px;
        line-height: 1.55;
    }

    .foundry-check-list {
        display: grid;
        gap: 8px;
    }

    .foundry-check {
        display: grid;
        grid-template-columns: 24px 1fr;
        gap: 9px;
        padding: 10px;
        background: var(--surface, #0d1726);
        border: 1px solid var(--border, #2b3b52);
        border-radius: 9px;
    }

    .foundry-check > span {
        display: grid;
        width: 23px;
        height: 23px;
        place-items: center;
        color: var(--text-muted, #aab8cb);
        background: var(--surface-strong, #172539);
        border-radius: 50%;
        font-size: 11px;
        font-weight: 900;
    }

    .foundry-check.met {
        border-color: var(--accent-border, #4f7990);
        background: var(--accent-surface, rgba(97, 218, 251, .08));
    }

    .foundry-check.met > span {
        color: var(--accent-contrast, #061120);
        background: var(--accent, #61dafb);
    }

    .foundry-check strong,
    .foundry-check small {
        display: block;
    }

    .foundry-check strong {
        font-size: 11px;
    }

    .foundry-check small {
        margin-top: 3px;
        color: var(--text-muted, #aab8cb);
        font-size: 9px;
        line-height: 1.4;
    }

    .foundry-record-summary {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        max-width: 1600px;
        gap: 10px;
        margin: 0 auto 16px;
    }

    .foundry-record-summary > div {
        display: grid;
        gap: 4px;
        padding: 12px;
        background: var(--surface-soft, #111c2c);
        border: 1px solid var(--border, #2b3b52);
        border-radius: 10px;
    }

    .foundry-record-summary span {
        color: var(--text-muted, #aab8cb);
        font-size: 8px;
        font-weight: 850;
        letter-spacing: .06em;
        text-transform: uppercase;
    }

    .foundry-record-summary strong {
        font-size: 13px;
    }

    .foundry-result small {
        color: var(--accent-soft, #9feaff);
        font-size: 9px;
        line-height: 1.45;
    }

    .foundry-score-panel {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 7px;
        margin-top: 10px;
    }

    .foundry-score-panel > div {
        display: grid;
        gap: 3px;
        padding: 9px;
        background: var(--surface, #0d1726);
        border: 1px solid var(--border, #2b3b52);
        border-radius: 8px;
    }

    .foundry-score-panel span {
        color: var(--text-muted, #aab8cb);
        font-size: 8px;
        text-transform: uppercase;
        letter-spacing: .06em;
    }

    .foundry-score-panel strong {
        font-size: 11px;
    }

    .foundry-result {
        display: grid;
        gap: 5px;
        padding: 11px;
        margin-top: 10px;
        border-radius: 9px;
    }

    .foundry-result.passed {
        background: rgba(64, 190, 110, .12);
        border: 1px solid rgba(96, 230, 140, .55);
    }

    .foundry-result.failed {
        background: rgba(230, 90, 90, .11);
        border: 1px solid rgba(255, 120, 120, .55);
    }

    .foundry-result strong {
        font-size: 11px;
    }

    .foundry-result span,
    .foundry-result p {
        margin: 0;
        color: var(--text-muted, #aab8cb);
        font-size: 9px;
        line-height: 1.4;
    }

    .foundry-check em {
        display: block;
        margin-top: 4px;
        color: var(--accent-soft, #9feaff);
        font-size: 8px;
        font-style: normal;
        font-weight: 800;
    }

    .foundry-submit {
        min-height: 40px;
        padding: 9px 13px;
        color: #fff;
        background: #1769d2;
        border: 1px solid #7eb8ff;
        border-radius: 9px;
        cursor: pointer;
        font-size: 11px;
        font-weight: 900;
    }

    .foundry-submit:disabled {
        cursor: not-allowed;
        opacity: .5;
    }

    .foundry-submit:focus-visible {
        outline: 3px solid var(--focus, #ffd166);
        outline-offset: 2px;
    }

    .foundry-build-status {
        display: grid;
        gap: 4px;
        padding: 12px;
        margin-top: 15px;
        background: var(--surface, #0d1726);
        border: 1px solid var(--border, #2b3b52);
        border-radius: 9px;
    }

    .foundry-build-status > span,
    .foundry-objective-footer span {
        color: var(--text-muted, #aab8cb);
        font-size: 9px;
        font-weight: 850;
        letter-spacing: .08em;
    }

    .foundry-build-status strong {
