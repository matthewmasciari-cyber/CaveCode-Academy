    private RequirementCheck[] EvaluateRequirements() =>
        Enumerable.Range(
                0,
                Requirements.Length)
            .Select(EvaluateRequirement)
            .ToArray();

    private RequirementCheck EvaluateRequirement(
        int index) =>
        index switch
        {
            0 => EvaluateSemantics(),
            1 => EvaluateNavigation(),
            2 => EvaluateImageAlternative(),
            3 => EvaluateWideLayoutAndContrast(),
            4 => EvaluateFocusVisibility(),
            5 => EvaluateResponsiveBehavior(),
            _ => new(false, "Unknown requirement.")
        };

    private RequirementCheck EvaluateSemantics()
    {
        bool header = HasTag(HtmlCode, "header");
        bool nav = HasTag(HtmlCode, "nav");
        bool main = HasTag(HtmlCode, "main");
        bool sections =
            CountTags(HtmlCode, "section") >= 2;
        bool articles =
            CountTags(HtmlCode, "article") >= 3;
        bool footer = HasTag(HtmlCode, "footer");

        bool passed =
            header &&
            nav &&
            main &&
            sections &&
            articles &&
            footer;

        return new(
            passed,
            passed
                ? "Semantic landmarks and all three project articles are present."
                : "Need header, nav, main, at least two sections, three articles, and footer.");
    }

    private RequirementCheck EvaluateNavigation()
    {
        string[] destinations =
        {
            "projects",
            "skills",
            "contact"
        };

        string[] missingLinks =
            destinations
                .Where(
                    id => !HasInPageLink(
                        HtmlCode,
                        id))
                .ToArray();

        string[] missingTargets =
            destinations
                .Where(
                    id => !HasId(
                        HtmlCode,
                        id))
                .ToArray();

        bool primaryAction =
            HasInPageLink(
                HtmlCode,
                "projects",
                "primary-button");

        bool passed =
            missingLinks.Length == 0 &&
            missingTargets.Length == 0 &&
            primaryAction;

        return new(
            passed,
            passed
                ? "Projects, Skills, Contact, and the primary action point to valid IDs."
                : $"Missing links: {JoinOrNone(missingLinks)}. Missing targets: {JoinOrNone(missingTargets)}. Primary action must link to #projects.");
    }

    private RequirementCheck EvaluateImageAlternative()
    {
        Match image = Regex.Match(
            HtmlCode ?? "",
            @"<img\b[^>]*\balt\s*=\s*(?<quote>[""'])(?<alt>.*?)\k<quote>",
            RegexOptions.IgnoreCase |
            RegexOptions.Singleline);

        string alt =
            image.Success
                ? image.Groups["alt"].Value.Trim()
                : "";

        bool useful =
            alt.Length >= 12 &&
            !Regex.IsMatch(
                alt,
                @"^(image|photo|picture|img|workshop-preview\.png)$",
                RegexOptions.IgnoreCase);

        return new(
            useful,
            useful
                ? $"Image alternative text is meaningful: “{alt}”"
                : "Add non-empty, descriptive alt text of at least 12 characters.");
    }

    private RequirementCheck EvaluateWideLayoutAndContrast()
    {
        string css = StripCssComments(CssCode);

        bool headerFlex =
            RuleContains(
                css,
                ".site-header",
                @"display\s*:\s*flex");

        bool heroGrid =
            RuleContains(
                css,
                ".hero",
                @"display\s*:\s*grid") &&
            RuleContains(
                css,
                ".hero",
                @"grid-template-columns\s*:\s*(?!1fr\s*;)");

        bool projectGrid =
            RuleContains(
                css,
                ".project-list",
                @"display\s*:\s*grid") &&
            (
                RuleContains(
                    css,
                    ".project-list",
                    @"grid-template-columns\s*:\s*repeat\s*\(\s*3")
                ||
                RuleContains(
                    css,
                    ".project-list",
                    @"grid-template-columns\s*:\s*(?:minmax\([^;]+\)\s+){2}")
                ||
                RuleContains(
                    css,
                    ".project-list",
                    @"grid-template-columns\s*:\s*1fr\s+1fr\s+1fr")
            );

        bool contrast =
            HasReadablePrimaryButton(css);

        bool passed =
            headerFlex &&
            heroGrid &&
            projectGrid &&
            contrast;

        return new(
            passed,
            passed
                ? "Header, hero, three-card grid, and primary-button contrast pass."
                : $"Header flex: {PassWord(headerFlex)}; hero columns: {PassWord(heroGrid)}; three-card grid: {PassWord(projectGrid)}; button contrast: {PassWord(contrast)}.");
    }

    private RequirementCheck EvaluateFocusVisibility()
    {
        string css = StripCssComments(CssCode);
        int focusIndex = css.IndexOf(
            ":focus-visible",
            StringComparison.OrdinalIgnoreCase);

        bool focusRule =
            focusIndex >= 0;

        bool visibleOutline =
            focusRule &&
            Regex.IsMatch(
                css[focusIndex..],
                @"outline\s*:\s*(?!none|0)[^;}{]+",
                RegexOptions.IgnoreCase);

        bool passed =
            focusRule &&
            visibleOutline;

        return new(
            passed,
            passed
                ? "A visible :focus-visible outline is defined."
                : "Add a :focus-visible selector with a nonzero outline.");
    }

    private RequirementCheck EvaluateResponsiveBehavior()
    {
        string css = StripCssComments(CssCode);

        Match media = Regex.Match(
            css,
            @"@media\s*\(\s*max-width\s*:\s*(?<width>\d+)px\s*\)",
            RegexOptions.IgnoreCase);

        int width =
            media.Success
                ? int.Parse(
                    media.Groups["width"].Value)
                : int.MaxValue;

        string responsiveCss =
            media.Success
                ? css[media.Index..]
                : "";

        bool breakpoint =
            media.Success &&
            width >= 480 &&
            width <= 820;

        bool stacksHeader =
            Regex.IsMatch(
                responsiveCss,
                @"\.site-header[\s\S]*?flex-direction\s*:\s*column",
                RegexOptions.IgnoreCase);

        bool stacksGrids =
            responsiveCss.Contains(
                ".hero",
                StringComparison.OrdinalIgnoreCase) &&
            responsiveCss.Contains(
                ".project-list",
                StringComparison.OrdinalIgnoreCase) &&
            Regex.IsMatch(
                responsiveCss,
                @"grid-template-columns\s*:\s*1fr",
                RegexOptions.IgnoreCase);

        bool fixedBodyWidth =
            RuleContains(
                css,
                "body",
                @"width\s*:\s*(?:[8-9]\d{2}|[1-9]\d{3,})px");

        bool passed =
            breakpoint &&
            stacksHeader &&
            stacksGrids &&
            !fixedBodyWidth;

        return new(
            passed,
            passed
                ? $"Responsive breakpoint at {width}px stacks the header, hero, and cards."
                : $"Breakpoint: {PassWord(breakpoint)}; header stack: {PassWord(stacksHeader)}; hero/card stack: {PassWord(stacksGrids)}; fixed body width removed: {PassWord(!fixedBodyWidth)}.");
    }

    private static bool HasTag(
        string html,
        string tag) =>
        Regex.IsMatch(
            html ?? "",
            $@"<\s*{Regex.Escape(tag)}\b",
            RegexOptions.IgnoreCase);

    private static int CountTags(
        string html,
        string tag) =>
        Regex.Matches(
            html ?? "",
            $@"<\s*{Regex.Escape(tag)}\b",
            RegexOptions.IgnoreCase)
            .Count;

    private static bool HasId(
        string html,
        string id) =>
        Regex.IsMatch(
            html ?? "",
            $@"\bid\s*=\s*[""']{Regex.Escape(id)}[""']",
            RegexOptions.IgnoreCase);

    private static bool HasInPageLink(
        string html,
        string id,
        string? requiredClass = null)
    {
        string classRequirement =
            string.IsNullOrWhiteSpace(
                requiredClass)
                ? ""
                : $@"(?=[^>]*\bclass\s*=\s*[""'][^""']*\b{Regex.Escape(requiredClass)}\b[^""']*[""'])";

        return Regex.IsMatch(
            html ?? "",
            $@"<a\b{classRequirement}[^>]*\bhref\s*=\s*[""']#{Regex.Escape(id)}[""']",
            RegexOptions.IgnoreCase);
    }

    private static string StripCssComments(
        string css) =>
        Regex.Replace(
            css ?? "",
            @"/\*.*?\*/",
            "",
            RegexOptions.Singleline);

    private static bool RuleContains(
        string css,
        string selector,
        string declarationPattern)
    {
        MatchCollection rules = Regex.Matches(
            css ?? "",
            @"(?<selectors>[^{}]+)\{(?<body>[^{}]*)\}",
            RegexOptions.Singleline);

        foreach (Match rule in rules)
        {
            string selectors =
                rule.Groups["selectors"].Value;

            if (
                selectors.IndexOf(
                    selector,
                    StringComparison.OrdinalIgnoreCase) < 0)
            {
                continue;
            }

            if (
                Regex.IsMatch(
                    rule.Groups["body"].Value,
                    declarationPattern,
                    RegexOptions.IgnoreCase |
                    RegexOptions.Singleline))
            {
                return true;
            }
        }

        return false;
    }

    private static bool HasReadablePrimaryButton(
        string css)
    {
        MatchCollection rules = Regex.Matches(
            css ?? "",
            @"(?<selectors>[^{}]+)\{(?<body>[^{}]*)\}",
            RegexOptions.Singleline);

        foreach (Match rule in rules)
        {
            if (
                rule.Groups["selectors"].Value.IndexOf(
                    ".primary-button",
                    StringComparison.OrdinalIgnoreCase) < 0)
            {
                continue;
            }

            string body =
                rule.Groups["body"].Value;

            string foreground =
                DeclarationValue(
                    body,
                    "color");

            string background =
                DeclarationValue(
                    body,
                    "background-color");

            if (string.IsNullOrWhiteSpace(background))
            {
                background =
                    DeclarationValue(
                        body,
                        "background");
            }

            if (
                TryParseCssColor(
                    foreground,
                    out double foregroundLuminance)
                &&
                TryParseCssColor(
                    background,
                    out double backgroundLuminance))
            {
                double light =
                    Math.Max(
                        foregroundLuminance,
                        backgroundLuminance);

                double dark =
                    Math.Min(
                        foregroundLuminance,
                        backgroundLuminance);

                double ratio =
                    (light + .05) /
                    (dark + .05);

                return ratio >= 4.5;
            }
        }

        return false;
    }

    private static string DeclarationValue(
        string body,
        string property)
    {
        Match match = Regex.Match(
            body ?? "",
            $@"(?:^|;)\s*{Regex.Escape(property)}\s*:\s*(?<value>[^;]+)",
            RegexOptions.IgnoreCase);

        return match.Success
            ? match.Groups["value"].Value.Trim()
            : "";
    }

    private static bool TryParseCssColor(
        string value,
        out double luminance)
    {
        luminance = 0;
        string color =
            (value ?? "")
                .Trim()
                .ToLowerInvariant();

        color = color switch
        {
            "white" => "#ffffff",
            "black" => "#000000",
            "navy" => "#000080",
            _ => color
        };

        Match hex = Regex.Match(
            color,
            @"^#(?<hex>[0-9a-f]{3}|[0-9a-f]{6})$",
            RegexOptions.IgnoreCase);

        if (!hex.Success)
        {
            return false;
        }

        string digits =
            hex.Groups["hex"].Value;

        if (digits.Length == 3)
        {
            digits = string.Concat(
                digits.Select(
                    character =>
                        new string(
                            character,
                            2)));
        }

        int red =
            Convert.ToInt32(
                digits[..2],
                16);

        int green =
            Convert.ToInt32(
                digits.Substring(
                    2,
                    2),
                16);

        int blue =
            Convert.ToInt32(
                digits.Substring(
                    4,
                    2),
                16);

        static double Channel(int component)
        {
            double value =
                component / 255d;

            return value <= .03928
                ? value / 12.92
                : Math.Pow(
                    (value + .055) /
                    1.055,
                    2.4);
        }

        luminance =
            .2126 * Channel(red) +
            .7152 * Channel(green) +
            .0722 * Channel(blue);

        return true;
    }

    private string ProfileButtonClass(
        DamageProfile profile) =>
        profile == CurrentProfile
            ? "rescue-profile-button active"
            : "rescue-profile-button";

    private static string ProfileLabel(
        DamageProfile profile) =>
        profile switch
        {
            DamageProfile.HtmlSystems =>
                "HTML systems",
            DamageProfile.CssSystems =>
                "CSS systems",
            _ =>
                "Full Incident"
        };

    private static string ProfileDescription(
        DamageProfile profile) =>
        profile switch
        {
            DamageProfile.HtmlSystems =>
                "Layout support remains while semantic and accessibility failures are isolated.",
            DamageProfile.CssSystems =>
                "Semantic HTML remains while layout, contrast, focus, and responsive CSS fail.",
            _ =>
                "HTML structure, accessibility, layout, and responsive behavior are all damaged."
        };

    private string ViewportButtonClass(
        PreviewViewport viewport) =>
        viewport == CurrentViewport
            ? "rescue-viewport-button active"
            : "rescue-viewport-button";

    private static string ViewportLabel(
        PreviewViewport viewport) =>
        viewport switch
        {
            PreviewViewport.Tablet => "Tablet",
            PreviewViewport.Mobile => "Mobile",
            _ => "Desktop"
        };

    private static int CountLines(string value) =>
        string.IsNullOrEmpty(value)
            ? 0
            : value.Count(character => character == '\n') + 1;

    private static int CountValidatedLines(
        string value) =>
        string.IsNullOrWhiteSpace(value)
            ? 0
            : value
                .Replace("\r\n", "\n")
                .Split('\n')
                .Count(line =>
                    !string.IsNullOrWhiteSpace(line));

    private static string FormatSeconds(
        double seconds)
    {
        TimeSpan value =
            TimeSpan.FromSeconds(
                Math.Max(0, seconds));

        return $"{(int)value.TotalMinutes:00}:{value.Seconds:00}";
    }

    private static string JoinOrNone(
        IEnumerable<string> values)
    {
        string[] items = values.ToArray();

        return items.Length == 0
            ? "none"
            : string.Join(", ", items);
    }

    private static string PassWord(
        bool passed) =>
        passed
            ? "pass"
            : "needs repair";

    private string BuildPreviewDocument()
    {
        string safeHtml = SanitizeHtml(HtmlCode);
        string safeCss = SanitizeCss(CssCode);

        return $"""
            <!DOCTYPE html>
            <html lang="en">
            <head>
                <meta charset="UTF-8">
                <meta name="viewport"
                      content="width=device-width, initial-scale=1.0">
                <title>Interface Rescue Preview</title>
                <style>
                    {safeCss}
                </style>
            </head>
            <body>
                {safeHtml}
            </body>
            </html>
            """;
    }

    private static string SanitizeHtml(string value)
    {
        string result = Regex.Replace(
            value ?? "",
            @"<script\b[^>]*>.*?</script\s*>",
            "",
            RegexOptions.IgnoreCase |
            RegexOptions.Singleline);

        result = Regex.Replace(
            result,
            @"\son[a-z0-9_-]+\s*=\s*(""[^""]*""|'[^']*')",
            "",
            RegexOptions.IgnoreCase);

        result = Regex.Replace(
            result,
            @"\son[a-z0-9_-]+\s*=\s*[^\s>]+",
            "",
            RegexOptions.IgnoreCase);

        result = Regex.Replace(
            result,
            @"javascript\s*:",
            "",
            RegexOptions.IgnoreCase);

        result = Regex.Replace(
            result,
            @"\s(?:src|href)\s*=\s*""\s*(?:https?:)?//[^""]*""",
            "",
            RegexOptions.IgnoreCase);

        result = Regex.Replace(
            result,
            @"\s(?:src|href)\s*=\s*'\s*(?:https?:)?//[^']*'",
            "",
            RegexOptions.IgnoreCase);

        result = Regex.Replace(
            result,
            @"\s(?:src|href)\s*=\s*(?:https?:)?//[^\s>]+",
            "",
            RegexOptions.IgnoreCase);

        return result;
    }

    private static string SanitizeCss(string value)
    {
        string result = Regex.Replace(
            value ?? "",
            @"</?style\b[^>]*>",
            "",
            RegexOptions.IgnoreCase);

        result = Regex.Replace(
            result,
            @"@import[^;]+;",
            "",
            RegexOptions.IgnoreCase);

        result = Regex.Replace(
            result,
            @"url\s*\([^)]*\)",
            "none",
            RegexOptions.IgnoreCase);

        return result;
    }

    public async ValueTask DisposeAsync()
    {
        StopClock();

        if (TimerTask is not null)
        {
            try
            {
                await TimerTask;
            }
            catch (OperationCanceledException)
            {
                // Normal disposal path.
            }
        }
    }
