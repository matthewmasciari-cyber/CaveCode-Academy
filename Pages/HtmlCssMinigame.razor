@page "/minigames/html-css"
@implements IAsyncDisposable
@using System.Text.RegularExpressions
@using Microsoft.JSInterop
@using CaveCode.CourseEngine
@inject CourseEngineService CourseEngine
@inject ProgressionService ProgressionService
@inject AchievementService AchievementService
@inject IJSRuntime JS

<PageTitle>Interface Rescue · CaveCode Academy</PageTitle>

@if (!AccessReady)
{
    <div class="rescue-access-screen">
        <section>
            <span>&lt;/&gt;</span>
            <h1>Loading Interface Rescue</h1>
            <p>Checking your HTML & CSS Chapter 1 checkpoint and saved mission records.</p>
        </section>
    </div>
}
else if (!string.IsNullOrWhiteSpace(AccessError))
{
    <div class="rescue-access-screen">
        <section class="locked">
            <span>!</span>
            <p class="rescue-eyebrow">INTERFACE RESCUE · LOCAL CHECKPOINT ERROR</p>
            <h1>Mission access could not be verified</h1>
            <p>@AccessError</p>
            <NavLink class="rescue-access-secondary" href="/minigames">
                Return to Minigame Hub
            </NavLink>
        </section>
    </div>
}
else if (!ChapterOneUnlocked)
{
    <div class="rescue-access-screen">
        <section class="locked">
            <span>🔒</span>
            <p class="rescue-eyebrow">HTML & CSS WORKSHOP · CHAPTER GATE</p>
            <h1>Complete Chapter 1 to unlock</h1>
            <p>
                Interface Rescue uses the semantic HTML skills taught in Modules 1–8.
                Your current checkpoint shows @ChapterOneCompletedModules of 8 modules complete.
            </p>
            <NavLink class="rescue-access-action" href="/html-css">
                Continue HTML & CSS Chapter 1 →
            </NavLink>
            <NavLink class="rescue-access-secondary" href="/minigames">
                Return to Minigame Hub
            </NavLink>
        </section>
    </div>
}
else
{
<div class="interface-rescue-shell">
    <header class="rescue-header">
        <div class="rescue-header-copy">
            <NavLink class="rescue-back" href="/minigames">
                ← Minigame Hub
            </NavLink>

            @* CAVECODE_INTERFACE_RESCUE_MISSION_NAV_V1 *@
            <div class="rescue-profile-grid rescue-mission-nav" aria-label="Interface Rescue missions">
                <NavLink class="rescue-profile-button active" href="/minigames/html-css">
                    <strong>Mission 1</strong>
                    <small>Workshop Landing Page</small>
                </NavLink>
                <NavLink class="rescue-profile-button" href="/minigames/html-css/mission-2">
                    <strong>Mission 2</strong>
                    <small>Project Card Grid</small>
                </NavLink>
                @* CAVECODE_INTERFACE_RESCUE_MISSION_NAV_V2 *@
                <NavLink class="rescue-profile-button" href="/minigames/html-css/mission-3">
                    <strong>Mission 3</strong>
                    <small>Mobile Navigation</small>
                </NavLink>
            </div>
            <p class="rescue-eyebrow">HTML & CSS WORKSHOP · PASS 6D · MISSION 1</p>
            <h1>Interface Rescue</h1>
            <p>
                Restore all six requirements, test the result across desktop,
                tablet, and mobile widths, and submit the final repair. Completed
                runs now save your best score and fastest clear while awarding
                HTML/CSS XP, validated lines, Code Crystals, and the Interface
                Restored achievement.
            </p>
        </div>

        <div class="rescue-session-panel">
            <span class="rescue-session-state">
                @SessionStateLabel
            </span>
            <strong>@TimeDisplay</strong>
            <small>
                Chapter access, persistent records, rewards, and achievement
                integration are active.
            </small>
        </div>
    </header>

    <main class="rescue-layout">
        <aside class="rescue-briefing">
            <section class="rescue-panel">
                <div class="rescue-panel-heading">
                    <div>
                        <span>MISSION BRIEF</span>
                        <h2>Restore the Workshop Landing Page</h2>
                    </div>
                    <span class="rescue-shell-badge">MISSION 1</span>
                </div>

                <p>
                    A rushed deployment damaged the Workshop landing page.
                    Restore the intended structure and presentation without
                    replacing the project with an unrelated design.
                </p>

                <div class="rescue-incident-report">
                    <strong>INCIDENT REPORT</strong>
                    <ul>
                        @foreach (string symptom in ActiveSymptoms)
                        {
                            <li>@symptom</li>
                        }
                    </ul>
                </div>

                <div class="rescue-objective-list">
                    @for (int index = 0; index < Requirements.Length; index++)
                    {
                        RequirementCheck check = EvaluateRequirement(index);

                        <div class="rescue-objective @(check.Passed ? "passed" : "pending")">
                            <span>@(check.Passed ? "✓" : (index + 1).ToString())</span>
                            <div>
                                <strong>@Requirements[index].Title</strong>
                                <small>@Requirements[index].Detail</small>
                                <em>@check.Evidence</em>
                            </div>
                        </div>
                    }
                </div>
            </section>

            <section class="rescue-panel rescue-score-panel">
                <div class="rescue-panel-heading">
                    <div>
                        <span>LIVE RUN STATUS</span>
                        <h2>Scoreboard</h2>
                    </div>
                    <span class="rescue-shell-badge @ResultBadgeClass">
                        @ResultBadgeLabel
                    </span>
                </div>

                <div class="rescue-score-grid">
                    <div>
                        <span>@(AttemptSubmitted ? "Final score" : "Projected score")</span>
                        <strong>@DisplayedScore / 1000</strong>
                    </div>
                    <div>
                        <span>Repair goals</span>
                        <strong>@PassedRequirementCount / @Requirements.Length</strong>
                    </div>
                    <div>
                        <span>Time bonus</span>
                        <strong>+@DisplayedTimeBonus</strong>
                    </div>
                    <div>
                        <span>Hint penalty</span>
                        <strong>-@DisplayedHintPenalty</strong>
                    </div>
                </div>

                <div class="rescue-score-breakdown">
                    <div>
                        <span>Requirement points</span>
                        <strong>@DisplayedRequirementPoints / 840</strong>
                    </div>
                    <div>
                        <span>Scored time</span>
                        <strong>@TimeDisplay</strong>
                    </div>
                    <div>
                        <span>Hints revealed</span>
                        <strong>@HintsUsed / @Hints.Length</strong>
                    </div>
                </div>

                <p class="rescue-score-note">
                    Each completed repair requirement is worth 140 points.
                    The time bonus begins at 160 points and decreases during
                    the run. Every hint subtracts 40 points. All six repairs
                    must pass for mission completion.
                </p>

                @if (AttemptSubmitted)
                {
                    <div class="rescue-result @ResultPanelClass">
                        <span>@(RunPassed ? "MISSION PASSED" : "MISSION FAILED")</span>
                        <strong>@SubmissionMessage</strong>
                        <p>
                            @(RunPassed
                                ? "The landing page satisfies every automated repair requirement."
                                : "Start a new attempt and use the live requirement evidence to finish the remaining repairs.")
                        </p>
                    </div>
                }
            </section>

            <section class="rescue-panel rescue-reward-panel">
                <div class="rescue-panel-heading">
                    <div>
                        <span>PERSISTENT MISSION RECORD</span>
                        <h2>Interface Rescue rewards</h2>
                    </div>
                    <span class="rescue-shell-badge">
                        @(MinigameState.Mission1Completed ? "CLEARED" : "ACTIVE")
                    </span>
                </div>

                <div class="rescue-record-grid">
                    <div>
                        <span>Best score</span>
                        <strong>@MinigameState.BestScore.ToString("N0")</strong>
                    </div>
                    <div>
                        <span>Fastest clear</span>
                        <strong>@FastestClearDisplay</strong>
                    </div>
                    <div>
                        <span>Total clears</span>
                        <strong>@MinigameState.TotalClears</strong>
                    </div>
                    <div>
                        <span>Minigame XP</span>
                        <strong>@MinigameState.TotalXpEarned.ToString("N0")</strong>
                    </div>
                    <div>
                        <span>Crystals earned</span>
                        <strong>◆ @MinigameState.TotalCrystalsEarned</strong>
                    </div>
                    <div>
                        <span>Achievement</span>
                        <strong>
                            @(MinigameState.Mission1Completed
                                ? "Interface Restored"
                                : "Not yet earned")
                        </strong>
                    </div>
                </div>

                <p class="rescue-score-note">
                    First completion unlocks the Interface Restored achievement.
                    Claim it from Achievements to equip the Interface Rescuer title.
                </p>

                <div class="rescue-reward-rules">
                    <div>
                        <span>FIRST CLEAR</span>
                        <strong>100 XP · ◆ 6 crystals</strong>
                    </div>
                    <div>
                        <span>REPEAT CLEAR</span>
                        <strong>40 XP · ◆ 2 crystals</strong>
                    </div>
                    <div>
                        <span>VALIDATED LINES</span>
                        <strong>HTML + CSS submitted</strong>
                    </div>
                </div>

                @if (RewardProcessing)
                {
                    <p class="rescue-reward-message">
                        Saving the mission record and applying rewards…
                    </p>
                }
                else if (!string.IsNullOrWhiteSpace(RewardMessage))
                {
                    <div class="rescue-reward-result">
                        <strong>@RewardMessage</strong>

                        @if (RunPassed && !RewardsProcessed)
                        {
                            <button type="button"
                                    class="rescue-secondary"
                                    @onclick="ProcessRewardsAsync">
                                Retry reward save
                            </button>
                        }

                        @if (MinigameAchievement is not null &&
                             MinigameAchievement.NewlyUnlocked)
                        {
                            <p>
                                Achievement unlocked:
                                <strong>@MinigameAchievement.Name</strong>.
                                Claim the <strong>@MinigameAchievement.TitleReward</strong>
                                title from Achievements.
                            </p>
                            <NavLink href="/achievements">
                                View achievement →
                            </NavLink>
                        }
                    </div>
                }
            </section>

            <section class="rescue-panel">
                <div class="rescue-panel-heading">
                    <div>
                        <span>DAMAGE PROFILE</span>
                        <h2>Choose the incident</h2>
                    </div>
                    <span class="rescue-profile-badge">@ActiveProfileLabel</span>
                </div>

                <p>
                    Each profile starts from the same intended landing page but
                    emphasizes a different type of failure.
                </p>

                <div class="rescue-profile-grid">
                    @foreach (DamageProfile profile in Enum.GetValues<DamageProfile>())
                    {
                        <button type="button"
                                class="@ProfileButtonClass(profile)"
                                disabled="@AttemptSubmitted"
                                @onclick="() => LoadDamageProfile(profile)">
                            <strong>@ProfileLabel(profile)</strong>
                            <small>@ProfileDescription(profile)</small>
                        </button>
                    }
                </div>
            </section>

            <section class="rescue-panel">
                <div class="rescue-panel-heading">
                    <div>
                        <span>TOOLS</span>
                        <h2>Session controls</h2>
                    </div>
                </div>

                <div class="rescue-control-stack">
                    <button type="button"
                            class="rescue-primary"
                            disabled="@(AttemptStarted || AttemptSubmitted)"
                            @onclick="StartScoredRun">
                        @(AttemptStarted ? "Timer running" : "Start scored run")
                    </button>

                    <button type="button"
                            class="rescue-secondary"
                            disabled="@AttemptSubmitted"
                            @onclick="RevealHint">
                        Show a hint (-40)
                    </button>

                    <button type="button"
                            class="rescue-submit"
                            disabled="@AttemptSubmitted"
                            @onclick="SubmitRepairAsync">
                        Submit final repair
                    </button>

                    <button type="button"
                            class="rescue-secondary"
                            @onclick="ResetWorkspace">
                        @(AttemptSubmitted ? "Start new attempt" : "Reset damaged page")
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(CurrentHint))
                {
                    <div class="rescue-hint">
                        <span>HINT @HintsUsed</span>
                        <p>@CurrentHint</p>
                    </div>
                }
            </section>
        </aside>

        <section class="rescue-workspace">
            <div class="rescue-workspace-heading">
                <div>
                    <p class="rescue-eyebrow">REPAIR WORKSPACE</p>
                    <h2>Mission 1 repair workspace</h2>
                </div>

                <div class="rescue-editor-stats">
                    <span>@HtmlLineCount HTML lines</span>
                    <span>@CssLineCount CSS lines</span>
                    <span>@ActiveProfileLabel</span>
                    <span>Live rendering</span>
                </div>
            </div>

            <div class="rescue-editor-grid">
                <section class="rescue-editor">
                    <div class="rescue-editor-bar">
                        <span>index.html</span>
                        <span>HTML</span>
                    </div>
                    <textarea aria-label="Interface Rescue HTML editor"
                              spellcheck="false"
                              disabled="@AttemptSubmitted"
                              value="@HtmlCode"
                              @oninput="UpdateHtml"></textarea>
                </section>

                <section class="rescue-editor">
                    <div class="rescue-editor-bar">
                        <span>styles.css</span>
                        <span>CSS</span>
                    </div>
                    <textarea aria-label="Interface Rescue CSS editor"
                              spellcheck="false"
                              disabled="@AttemptSubmitted"
                              value="@CssCode"
                              @oninput="UpdateCss"></textarea>
                </section>
            </div>

            <div class="rescue-security-note">
                <strong>Sandbox active</strong>
                <span>
                    Scripts, inline event handlers, CSS imports, and external
                    URL requests are removed before rendering.
                </span>
            </div>
        </section>

        <aside class="rescue-preview-column">
            <div class="rescue-preview-heading">
                <div>
                    <p class="rescue-eyebrow">LIVE BROWSER</p>
                    <h2>Workshop preview</h2>
                </div>
                <span class="rescue-live-indicator">LIVE</span>
            </div>

            <div class="rescue-viewport-controls"
                 aria-label="Preview viewport">
                @foreach (PreviewViewport viewport in Enum.GetValues<PreviewViewport>())
                {
                    <button type="button"
                            class="@ViewportButtonClass(viewport)"
                            @onclick="() => SetViewport(viewport)">
                        @ViewportLabel(viewport)
                    </button>
                }
            </div>

            <div class="rescue-browser">
                <div class="rescue-browser-bar">
                    <span class="rescue-browser-dots">
                        <i></i><i></i><i></i>
                    </span>
                    <span>interface-rescue.local</span>
                </div>

                <iframe @key="PreviewRevision"
                        class="@PreviewFrameClass"
                        title="Interface Rescue sandboxed preview"
                        sandbox=""
                        srcdoc="@PreviewDocument">
                </iframe>
            </div>

            <section class="rescue-blueprint">
                <div>
                    <span>TARGET BLUEPRINT</span>
                    <strong>What the repaired page should communicate</strong>
                </div>
                <ul>
                    <li>Wide screens show a horizontal header and two-column hero.</li>
                    <li>Three project cards share one balanced grid row.</li>
                    <li>Links and the primary action have visible keyboard focus.</li>
                    <li>The project image has meaningful alternative text.</li>
                    <li>Narrow screens collapse cleanly without horizontal overflow.</li>
                </ul>
            </section>

            <section class="rescue-console">
                <div>
                    <span>INTERFACE RESCUE CONSOLE</span>
                    <span>READ ONLY</span>
                </div>
                <p>[MODE] Pass 6D · Mission 1 persistent reward challenge</p>
                <p>[PREVIEW] HTML and CSS render while you type</p>
                <p>[VALIDATION] @PassedRequirementCount of @Requirements.Length requirements currently pass</p>
                <p>[SCORE] @DisplayedScore projected or final points</p>
                <p>[REWARDS] XP, validated lines, crystals, records, and achievement enabled</p>
                <p>[SECURITY] iframe sandbox active</p>
            </section>
        </aside>
    </main>
</div>

<style>
    .interface-rescue-shell {
        min-height: 100vh;
        padding: 28px clamp(14px, 3vw, 42px) 54px;
        color: var(--text);
        background:
            radial-gradient(
                circle at 82% 0%,
                var(--accent-surface),
                transparent 31%
            ),
            var(--bg);
        font-family: Inter, system-ui, sans-serif;
    }

    .interface-rescue-shell * {
        box-sizing: border-box;
    }

    .interface-rescue-shell button,
    .interface-rescue-shell textarea {
        font: inherit;
    }

    .rescue-header {
        display: grid;
        width: min(1580px, 100%);
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: start;
        gap: 24px;
        margin: 0 auto 22px;
    }

    .rescue-back {
        display: inline-flex;
        padding: 9px 12px;
        margin-bottom: 24px;
        color: var(--text);
        text-decoration: none;
        background: var(--surface-raised);
        border: 1px solid var(--border);
        border-radius: 9px;
        font-size: 11px;
        font-weight: 900;
    }

    .rescue-eyebrow {
        margin: 0 0 7px;
        color: var(--accent);
        font-size: 10px;
        font-weight: 950;
        letter-spacing: 1.15px;
    }

    .rescue-header h1 {
        margin: 0;
        font-size: clamp(40px, 5vw, 70px);
        letter-spacing: -2px;
        line-height: .96;
    }

    .rescue-header-copy > p:last-child {
        max-width: 800px;
        margin: 18px 0 0;
        color: var(--text-muted);
        line-height: 1.65;
    }

    .rescue-session-panel {
        display: grid;
        min-width: 240px;
        gap: 6px;
        padding: 17px;
        color: var(--text);
        background: var(--surface);
        border: 1px solid var(--accent-border);
        border-radius: 14px;
        box-shadow: 0 18px 65px var(--shadow);
    }

    .rescue-session-state {
        color: var(--accent);
        font-size: 9px;
        font-weight: 950;
        letter-spacing: .9px;
    }

    .rescue-session-panel strong {
        font: 900 30px Consolas, Monaco, monospace;
    }

    .rescue-session-panel small {
        color: var(--text-muted);
        line-height: 1.45;
    }

    .rescue-layout {
        display: grid;
        width: min(1580px, 100%);
        grid-template-columns: 300px minmax(480px, 1fr) minmax(360px, 470px);
        align-items: start;
        gap: 16px;
        margin: 0 auto;
    }

    .rescue-briefing {
        display: grid;
        gap: 14px;
    }

    .rescue-panel,
    .rescue-workspace,
    .rescue-preview-column {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 15px;
        box-shadow: 0 18px 65px var(--shadow);
    }

    .rescue-panel {
        padding: 18px;
    }

    .rescue-panel-heading,
    .rescue-workspace-heading,
    .rescue-preview-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
    }

    .rescue-panel-heading span:first-child {
        color: var(--accent);
        font-size: 8px;
        font-weight: 950;
        letter-spacing: .9px;
    }

    .rescue-panel h2,
    .rescue-workspace h2,
    .rescue-preview-column h2 {
        margin: 4px 0 0;
        font-size: 20px;
    }

    .rescue-panel > p {
        color: var(--text-muted);
        line-height: 1.55;
    }

    .rescue-shell-badge,
    .rescue-live-indicator {
        padding: 6px 8px;
        color: var(--accent);
        background: var(--accent-surface);
        border: 1px solid var(--accent-border);
        border-radius: 999px;
        font-size: 8px;
        font-weight: 950;
        letter-spacing: .7px;
    }

    .rescue-objective-list {
        display: grid;
        gap: 8px;
        margin-top: 14px;
    }

    .rescue-objective {
        display: grid;
        grid-template-columns: 29px 1fr;
        align-items: start;
        gap: 9px;
        padding: 9px;
        background: var(--surface-soft);
        border: 1px solid var(--border);
        border-radius: 9px;
    }

    .rescue-objective > span {
        display: grid;
        width: 29px;
        height: 29px;
        place-items: center;
        color: var(--text-muted);
        background: var(--surface-strong);
        border-radius: 7px;
        font-size: 9px;
        font-weight: 950;
    }

    .rescue-objective strong,
    .rescue-objective small {
        display: block;
    }

    .rescue-objective strong {
        font-size: 11px;
        line-height: 1.4;
    }

    .rescue-objective small {
        margin-top: 3px;
        color: var(--text-muted);
        font-size: 8px;
    }

    .rescue-score-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
        margin-top: 14px;
    }

    .rescue-score-grid div {
        padding: 10px;
        background: var(--surface-soft);
        border: 1px solid var(--border);
        border-radius: 9px;
    }

    .rescue-score-grid span,
    .rescue-score-grid strong {
        display: block;
    }

    .rescue-score-grid span {
        color: var(--text-muted);
        font-size: 8px;
        text-transform: uppercase;
    }

    .rescue-score-grid strong {
        margin-top: 4px;
        font-size: 13px;
    }

    .rescue-score-note {
        margin-bottom: 0;
        font-size: 10px;
    }

    .rescue-control-stack {
        display: grid;
        gap: 8px;
        margin-top: 14px;
    }

    .rescue-primary,
    .rescue-secondary {
        min-height: 42px;
        padding: 10px 12px;
        border-radius: 9px;
        cursor: pointer;
        font-size: 11px;
        font-weight: 900;
    }

    .rescue-primary {
        color: var(--accent-contrast);
        background: var(--accent);
        border: 1px solid var(--accent);
    }

    .rescue-secondary {
        color: var(--text);
        background: var(--surface-raised);
        border: 1px solid var(--border);
    }

    .rescue-hint {
        padding: 12px;
        margin-top: 12px;
        color: var(--warning-text);
        background: var(--warning-surface);
        border: 1px solid var(--warning-border);
        border-radius: 9px;
    }

    .rescue-hint span {
        color: var(--warning-accent);
        font-size: 8px;
        font-weight: 950;
        letter-spacing: .8px;
    }

    .rescue-hint p {
        margin: 5px 0 0;
        color: var(--warning-muted);
        font-size: 10px;
        line-height: 1.5;
    }

    .rescue-workspace,
    .rescue-preview-column {
        padding: 18px;
    }

    .rescue-editor-stats {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 6px;
    }

    .rescue-editor-stats span {
        padding: 6px 8px;
        color: var(--text-muted);
        background: var(--surface-soft);
        border: 1px solid var(--border);
        border-radius: 999px;
        font-size: 8px;
        font-weight: 850;
    }

    .rescue-editor-grid {
        display: grid;
        gap: 12px;
        margin-top: 15px;
    }

    .rescue-editor {
        overflow: hidden;
        background: var(--code-bg);
        border: 1px solid var(--border-strong);
        border-radius: 11px;
    }

    .rescue-editor-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 9px 12px;
        color: var(--dark-panel-muted);
        background: color-mix(
            in srgb,
            var(--code-bg) 78%,
            var(--surface) 22%
        );
        border-bottom: 1px solid var(--border-strong);
        font-size: 9px;
        font-weight: 900;
        letter-spacing: .65px;
    }

    .rescue-editor textarea {
        display: block;
        width: 100%;
        min-height: 300px;
        resize: vertical;
        padding: 16px;
        color: var(--code-text);
        background: var(--code-bg);
        border: 0;
        outline: 0;
        font: 14px/1.55 Consolas, Monaco, monospace;
        tab-size: 4;
    }

    .rescue-editor textarea:focus {
        box-shadow: inset 0 0 0 2px var(--accent);
    }

    .rescue-security-note {
