    private RequirementCheck[] EvaluateRequirements() =>
        Enumerable.Range(0, Requirements.Length)
            .Select(EvaluateRequirement)
            .ToArray();

    private RequirementCheck EvaluateRequirement(int index) => index switch
    {
        0 => EvaluateSemanticCards(),
        1 => EvaluateCardContent(),
        2 => EvaluateImageAlternatives(),
        3 => EvaluateDesktopGrid(),
        4 => EvaluateCardContainmentAndActions(),
        5 => EvaluateResponsiveGrid(),
        _ => new(false, "Unknown requirement.")
    };

    private RequirementCheck EvaluateSemanticCards()
    {
        bool section = HasTag(HtmlCode, "section") && HasId(HtmlCode, "projects");
        bool grid = HasClass(HtmlCode, "project-grid");
        int articles = CountTags(HtmlCode, "article");
        bool passed = section && grid && articles == 3;

        return new(
            passed,
            passed
                ? "Projects section, project-grid container, and three article cards are present."
                : $"Projects section: {PassWord(section)}; project-grid: {PassWord(grid)}; article cards: {articles} / 3.");
    }

    private RequirementCheck EvaluateCardContent()
    {
        MatchCollection articles = Regex.Matches(
            HtmlCode ?? "",
            @"<article\b[^>]*>(?<body>[\s\S]*?)</article>",
            RegexOptions.IgnoreCase);

        int complete = articles.Cast<Match>().Count(article =>
        {
            string body = article.Groups["body"].Value;
            return HasTag(body, "h2") &&
                   HasTag(body, "p") &&
                   HasAnchorClass(body, "card-action");
        });

        bool passed = articles.Count == 3 && complete == 3;

        return new(
            passed,
            passed
                ? "All three article cards contain a heading, description, and card action."
                : $"Complete card content: {complete} / 3 articles.");
    }

    private RequirementCheck EvaluateImageAlternatives()
    {
        MatchCollection images = Regex.Matches(
            HtmlCode ?? "",
            @"<img\b(?<attrs>[^>]*)>",
            RegexOptions.IgnoreCase);

        int meaningful = images.Cast<Match>().Count(image =>
        {
            Match alt = Regex.Match(
                image.Groups["attrs"].Value,
                @"\balt\s*=\s*[""'](?<value>[^""']+)[""']",
                RegexOptions.IgnoreCase);

            if (!alt.Success)
            {
                return false;
            }

            string value = alt.Groups["value"].Value.Trim().ToLowerInvariant();
            return value.Length >= 12 && value is not "image" and not "project image" and not "photo";
        });

        bool passed = images.Count == 3 && meaningful == 3;

        return new(
            passed,
            passed
                ? "All three project images have meaningful alternative text."
                : $"Meaningful image alternatives: {meaningful} / 3.");
    }

    private RequirementCheck EvaluateDesktopGrid()
    {
        string css = StripCssComments(CssCode);
        bool displayGrid = RuleContains(css, ".project-grid", @"display\s*:\s*grid");
        bool threeColumns = RuleContains(
            css,
            ".project-grid",
            @"grid-template-columns\s*:\s*(?:repeat\(\s*3\s*,\s*(?:minmax\([^;]+\)|1fr)\s*\)|(?:minmax\([^;]+\)|1fr)\s+(?:minmax\([^;]+\)|1fr)\s+(?:minmax\([^;]+\)|1fr))");
        bool gap = RuleContains(css, ".project-grid", @"(?:gap|column-gap)\s*:\s*(?!0(?:px|rem|em|%)?\b)[^;]+");
        bool passed = displayGrid && threeColumns && gap;

        return new(
            passed,
            passed
                ? "The wide project collection uses a three-column CSS Grid with spacing."
                : $"Grid display: {PassWord(displayGrid)}; three columns: {PassWord(threeColumns)}; gap: {PassWord(gap)}.");
    }

    private RequirementCheck EvaluateCardContainmentAndActions()
    {
        string css = StripCssComments(CssCode);
        bool cardLayout =
            RuleContains(css, ".project-card", @"display\s*:\s*(?:flex|grid)") &&
            (RuleContains(css, ".project-card", @"flex-direction\s*:\s*column") ||
             RuleContains(css, ".project-card", @"grid-template-rows\s*:"));
        bool overflow = RuleContains(css, ".project-card", @"overflow\s*:\s*hidden");
        bool imageWidth = RuleContains(css, ".project-card img", @"width\s*:\s*100%");
        bool objectFit = RuleContains(css, ".project-card img", @"object-fit\s*:\s*cover");
        bool readable = HasReadableAction(css);
        bool focus = Regex.IsMatch(css, @"\.card-action\s*:\s*focus-visible\s*\{[\s\S]*?outline\s*:\s*(?!none)[^;]+", RegexOptions.IgnoreCase);
        bool passed = cardLayout && overflow && imageWidth && objectFit && readable && focus;

        return new(
            passed,
            passed
                ? "Cards contain their images, keep a consistent column structure, and expose readable keyboard-focusable actions."
                : $"Card structure: {PassWord(cardLayout)}; overflow: {PassWord(overflow)}; image width: {PassWord(imageWidth)}; object fit: {PassWord(objectFit)}; action contrast: {PassWord(readable)}; focus: {PassWord(focus)}.");
    }

    private RequirementCheck EvaluateResponsiveGrid()
    {
        string css = StripCssComments(CssCode);
        Match media = Regex.Match(
            css,
            @"@media\s*\(\s*max-width\s*:\s*(?<width>\d+)px\s*\)\s*\{(?<body>[\s\S]*)$",
            RegexOptions.IgnoreCase);

        int width = media.Success ? int.Parse(media.Groups["width"].Value) : int.MaxValue;
        string body = media.Success ? media.Groups["body"].Value : "";
        bool breakpoint = media.Success && width >= 480 && width <= 820;
        bool oneColumn = Regex.IsMatch(
            body,
            @"\.project-grid[\s\S]*?grid-template-columns\s*:\s*1fr",
            RegexOptions.IgnoreCase);
        bool fixedBodyWidth = RuleContains(css, "body", @"width\s*:\s*(?:[8-9]\d{2}|[1-9]\d{3,})px");
        bool fixedGridWidth = RuleContains(css, ".project-grid", @"width\s*:\s*(?:[8-9]\d{2}|[1-9]\d{3,})px");
        bool passed = breakpoint && oneColumn && !fixedBodyWidth && !fixedGridWidth;

        return new(
            passed,
            passed
                ? $"A {width}px breakpoint stacks the project grid without fixed-width overflow."
                : $"Breakpoint: {PassWord(breakpoint)}; one-column grid: {PassWord(oneColumn)}; body width removed: {PassWord(!fixedBodyWidth)}; grid width removed: {PassWord(!fixedGridWidth)}.");
    }

    private string BuildPreviewDocument()
    {
        string html = SanitizeHtml(HtmlCode)
            .Replace("sensor-dashboard.svg", SensorImage, StringComparison.OrdinalIgnoreCase)
            .Replace("control-room.svg", ControlImage, StringComparison.OrdinalIgnoreCase)
            .Replace("project-grid.svg", GridImage, StringComparison.OrdinalIgnoreCase);
        string css = SanitizeCss(CssCode);

        return $"""
            <!DOCTYPE html>
            <html lang="en">
            <head>
                <meta charset="UTF-8">
                <meta name="viewport" content="width=device-width, initial-scale=1.0">
                <title>Project Grid Recovery</title>
                <style>{PreviewStyles}\n{css}</style>
            </head>
            <body>
                {html}
            </body>
            </html>
            """;
    }

    private static string SanitizeHtml(string html)
    {
        string value = html ?? "";
        value = Regex.Replace(value, @"<script\b[\s\S]*?</script\s*>", "", RegexOptions.IgnoreCase);
        value = Regex.Replace(value, @"\s+on[a-z]+\s*=\s*(?:""[^""]*""|'[^']*')", "", RegexOptions.IgnoreCase);
        value = Regex.Replace(value, @"javascript\s*:", "", RegexOptions.IgnoreCase);
        value = Regex.Replace(value, @"\s+(?:src|href)\s*=\s*[""']https?://[^""']*[""']", "", RegexOptions.IgnoreCase);
        return value;
    }

    private static string SanitizeCss(string css)
    {
        string value = css ?? "";
        value = Regex.Replace(value, @"@import[^;]+;", "", RegexOptions.IgnoreCase);
        value = Regex.Replace(value, @"url\s*\([^)]*\)", "none", RegexOptions.IgnoreCase);
        value = Regex.Replace(value, @"expression\s*\([^)]*\)", "", RegexOptions.IgnoreCase);
        return value;
    }

    private static bool HasTag(string html, string tag) =>
        Regex.IsMatch(html ?? "", $@"<\s*{Regex.Escape(tag)}\b", RegexOptions.IgnoreCase);

    private static int CountTags(string html, string tag) =>
        Regex.Matches(html ?? "", $@"<\s*{Regex.Escape(tag)}\b", RegexOptions.IgnoreCase).Count;

    private static bool HasId(string html, string id) =>
        Regex.IsMatch(html ?? "", $@"\bid\s*=\s*[""']{Regex.Escape(id)}[""']", RegexOptions.IgnoreCase);

    private static bool HasClass(string html, string className) =>
        Regex.IsMatch(html ?? "", $@"\bclass\s*=\s*[""'][^""']*\b{Regex.Escape(className)}\b[^""']*[""']", RegexOptions.IgnoreCase);

    private static bool HasAnchorClass(string html, string className) =>
        Regex.IsMatch(html ?? "", $@"<a\b[^>]*\bclass\s*=\s*[""'][^""']*\b{Regex.Escape(className)}\b[^""']*[""']", RegexOptions.IgnoreCase);

    private static string StripCssComments(string css) =>
        Regex.Replace(css ?? "", @"/\*.*?\*/", "", RegexOptions.Singleline);

    private static bool RuleContains(string css, string selector, string declarationPattern)
    {
        MatchCollection rules = Regex.Matches(
            css ?? "",
            @"(?<selectors>[^{}]+)\{(?<body>[^{}]*)\}",
            RegexOptions.Singleline);

        foreach (Match rule in rules)
        {
            if (rule.Groups["selectors"].Value.IndexOf(selector, StringComparison.OrdinalIgnoreCase) < 0)
            {
                continue;
            }

            if (Regex.IsMatch(rule.Groups["body"].Value, declarationPattern, RegexOptions.IgnoreCase | RegexOptions.Singleline))
            {
                return true;
            }
        }

        return false;
    }

    private static bool HasReadableAction(string css)
    {
        MatchCollection rules = Regex.Matches(
            css ?? "",
            @"(?<selectors>[^{}]+)\{(?<body>[^{}]*)\}",
            RegexOptions.Singleline);

        foreach (Match rule in rules)
        {
            if (rule.Groups["selectors"].Value.IndexOf(".card-action", StringComparison.OrdinalIgnoreCase) < 0)
            {
                continue;
            }

            string body = rule.Groups["body"].Value;
            string foreground = DeclarationValue(body, "color");
            string background = DeclarationValue(body, "background-color");

            if (string.IsNullOrWhiteSpace(background))
            {
                background = DeclarationValue(body, "background");
            }

            if (TryParseCssColor(foreground, out double foregroundLuminance) &&
                TryParseCssColor(background, out double backgroundLuminance))
            {
                double light = Math.Max(foregroundLuminance, backgroundLuminance);
                double dark = Math.Min(foregroundLuminance, backgroundLuminance);
                return (light + .05) / (dark + .05) >= 4.5;
            }
        }

        return false;
    }

    private static string DeclarationValue(string body, string property)
    {
        Match match = Regex.Match(
            body ?? "",
            $@"(?:^|;)\s*{Regex.Escape(property)}\s*:\s*(?<value>[^;]+)",
            RegexOptions.IgnoreCase);
        return match.Success ? match.Groups["value"].Value.Trim() : "";
    }

    private static bool TryParseCssColor(string value, out double luminance)
    {
        luminance = 0;
        string color = (value ?? "").Trim().ToLowerInvariant();
        color = color switch
        {
            "white" => "#ffffff",
            "black" => "#000000",
            "navy" => "#000080",
            _ => color
        };

        Match hex = Regex.Match(color, @"^#(?<hex>[0-9a-f]{3}|[0-9a-f]{6})$", RegexOptions.IgnoreCase);
        if (!hex.Success)
        {
            return false;
        }

        string digits = hex.Groups["hex"].Value;
        if (digits.Length == 3)
        {
            digits = string.Concat(digits.Select(character => new string(character, 2)));
        }

        int red = Convert.ToInt32(digits[..2], 16);
        int green = Convert.ToInt32(digits.Substring(2, 2), 16);
        int blue = Convert.ToInt32(digits.Substring(4, 2), 16);

        static double Channel(int component)
        {
            double componentValue = component / 255d;
            return componentValue <= .03928
                ? componentValue / 12.92
                : Math.Pow((componentValue + .055) / 1.055, 2.4);
        }

        luminance = .2126 * Channel(red) + .7152 * Channel(green) + .0722 * Channel(blue);
        return true;
    }

