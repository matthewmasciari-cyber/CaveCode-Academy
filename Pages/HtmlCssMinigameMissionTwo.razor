    private void StartScoredRun() => EnsureAttemptStarted();

    private void EnsureAttemptStarted()
    {
        if (AttemptStarted || AttemptSubmitted)
        {
            return;
        }

        AttemptStarted = true;
        AttemptStartedAt = DateTimeOffset.UtcNow;
        TimerCancellation = new CancellationTokenSource();
        TimerTask = RunClockAsync(TimerCancellation.Token);
    }

    private async Task RunClockAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));

            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void StopClock()
    {
        TimerCancellation?.Cancel();
        TimerCancellation?.Dispose();
        TimerCancellation = null;
    }

    private void RevealHint()
    {
        if (AttemptSubmitted)
        {
            return;
        }

        EnsureAttemptStarted();

        if (HintsUsed >= Hints.Length)
        {
            CurrentHint = "All six Mission 2 hints have already been revealed.";
            return;
        }

        CurrentHint = Hints[HintsUsed];
        HintsUsed++;
    }

    private async Task SubmitRepairAsync()
    {
        if (AttemptSubmitted)
        {
            return;
        }

        EnsureAttemptStarted();
        FinalElapsed = DateTimeOffset.UtcNow - AttemptStartedAt;

        RequirementCheck[] checks = EvaluateRequirements();
        FinalRequirementPoints = checks.Count(check => check.Passed) * RequirementPointsEach;
        FinalTimeBonus = Math.Max(0, MaximumTimeBonus - (int)(FinalElapsed.TotalSeconds / 3));
        FinalHintPenalty = Math.Min(Hints.Length, HintsUsed) * HintPenaltyEach;
        FinalScore = Math.Clamp(FinalRequirementPoints + FinalTimeBonus - FinalHintPenalty, 0, MaximumScore);
        RunPassed = checks.All(check => check.Passed);
        AttemptSubmitted = true;
        StopClock();

        int failed = checks.Count(check => !check.Passed);
        SubmissionMessage =
            RunPassed
                ? $"All six project-grid repairs passed with {FinalScore} points."
                : $"{failed} repair requirement{(failed == 1 ? "" : "s")} still need attention. Final score: {FinalScore}.";

        if (RunPassed)
        {
            await ProcessRewardsAsync();
        }
    }

    private async Task ProcessRewardsAsync()
    {
        if (RewardsProcessed || RewardProcessing)
        {
            return;
        }

        RewardProcessing = true;
        RewardMessage = "";

        try
        {
            HtmlCssMinigameRecordResult record =
                await JS.InvokeAsync<HtmlCssMinigameRecordResult>(
                    "caveCodeHtmlCssMinigame.recordMission2Clear",
                    AttemptId,
                    FinalScore,
                    Math.Max(0, FinalElapsed.TotalSeconds),
                    CurrentProfile.ToString());

            int validatedLines =
                CountValidatedLines(HtmlCode) +
                CountValidatedLines(CssCode);

            await ProgressionService.AwardMinigameRunAsync(
                CourseIds.HtmlCss,
                record.RewardKey,
                record.XpAwarded,
                validatedLines);

            await AchievementService.AwardMinigameCrystalsAsync(
                record.RewardKey,
                record.CrystalsAwarded);

            MinigameState = record.State;
            RewardsProcessed = true;

            string recordText =
                record.NewBestScore && record.NewFastestTime
                    ? " New Mission 2 best score and fastest clear."
                    : record.NewBestScore
                        ? " New Mission 2 best score."
                        : record.NewFastestTime
                            ? " New Mission 2 fastest clear."
                            : "";

            RewardMessage =
                $"+{record.XpAwarded} HTML/CSS XP, " +
                $"◆ {record.CrystalsAwarded} crystals, and " +
                $"{validatedLines} validated lines saved." +
                recordText;
        }
        catch (Exception error)
        {
            RewardMessage =
                "Mission 2 passed, but the local reward save did not finish: " +
                error.Message;
        }
        finally
        {
            RewardProcessing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

