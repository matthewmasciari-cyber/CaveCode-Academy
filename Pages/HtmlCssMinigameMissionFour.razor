    private RequirementCheck[] EvaluateRequirements() =>
        Enumerable.Range(0, Requirements.Length)
            .Select(EvaluateRequirement)
            .ToArray();

    private RequirementCheck EvaluateRequirement(int index) => index switch
    {
        0 => EvaluateSemanticForm(),
        1 => EvaluateLabelConnections(),
        2 => EvaluateFieldPurpose(),
        3 => EvaluateInstructionsAndStatus(),
        4 => EvaluateFormAccess(),
        5 => EvaluateResponsiveForm(),
        _ => new(false, "Unknown requirement.")
    };

    private RequirementCheck EvaluateSemanticForm()
    {
        string html = HtmlCode ?? "";
        bool section = Regex.IsMatch(
            html,
            @"<section\b[^>]*\bclass\s*=\s*[""'][^""']*\bcontact-card\b[^""']*[""'][^>]*\baria-labelledby\s*=\s*[""']contact-title[""']",
            RegexOptions.IgnoreCase);
        bool heading = Regex.IsMatch(
            html,
            @"<h1\b[^>]*\bid\s*=\s*[""']contact-title[""']",
            RegexOptions.IgnoreCase);
        bool form = Regex.IsMatch(
            html,
            @"<form\b[^>]*\bclass\s*=\s*[""'][^""']*\bcontact-form\b[^""']*[""']",
            RegexOptions.IgnoreCase);
        bool passed = section && heading && form;

        return new(
            passed,
            passed
                ? "A labeled contact section contains a clear heading and real form element."
                : $"Contact section: {PassWord(section)}; heading ID: {PassWord(heading)}; form element: {PassWord(form)}.");
    }

    private RequirementCheck EvaluateLabelConnections()
    {
        string html = HtmlCode ?? "";
        string[] ids = { "full-name", "email", "topic", "message" };
        int connected = ids.Count(id => HasLabelFor(html, id) && HasControlId(html, id));
        bool uniqueIds = ids.All(id => CountId(html, id) == 1);
        bool passed = connected == ids.Length && uniqueIds;

        return new(
            passed,
            passed
                ? "All four visible labels are connected to unique form-control IDs."
                : $"Connected labels: {connected} / {ids.Length}; unique control IDs: {PassWord(uniqueIds)}.");
    }

    private RequirementCheck EvaluateFieldPurpose()
    {
        string html = HtmlCode ?? "";
        string nameTag = OpeningTagWithId(html, "input", "full-name");
        string emailTag = OpeningTagWithId(html, "input", "email");
        string topicTag = OpeningTagWithId(html, "select", "topic");
        string messageTag = OpeningTagWithId(html, "textarea", "message");
        Match buttonMatch = Regex.Match(
            html,
            @"<button\b(?<attrs>[^>]*)>",
            RegexOptions.IgnoreCase);
        string buttonTag = buttonMatch.Success ? buttonMatch.Value : "";

        bool nameField =
            AttributeEquals(nameTag, "type", "text") &&
            AttributeEquals(nameTag, "autocomplete", "name") &&
            HasAttribute(nameTag, "name") &&
            HasAttribute(nameTag, "required");
        bool emailField =
            AttributeEquals(emailTag, "type", "email") &&
            AttributeEquals(emailTag, "autocomplete", "email") &&
            HasAttribute(emailTag, "name") &&
            HasAttribute(emailTag, "required");
        bool topicField =
            !string.IsNullOrWhiteSpace(topicTag) &&
            HasAttribute(topicTag, "name") &&
            HasAttribute(topicTag, "required");
        bool messageField =
            !string.IsNullOrWhiteSpace(messageTag) &&
            HasAttribute(messageTag, "name") &&
            HasAttribute(messageTag, "required");
        bool submitButton = AttributeEquals(buttonTag, "type", "submit");
        bool passed = nameField && emailField && topicField && messageField && submitButton;

        return new(
            passed,
            passed
                ? "Field types, names, autocomplete purpose, required states, and submit behavior are restored."
                : $"Name: {PassWord(nameField)}; email: {PassWord(emailField)}; topic: {PassWord(topicField)}; message: {PassWord(messageField)}; submit button: {PassWord(submitButton)}.");
    }

    private RequirementCheck EvaluateInstructionsAndStatus()
    {
        string html = HtmlCode ?? "";
        bool help = HasId(html, "form-help");
        Match formMatch = Regex.Match(
            html,
            @"<form\b(?<attrs>[^>]*)>",
            RegexOptions.IgnoreCase);
        string formTag = formMatch.Success ? formMatch.Value : "";
        bool described = AttributeContainsToken(formTag, "aria-describedby", "form-help");
        Match errorMatch = Regex.Match(
            html,
            @"<(?<tag>div|p|section)\b(?<attrs>[^>]*\bclass\s*=\s*[""'][^""']*\bform-errors\b[^""']*[""'][^>]*)>",
            RegexOptions.IgnoreCase);
        string errorTag = errorMatch.Success ? errorMatch.Value : "";
        bool alert = AttributeEquals(errorTag, "role", "alert");
        bool live = AttributeEquals(errorTag, "aria-live", "polite");
        bool passed = help && described && alert && live;

        return new(
            passed,
            passed
                ? "Form instructions are connected and validation status can be announced politely."
                : $"Help text: {PassWord(help)}; described form: {PassWord(described)}; alert role: {PassWord(alert)}; live region: {PassWord(live)}.");
    }

    private RequirementCheck EvaluateFormAccess()
    {
        string css = StripCssComments(CssCode);
        bool labelLayout =
            RuleContains(css, ".field-group label", @"display\s*:\s*(?:block|grid|flex)") ||
            RuleContains(css, "label", @"display\s*:\s*(?:block|grid|flex)");
        bool fullWidth =
            RuleContains(css, ".contact-form input", @"width\s*:\s*100%") ||
            RuleContains(css, ".form-control", @"width\s*:\s*100%");
        bool controlContrast =
            HasReadableSelector(css, ".contact-form input") ||
            HasReadableSelector(css, ".form-control");
        bool buttonContrast =
            HasReadableSelector(css, ".submit-button") ||
            HasReadableSelector(css, ".contact-form button");
        bool focus = Regex.IsMatch(
            css,
            @":focus-visible[\s\S]*?outline\s*:\s*(?!none)[^;]+",
            RegexOptions.IgnoreCase);
        bool spacing =
            RuleContains(css, ".form-control", @"padding\s*:") ||
            RuleContains(css, ".contact-form input", @"padding\s*:");
        bool passed = labelLayout && fullWidth && controlContrast && buttonContrast && focus && spacing;

        return new(
            passed,
            passed
                ? "Labels and controls are readable, full width, comfortably spaced, and keyboard visible."
                : $"Label layout: {PassWord(labelLayout)}; full width: {PassWord(fullWidth)}; control contrast: {PassWord(controlContrast)}; button contrast: {PassWord(buttonContrast)}; focus: {PassWord(focus)}; spacing: {PassWord(spacing)}.");
    }

    private RequirementCheck EvaluateResponsiveForm()
    {
        string css = StripCssComments(CssCode);
        bool desktopGrid =
            RuleContains(css, ".form-grid", @"display\s*:\s*grid") &&
            RuleContains(
                css,
                ".form-grid",
                @"grid-template-columns\s*:\s*(?:repeat\s*\(\s*2\s*,|(?:minmax\s*\([^)]*\)\s+){1}minmax|1fr\s+1fr)");
        bool fullSpan = RuleContains(css, ".field-full", @"grid-column\s*:");

        Match media = Regex.Match(
            css,
            @"@media\s*\(\s*max-width\s*:\s*(?<width>\d+)px\s*\)\s*\{(?<body>[\s\S]*)\}\s*$",
            RegexOptions.IgnoreCase);
        int width = media.Success ? int.Parse(media.Groups["width"].Value) : int.MaxValue;
        string body = media.Success ? media.Groups["body"].Value : "";
        bool breakpoint = media.Success && width >= 480 && width <= 820;
        bool mobileColumn = Regex.IsMatch(
            body,
            @"\.form-grid[\s\S]*?grid-template-columns\s*:\s*1fr",
            RegexOptions.IgnoreCase);
        bool fixedBodyWidth = RuleContains(css, "body", @"width\s*:\s*(?:[8-9]\d{2}|[1-9]\d{3,})px");
        bool fixedControlWidth = Regex.IsMatch(
            css,
            @"(?:\.form-control|input|select|textarea)[^{]*\{[^}]*width\s*:\s*(?:[3-9]\d{2}|[1-9]\d{3,})px",
            RegexOptions.IgnoreCase);
        bool passed =
            desktopGrid &&
            fullSpan &&
            breakpoint &&
            mobileColumn &&
            !fixedBodyWidth &&
            !fixedControlWidth;

        return new(
            passed,
            passed
                ? $"A {width}px breakpoint changes the two-column form into one column without fixed-width overflow."
                : $"Desktop grid: {PassWord(desktopGrid)}; full-span fields: {PassWord(fullSpan)}; breakpoint: {PassWord(breakpoint)}; mobile column: {PassWord(mobileColumn)}; body width removed: {PassWord(!fixedBodyWidth)}; control width removed: {PassWord(!fixedControlWidth)}.");
    }

    private static bool HasLabelFor(string html, string id) =>
        Regex.IsMatch(
            html ?? "",
            $@"<label\b[^>]*\bfor\s*=\s*[""']{Regex.Escape(id)}[""']",
            RegexOptions.IgnoreCase);

    private static bool HasControlId(string html, string id) =>
        Regex.IsMatch(
            html ?? "",
            $@"<(?:input|select|textarea)\b[^>]*\bid\s*=\s*[""']{Regex.Escape(id)}[""']",
            RegexOptions.IgnoreCase);

    private static int CountId(string html, string id) =>
        Regex.Matches(
            html ?? "",
            $@"\bid\s*=\s*[""']{Regex.Escape(id)}[""']",
            RegexOptions.IgnoreCase).Count;

    private static string OpeningTagWithId(string html, string tag, string id)
    {
        Match match = Regex.Match(
            html ?? "",
            $@"<{Regex.Escape(tag)}\b[^>]*\bid\s*=\s*[""']{Regex.Escape(id)}[""'][^>]*>",
            RegexOptions.IgnoreCase);
        return match.Success ? match.Value : "";
    }

    private static bool HasAttribute(string openingTag, string attribute) =>
        Regex.IsMatch(
            openingTag ?? "",
            $@"\s{Regex.Escape(attribute)}(?:\s*=|\s|>)",
            RegexOptions.IgnoreCase);

    private static bool AttributeEquals(string openingTag, string attribute, string value) =>
        Regex.IsMatch(
            openingTag ?? "",
            $@"\b{Regex.Escape(attribute)}\s*=\s*[""']{Regex.Escape(value)}[""']",
            RegexOptions.IgnoreCase);

    private static bool AttributeContainsToken(string openingTag, string attribute, string token)
    {
        Match match = Regex.Match(
            openingTag ?? "",
            $@"\b{Regex.Escape(attribute)}\s*=\s*[""'](?<value>[^""']*)[""']",
            RegexOptions.IgnoreCase);
        return match.Success &&
            match.Groups["value"].Value
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Any(value => string.Equals(value, token, StringComparison.OrdinalIgnoreCase));
    }

    private string BuildPreviewDocument()
    {
        string html = SanitizeHtml(HtmlCode);
        string css = SanitizeCss(CssCode);

        return $"""
            <!DOCTYPE html>
            <html lang="en">
            <head>
                <meta charset="UTF-8">
                <meta name="viewport" content="width=device-width, initial-scale=1.0">
                <title>Accessible Contact Form Recovery</title>
                <style>{PreviewStyles}\n{css}</style>
            </head>
            <body>
                {html}
            </body>
            </html>
            """;
    }

    private static string SanitizeHtml(string html)
    {
        string value = html ?? "";
        value = Regex.Replace(value, @"<script\b[\s\S]*?</script\s*>", "", RegexOptions.IgnoreCase);
        value = Regex.Replace(value, @"\s+on[a-z]+\s*=\s*(?:""[^""]*""|'[^']*')", "", RegexOptions.IgnoreCase);
        value = Regex.Replace(value, @"javascript\s*:", "", RegexOptions.IgnoreCase);
        value = Regex.Replace(value, @"\s+(?:src|href)\s*=\s*[""']https?://[^""']*[""']", "", RegexOptions.IgnoreCase);
        return value;
    }

    private static string SanitizeCss(string css)
    {
        string value = css ?? "";
        value = Regex.Replace(value, @"@import[^;]+;", "", RegexOptions.IgnoreCase);
        value = Regex.Replace(value, @"url\s*\([^)]*\)", "none", RegexOptions.IgnoreCase);
        value = Regex.Replace(value, @"expression\s*\([^)]*\)", "", RegexOptions.IgnoreCase);
        return value;
    }

    private static bool HasTag(string html, string tag) =>
        Regex.IsMatch(html ?? "", $@"<\s*{Regex.Escape(tag)}\b", RegexOptions.IgnoreCase);

    private static int CountTags(string html, string tag) =>
        Regex.Matches(html ?? "", $@"<\s*{Regex.Escape(tag)}\b", RegexOptions.IgnoreCase).Count;

    private static bool HasId(string html, string id) =>
        Regex.IsMatch(html ?? "", $@"\bid\s*=\s*[""']{Regex.Escape(id)}[""']", RegexOptions.IgnoreCase);

    private static bool HasClass(string html, string className) =>
        Regex.IsMatch(html ?? "", $@"\bclass\s*=\s*[""'][^""']*\b{Regex.Escape(className)}\b[^""']*[""']", RegexOptions.IgnoreCase);

    private static bool HasAnchorClass(string html, string className) =>
        Regex.IsMatch(html ?? "", $@"<a\b[^>]*\bclass\s*=\s*[""'][^""']*\b{Regex.Escape(className)}\b[^""']*[""']", RegexOptions.IgnoreCase);

    private static string StripCssComments(string css) =>
        Regex.Replace(css ?? "", @"/\*.*?\*/", "", RegexOptions.Singleline);

    private static bool RuleContains(string css, string selector, string declarationPattern)
    {
        MatchCollection rules = Regex.Matches(
            css ?? "",
            @"(?<selectors>[^{}]+)\{(?<body>[^{}]*)\}",
            RegexOptions.Singleline);

        foreach (Match rule in rules)
        {
            if (rule.Groups["selectors"].Value.IndexOf(selector, StringComparison.OrdinalIgnoreCase) < 0)
            {
                continue;
            }

            if (Regex.IsMatch(rule.Groups["body"].Value, declarationPattern, RegexOptions.IgnoreCase | RegexOptions.Singleline))
            {
                return true;
            }
        }

        return false;
    }

    private static bool HasReadableSelector(string css, string selector)
    {
        MatchCollection rules = Regex.Matches(
            css ?? "",
            @"(?<selectors>[^{}]+)\{(?<body>[^{}]*)\}",
            RegexOptions.Singleline);

        foreach (Match rule in rules)
        {
            if (rule.Groups["selectors"].Value.IndexOf(selector, StringComparison.OrdinalIgnoreCase) < 0)
            {
                continue;
            }

            string body = rule.Groups["body"].Value;
            string foreground = DeclarationValue(body, "color");
            string background = DeclarationValue(body, "background-color");

            if (string.IsNullOrWhiteSpace(background))
            {
                background = DeclarationValue(body, "background");
            }

            if (TryParseCssColor(foreground, out double foregroundLuminance) &&
                TryParseCssColor(background, out double backgroundLuminance))
            {
                double light = Math.Max(foregroundLuminance, backgroundLuminance);
                double dark = Math.Min(foregroundLuminance, backgroundLuminance);
                return (light + .05) / (dark + .05) >= 4.5;
            }
        }

        return false;
    }

    private static string DeclarationValue(string body, string property)
    {
        Match match = Regex.Match(
            body ?? "",
            $@"(?:^|;)\s*{Regex.Escape(property)}\s*:\s*(?<value>[^;]+)",
            RegexOptions.IgnoreCase);
        return match.Success ? match.Groups["value"].Value.Trim() : "";
    }

    private static bool TryParseCssColor(string value, out double luminance)
    {
        luminance = 0;
        string color = (value ?? "").Trim().ToLowerInvariant();
        color = color switch
        {
            "white" => "#ffffff",
            "black" => "#000000",
            "navy" => "#000080",
            _ => color
        };

        Match hex = Regex.Match(color, @"^#(?<hex>[0-9a-f]{3}|[0-9a-f]{6})$", RegexOptions.IgnoreCase);
        if (!hex.Success)
        {
            return false;
        }

        string digits = hex.Groups["hex"].Value;
        if (digits.Length == 3)
        {
            digits = string.Concat(digits.Select(character => new string(character, 2)));
        }

        int red = Convert.ToInt32(digits[..2], 16);
        int green = Convert.ToInt32(digits.Substring(2, 2), 16);
        int blue = Convert.ToInt32(digits.Substring(4, 2), 16);

        static double Channel(int component)
        {
            double componentValue = component / 255d;
            return componentValue <= .03928
                ? componentValue / 12.92
                : Math.Pow((componentValue + .055) / 1.055, 2.4);
        }

        luminance = .2126 * Channel(red) + .7152 * Channel(green) + .0722 * Channel(blue);
        return true;
    }

    private string ProfileButtonClass(DamageProfile profile) =>
        profile == CurrentProfile ? "rescue-profile-button active" : "rescue-profile-button";

    private static string ProfileLabel(DamageProfile profile) => profile switch
    {
        DamageProfile.HtmlSystems => "HTML systems",
        DamageProfile.CssSystems => "CSS systems",
        _ => "Full Incident"
    };

    private static string ProfileDescription(DamageProfile profile) => profile switch
    {
        DamageProfile.HtmlSystems => "Responsive form styles remain while semantics, labels, field purpose, and status messaging fail.",
        DamageProfile.CssSystems => "Semantic form controls remain while layout, contrast, focus, and mobile behavior fail.",
        _ => "Form semantics, labels, field purpose, status messaging, focus, and responsiveness are damaged."
    };

    private string ViewportButtonClass(PreviewViewport viewport) =>
        viewport == CurrentViewport ? "rescue-viewport-button active" : "rescue-viewport-button";

    private static string ViewportLabel(PreviewViewport viewport) => viewport switch
    {
        PreviewViewport.Tablet => "Tablet",
        PreviewViewport.Mobile => "Mobile",
        _ => "Desktop"
    };

    private static int CountLines(string value) =>
        string.IsNullOrEmpty(value) ? 0 : value.Count(character => character == '\n') + 1;

    private static int CountValidatedLines(string value) =>
        string.IsNullOrWhiteSpace(value)
            ? 0
            : value.Replace("\r\n", "\n").Split('\n').Count(line => !string.IsNullOrWhiteSpace(line));

    private static string FormatSeconds(double seconds)
    {
        TimeSpan value = TimeSpan.FromSeconds(Math.Max(0, seconds));
        return $"{(int)value.TotalMinutes:00}:{value.Seconds:00}";
    }

    private static string PassWord(bool passed) => passed ? "pass" : "pending";

    public async ValueTask DisposeAsync()
    {
        StopClock();
        if (TimerTask is not null)
        {
            try
            {
                await TimerTask;
            }
            catch (OperationCanceledException)
            {
            }
        }
    }
