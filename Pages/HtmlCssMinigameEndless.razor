@page "/minigames/html-css/endless"
@using CaveCode.CourseEngine
@using Microsoft.JSInterop
@inject CourseEngineService CourseEngine
@inject IJSRuntime JS

<PageTitle>Interface Rescue Endless Mode · CaveCode Academy</PageTitle>

@if (!AccessReady)
{
    <div class="endless-access"><section><span>∞</span><h1>Loading Endless Mode</h1></section></div>
}
else if (!string.IsNullOrWhiteSpace(AccessError))
{
    <div class="endless-access"><section><span>!</span><h1>Endless Mode could not load</h1><p>@AccessError</p></section></div>
}
else if (!CampaignComplete)
{
    <div class="endless-access">
        <section>
            <span>∞</span>
            <p class="endless-eyebrow">INTERFACE RESCUE · CAMPAIGN REQUIRED</p>
            <h1>Clear all five missions first</h1>
            <p>Your current campaign progress is @MissionProgress / 5.</p>
            <NavLink class="endless-primary" href="/minigames/html-css/campaign">Open Campaign →</NavLink>
        </section>
    </div>
}
else
{
<div class="endless-shell">
    <header class="endless-header">
        <NavLink class="endless-back" href="/minigames/html-css/campaign">← Interface Rescue Campaign</NavLink>
        <span class="endless-mark">∞</span>
        <p class="endless-eyebrow">HTML & CSS WORKSHOP · ENDLESS MODE</p>
        <h1>Random Recovery Assignment</h1>
        <p>
            Generate a mission and damage profile, complete the assigned run,
            then return for another combination.
        </p>
    </header>

    <main class="endless-main">
        <section class="endless-assignment-panel">
            @if (AssignedMission == 0)
            {
                <div class="endless-empty">
                    <span>?</span>
                    <h2>No active assignment</h2>
                    <p>Generate a randomized mission and profile when you are ready.</p>
                </div>
            }
            else
            {
                <div class="endless-assignment">
                    <span class="endless-assignment-number">MISSION @AssignedMission</span>
                    <h2>@AssignedMissionTitle</h2>
                    <div class="endless-profile">
                        <span>DAMAGE PROFILE</span>
                        <strong>@AssignedProfileLabel</strong>
                    </div>
                    <p>
                        Open the assigned mission and select the
                        <strong>@AssignedProfileLabel</strong> profile before starting the timer.
                    </p>
                    <NavLink class="endless-primary" href="@AssignedMissionHref">
                        Open Assigned Mission →
                    </NavLink>
                </div>
            }

            <button class="endless-generate"
                    disabled="@Generating"
                    @onclick="GenerateAssignmentAsync">
                @(Generating ? "Generating…" : AssignedMission == 0 ? "Generate Assignment" : "Generate Another")
            </button>

            @if (!string.IsNullOrWhiteSpace(StatusMessage))
            {
                <p class="endless-message">@StatusMessage</p>
            }
        </section>

        <aside class="endless-sidebar">
            <section>
                <p class="endless-eyebrow">ENDLESS RECORD</p>
                <div class="endless-record-grid">
                    <div><span>Assignments</span><strong>@State.EndlessRuns.ToString("N0")</strong></div>
                    <div><span>Last mission</span><strong>@LastMissionText</strong></div>
                    <div><span>Last profile</span><strong>@LastProfileText</strong></div>
                </div>
            </section>

            <section>
                <p class="endless-eyebrow">RUN RULES</p>
                <ol>
                    <li>Generate one randomized assignment.</li>
                    <li>Open the assigned mission.</li>
                    <li>Select the displayed damage profile.</li>
                    <li>Complete all six automated requirements.</li>
                    <li>Return here for the next assignment.</li>
                </ol>
            </section>

            <section>
                <p class="endless-eyebrow">REWARDS</p>
                <p>
                    Endless Mode does not add a second reward layer. Each successful run
                    uses that mission's normal repeat-clear reward: 40 HTML/CSS XP,
                    ◆ 2 crystals, and validated-line credit.
                </p>
            </section>
        </aside>
    </main>
</div>
}

<style>
    .endless-shell,
    .endless-access {
        min-height: 100vh;
        color: var(--text, #eef7ff);
        background:
            radial-gradient(circle at 50% 0%, color-mix(in srgb, var(--accent, #38bdf8) 23%, transparent), transparent 40%),
            var(--background, #07101b);
    }

    .endless-access {
        display: grid;
        place-items: center;
        padding: 26px;
    }

    .endless-access section {
        display: grid;
        justify-items: center;
        gap: 12px;
        width: min(680px, 100%);
        padding: 34px;
        text-align: center;
        background: color-mix(in srgb, var(--surface, #101927) 92%, transparent);
        border: 1px solid var(--border, #304158);
        border-radius: 20px;
    }

    .endless-access section > span,
    .endless-mark {
        display: grid;
        place-items: center;
        width: 76px;
        height: 76px;
        color: var(--accent, #38bdf8);
        font-size: 42px;
        font-weight: 950;
        border: 1px solid color-mix(in srgb, var(--accent, #38bdf8) 60%, transparent);
        border-radius: 22px;
        box-shadow: 0 0 40px color-mix(in srgb, var(--accent, #38bdf8) 35%, transparent);
    }

    .endless-header {
        display: grid;
        justify-items: center;
        gap: 8px;
        padding: 26px 24px 34px;
        text-align: center;
        border-bottom: 1px solid var(--border, #304158);
    }

    .endless-back {
        justify-self: start;
        color: var(--text-muted, #9db0c7);
        font-size: 12px;
        font-weight: 850;
        text-decoration: none;
    }

    .endless-header h1 {
        margin: 4px 0;
        font-size: clamp(34px, 6vw, 62px);
    }

    .endless-header > p:last-child {
        max-width: 680px;
        margin: 0;
        color: var(--text-muted, #9db0c7);
        line-height: 1.6;
    }

    .endless-eyebrow {
        margin: 0;
        color: var(--accent, #38bdf8);
        font-size: 10px;
        font-weight: 950;
        letter-spacing: 1.1px;
    }

    .endless-main {
        display: grid;
        grid-template-columns: minmax(0, 1.45fr) minmax(300px, .55fr);
        gap: 18px;
        width: min(1080px, calc(100% - 32px));
        margin: 0 auto;
        padding: 28px 0 56px;
    }

    .endless-assignment-panel,
    .endless-sidebar section {
        padding: 22px;
        background: color-mix(in srgb, var(--surface, #101927) 92%, transparent);
        border: 1px solid var(--border, #304158);
        border-radius: 18px;
    }

    .endless-assignment-panel {
        display: grid;
        align-content: start;
        gap: 16px;
        min-height: 520px;
    }

    .endless-empty,
    .endless-assignment {
        display: grid;
        justify-items: center;
        align-content: center;
        gap: 14px;
        min-height: 370px;
        padding: 26px;
        text-align: center;
        background: var(--surface-soft, #162438);
        border: 1px dashed var(--border, #304158);
        border-radius: 16px;
    }

    .endless-empty > span {
        color: var(--text-muted, #9db0c7);
        font-size: 62px;
        font-weight: 950;
    }

    .endless-assignment-number {
        color: var(--accent, #38bdf8);
        font-size: 11px;
        font-weight: 950;
        letter-spacing: 1.2px;
    }

    .endless-assignment h2 {
        margin: 0;
        font-size: clamp(26px, 5vw, 44px);
    }

    .endless-profile {
        display: grid;
        gap: 4px;
        min-width: min(360px, 100%);
        padding: 15px;
        background: color-mix(in srgb, var(--accent, #38bdf8) 10%, var(--surface, #101927));
        border: 1px solid color-mix(in srgb, var(--accent, #38bdf8) 50%, var(--border, #304158));
        border-radius: 12px;
    }

    .endless-profile span {
        color: var(--text-muted, #9db0c7);
        font-size: 9px;
        font-weight: 900;
    }

    .endless-profile strong {
        font-size: 19px;
    }

    .endless-assignment p,
    .endless-sidebar p,
    .endless-sidebar li {
        color: var(--text-muted, #9db0c7);
        line-height: 1.55;
    }

    .endless-primary,
    .endless-generate {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        min-height: 46px;
        padding: 12px 18px;
        color: #fff;
        background: var(--accent, #2563eb);
        border: 1px solid color-mix(in srgb, var(--accent, #2563eb) 72%, #fff);
        border-radius: 10px;
        font-weight: 950;
        text-decoration: none;
        cursor: pointer;
    }

    .endless-generate {
        width: 100%;
    }

    .endless-primary:focus-visible,
    .endless-generate:focus-visible {
        outline: 3px solid color-mix(in srgb, var(--accent, #38bdf8) 55%, #fff);
        outline-offset: 3px;
    }

    .endless-sidebar {
        display: grid;
        align-content: start;
        gap: 14px;
    }

    .endless-record-grid {
        display: grid;
        gap: 8px;
        margin-top: 12px;
    }

    .endless-record-grid > div {
        display: grid;
        gap: 3px;
        padding: 12px;
        background: var(--surface-soft, #162438);
        border: 1px solid var(--border, #304158);
        border-radius: 10px;
    }

    .endless-record-grid span {
        color: var(--text-muted, #9db0c7);
        font-size: 9px;
    }

    .endless-record-grid strong {
        font-size: 15px;
    }

    .endless-sidebar ol {
        padding-left: 20px;
        margin-bottom: 0;
    }

    .endless-message {
        padding: 12px;
        color: var(--text-muted, #9db0c7);
        background: var(--surface-soft, #162438);
        border: 1px solid var(--border, #304158);
        border-radius: 10px;
    }

    @@media (max-width: 820px) {
        .endless-main {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private const int ChapterOneFinalModuleIndex = 7;
    private static readonly string[] Profiles = { "FullIncident", "HtmlSystems", "CssSystems" };

    private sealed class EndlessState
    {
        public bool Mission1Completed { get; set; }
        public bool Mission2Completed { get; set; }
        public bool Mission3Completed { get; set; }
        public bool Mission4Completed { get; set; }
        public bool Mission5Completed { get; set; }
        public int EndlessRuns { get; set; }
        public int EndlessLastMission { get; set; }
        public string EndlessLastProfile { get; set; } = "";
    }

    private bool AccessReady;
    private string AccessError = "";
    private EndlessState State = new();
    private bool Generating;
    private int AssignedMission;
    private string AssignedProfile = "";
    private string StatusMessage = "";

    private int MissionProgress =>
        (State.Mission1Completed ? 1 : 0) +
        (State.Mission2Completed ? 1 : 0) +
        (State.Mission3Completed ? 1 : 0) +
        (State.Mission4Completed ? 1 : 0) +
        (State.Mission5Completed ? 1 : 0);

    private bool CampaignComplete => MissionProgress == 5;

    private string AssignedMissionTitle => AssignedMission switch
    {
        1 => "Workshop Landing Page",
        2 => "Project Card Grid",
        3 => "Mobile Navigation",
        4 => "Accessible Contact Form",
        5 => "Responsive Dashboard",
        _ => ""
    };

    private string AssignedMissionHref => AssignedMission switch
    {
        1 => "/minigames/html-css",
        2 => "/minigames/html-css/mission-2",
        3 => "/minigames/html-css/mission-3",
        4 => "/minigames/html-css/mission-4",
        5 => "/minigames/html-css/mission-5",
        _ => "/minigames/html-css/campaign"
    };

    private string AssignedProfileLabel => FormatProfile(AssignedProfile);
    private string LastMissionText => State.EndlessLastMission > 0 ? $"Mission {State.EndlessLastMission}" : "—";
    private string LastProfileText => FormatProfile(State.EndlessLastProfile);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _ = await CourseEngine.GetProgressAsync(CourseIds.HtmlCss);
            State = await JS.InvokeAsync<EndlessState>(
                "caveCodeHtmlCssMinigame.getState");
        }
        catch (Exception error)
        {
            AccessError = "Endless Mode could not read the local checkpoint: " + error.Message;
        }
        finally
        {
            AccessReady = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task GenerateAssignmentAsync()
    {
        if (!CampaignComplete || Generating)
        {
            return;
        }

        Generating = true;
        StatusMessage = "";

        try
        {
            AssignedMission = Random.Shared.Next(1, 6);
            AssignedProfile = Profiles[Random.Shared.Next(Profiles.Length)];

            State = await JS.InvokeAsync<EndlessState>(
                "caveCodeHtmlCssMinigame.recordEndlessLaunch",
                AssignedMission,
                AssignedProfile);

            StatusMessage =
                $"Assignment {State.EndlessRuns:N0} generated: Mission {AssignedMission}, {AssignedProfileLabel}.";
        }
        catch (Exception error)
        {
            StatusMessage = "The assignment could not be saved: " + error.Message;
        }
        finally
        {
            Generating = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string FormatProfile(string profile) => profile switch
    {
        "FullIncident" => "Full Incident",
        "HtmlSystems" => "HTML Systems",
        "CssSystems" => "CSS Systems",
        _ => "—"
    };
}
