    private static int CountLines(string value) =>
        string.IsNullOrEmpty(value) ? 0 : value.Count(character => character == '\n') + 1;

    private static int CountValidatedLines(string value) =>
        string.IsNullOrWhiteSpace(value)
            ? 0
            : value.Replace("\r\n", "\n").Split('\n').Count(line => !string.IsNullOrWhiteSpace(line));

    private static string FormatSeconds(double seconds)
    {
        TimeSpan value = TimeSpan.FromSeconds(Math.Max(0, seconds));
        return $"{(int)value.TotalMinutes:00}:{value.Seconds:00}";
    }

    private static string PassWord(bool passed) => passed ? "pass" : "pending";

    public async ValueTask DisposeAsync()
    {
        StopClock();
        if (TimerTask is not null)
        {
            try
            {
                await TimerTask;
            }
            catch (OperationCanceledException)
            {
            }
        }
    }
