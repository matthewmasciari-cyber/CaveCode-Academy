    private RequirementCheck[] EvaluateRequirements() =>
        Enumerable.Range(0, Requirements.Length)
            .Select(EvaluateRequirement)
            .ToArray();

    private RequirementCheck EvaluateRequirement(int index) => index switch
    {
        0 => EvaluateDashboardFrame(),
        1 => EvaluateMetricCards(),
        2 => EvaluateActivityTable(),
        3 => EvaluateActionsAndStatus(),
        4 => EvaluateDashboardPresentation(),
        5 => EvaluateResponsiveDashboard(),
        _ => new(false, "Unknown requirement.")
    };

    private RequirementCheck EvaluateDashboardFrame()
    {
        string html = HtmlCode ?? "";
        bool main = Regex.IsMatch(
            html,
            @"<main\b[^>]*\bclass\s*=\s*[""'][^""']*\bdashboard-shell\b[^""']*[""']",
            RegexOptions.IgnoreCase);
        bool header = Regex.IsMatch(
            html,
            @"<header\b[^>]*\bclass\s*=\s*[""'][^""']*\bdashboard-header\b[^""']*[""'][^>]*\baria-labelledby\s*=\s*[""']dashboard-title[""']",
            RegexOptions.IgnoreCase);
        bool heading = Regex.IsMatch(
            html,
            @"<h1\b[^>]*\bid\s*=\s*[""']dashboard-title[""']",
            RegexOptions.IgnoreCase);
        bool passed = main && header && heading;

        return new(
            passed,
            passed
                ? "A semantic dashboard main region contains a labeled header and clear page title."
                : $"Dashboard main: {PassWord(main)}; labeled header: {PassWord(header)}; title ID: {PassWord(heading)}.");
    }

    private RequirementCheck EvaluateMetricCards()
    {
        string html = HtmlCode ?? "";
        bool section = Regex.IsMatch(
            html,
            @"<section\b[^>]*\bclass\s*=\s*[""'][^""']*\bmetric-grid\b[^""']*[""'][^>]*\baria-label\s*=\s*[""'][^""']+[""']",
            RegexOptions.IgnoreCase);
        MatchCollection cards = Regex.Matches(
            html,
            @"<article\b[^>]*\bclass\s*=\s*[""'][^""']*\bmetric-card\b[^""']*[""'][^>]*>(?<body>[\s\S]*?)</article>",
            RegexOptions.IgnoreCase);
        int complete = cards
            .Cast<Match>()
            .Count(card =>
                Regex.IsMatch(card.Groups["body"].Value, @"\bclass\s*=\s*[""'][^""']*\bmetric-label\b", RegexOptions.IgnoreCase) &&
                Regex.IsMatch(card.Groups["body"].Value, @"<strong\b", RegexOptions.IgnoreCase) &&
                Regex.IsMatch(card.Groups["body"].Value, @"<small\b", RegexOptions.IgnoreCase));
        bool passed = section && cards.Count == 4 && complete == 4;

        return new(
            passed,
            passed
                ? "The labeled metric region contains four complete semantic metric cards."
                : $"Labeled metric section: {PassWord(section)}; cards: {cards.Count} / 4; complete cards: {complete} / 4.");
    }

    private RequirementCheck EvaluateActivityTable()
    {
        string html = HtmlCode ?? "";
        Match table = Regex.Match(
            html,
            @"<table\b[^>]*\bclass\s*=\s*[""'][^""']*\bactivity-table\b[^""']*[""'][^>]*>(?<body>[\s\S]*?)</table>",
            RegexOptions.IgnoreCase);
        string body = table.Success ? table.Groups["body"].Value : "";
        bool caption = Regex.IsMatch(body, @"<caption\b[^>]*>[\s\S]*?</caption>", RegexOptions.IgnoreCase);
        bool head = HasTag(body, "thead");
        bool tableBody = HasTag(body, "tbody");
        int scopedHeaders = Regex.Matches(
            body,
            @"<th\b[^>]*\bscope\s*=\s*[""']col[""']",
            RegexOptions.IgnoreCase).Count;
        bool activityRegion =
            HasId(html, "activity") &&
            HasId(html, "activity-title");
        bool passed =
            table.Success &&
            caption &&
            head &&
            tableBody &&
            scopedHeaders >= 3 &&
            activityRegion;

        return new(
            passed,
            passed
                ? "Recent activity uses a captioned table with table sections and scoped column headers."
                : $"Table: {PassWord(table.Success)}; caption: {PassWord(caption)}; head/body: {PassWord(head && tableBody)}; scoped headers: {scopedHeaders} / 3; activity IDs: {PassWord(activityRegion)}.");
    }

    private RequirementCheck EvaluateActionsAndStatus()
    {
        string html = HtmlCode ?? "";
        Match nav = Regex.Match(
            html,
            @"<nav\b[^>]*\bclass\s*=\s*[""'][^""']*\bdashboard-actions\b[^""']*[""'][^>]*\baria-label\s*=\s*[""'][^""']+[""'][^>]*>(?<body>[\s\S]*?)</nav>",
            RegexOptions.IgnoreCase);
        string navBody = nav.Success ? nav.Groups["body"].Value : "";
        bool activityLink = Regex.IsMatch(
            navBody,
            @"<a\b[^>]*\bhref\s*=\s*[""']#activity[""']",
            RegexOptions.IgnoreCase);
        bool actionButton = Regex.IsMatch(
            navBody,
            @"<button\b[^>]*\btype\s*=\s*[""']button[""']",
            RegexOptions.IgnoreCase);
        Match status = Regex.Match(
            html,
            @"<aside\b[^>]*\bclass\s*=\s*[""'][^""']*\bstatus-panel\b[^""']*[""'][^>]*\baria-labelledby\s*=\s*[""']status-title[""'][^>]*>(?<body>[\s\S]*?)</aside>",
            RegexOptions.IgnoreCase);
        string statusBody = status.Success ? status.Groups["body"].Value : "";
        bool statusHeading = HasId(statusBody, "status-title");
        int statusItems = CountTags(statusBody, "li");
        bool passed =
            nav.Success &&
            activityLink &&
            actionButton &&
            status.Success &&
            statusHeading &&
            statusItems >= 3;

        return new(
            passed,
            passed
                ? "Dashboard actions are labeled and the status panel contains three readable system entries."
                : $"Action nav: {PassWord(nav.Success)}; activity link: {PassWord(activityLink)}; button: {PassWord(actionButton)}; status region: {PassWord(status.Success && statusHeading)}; status items: {statusItems} / 3.");
    }

    private RequirementCheck EvaluateDashboardPresentation()
    {
        string css = StripCssComments(CssCode);
        bool metricGrid =
            RuleContains(css, ".metric-grid", @"display\s*:\s*grid") &&
            RuleContains(
                css,
                ".metric-grid",
                @"grid-template-columns\s*:\s*repeat\s*\(\s*4\s*,");
        bool contentGrid =
            RuleContains(css, ".dashboard-content", @"display\s*:\s*grid") &&
            RuleContains(css, ".dashboard-content", @"grid-template-columns\s*:");
        bool readablePanel =
            HasReadableSelector(css, ".metric-card") ||
            HasReadableSelector(css, ".panel");
        bool readableAction =
            HasReadableSelector(css, ".primary-action") ||
            HasReadableSelector(css, ".action-link");
        bool focus = Regex.IsMatch(
            css,
            @":focus-visible[\s\S]*?outline\s*:\s*(?!none)[^;]+",
            RegexOptions.IgnoreCase);
        bool passed =
            metricGrid &&
            contentGrid &&
            readablePanel &&
            readableAction &&
            focus;

        return new(
            passed,
            passed
                ? "Desktop grids, readable panels and actions, and visible keyboard focus are restored."
                : $"Four-column metrics: {PassWord(metricGrid)}; content grid: {PassWord(contentGrid)}; panel contrast: {PassWord(readablePanel)}; action contrast: {PassWord(readableAction)}; focus: {PassWord(focus)}.");
    }

    private RequirementCheck EvaluateResponsiveDashboard()
    {
        string css = StripCssComments(CssCode);
        Match media = Regex.Match(
            css,
            @"@media\s*\(\s*max-width\s*:\s*(?<width>\d+)px\s*\)\s*\{(?<body>[\s\S]*?)\}(?=\s*@media|\s*$)",
            RegexOptions.IgnoreCase);
        int width = media.Success ? int.Parse(media.Groups["width"].Value) : int.MaxValue;
        string body = media.Success ? media.Groups["body"].Value : "";
        bool breakpoint = media.Success && width >= 600 && width <= 900;
        bool metricReflow = Regex.IsMatch(
            body,
            @"\.metric-grid[\s\S]*?grid-template-columns\s*:\s*repeat\s*\(\s*2\s*,",
            RegexOptions.IgnoreCase);
        bool contentStack = Regex.IsMatch(
            body,
            @"\.dashboard-content[\s\S]*?grid-template-columns\s*:\s*1fr",
            RegexOptions.IgnoreCase);
        bool tableScroll = RuleContains(css, ".table-scroll", @"overflow-x\s*:\s*auto");
        bool fixedBodyWidth = RuleContains(css, "body", @"width\s*:\s*(?:[8-9]\d{2}|[1-9]\d{3,})px");
        bool fixedShellWidth = RuleContains(css, ".dashboard-shell", @"width\s*:\s*(?:[8-9]\d{2}|[1-9]\d{3,})px");
        bool passed =
            breakpoint &&
            metricReflow &&
            contentStack &&
            tableScroll &&
            !fixedBodyWidth &&
            !fixedShellWidth;

        return new(
            passed,
            passed
                ? $"A {width}px breakpoint reorganizes metrics and content while the activity table scrolls safely."
                : $"Breakpoint: {PassWord(breakpoint)}; metric reflow: {PassWord(metricReflow)}; content stack: {PassWord(contentStack)}; table scroll: {PassWord(tableScroll)}; body width removed: {PassWord(!fixedBodyWidth)}; shell width removed: {PassWord(!fixedShellWidth)}.");
    }

    private static bool HasLabelFor(string html, string id) =>
        Regex.IsMatch(
            html ?? "",
            $@"<label\b[^>]*\bfor\s*=\s*[""']{Regex.Escape(id)}[""']",
            RegexOptions.IgnoreCase);

    private static bool HasControlId(string html, string id) =>
        Regex.IsMatch(
            html ?? "",
            $@"<(?:input|select|textarea)\b[^>]*\bid\s*=\s*[""']{Regex.Escape(id)}[""']",
            RegexOptions.IgnoreCase);

    private static int CountId(string html, string id) =>
        Regex.Matches(
            html ?? "",
            $@"\bid\s*=\s*[""']{Regex.Escape(id)}[""']",
            RegexOptions.IgnoreCase).Count;

    private static string OpeningTagWithId(string html, string tag, string id)
    {
        Match match = Regex.Match(
            html ?? "",
            $@"<{Regex.Escape(tag)}\b[^>]*\bid\s*=\s*[""']{Regex.Escape(id)}[""'][^>]*>",
            RegexOptions.IgnoreCase);
        return match.Success ? match.Value : "";
    }

    private static bool HasAttribute(string openingTag, string attribute) =>
        Regex.IsMatch(
            openingTag ?? "",
            $@"\s{Regex.Escape(attribute)}(?:\s*=|\s|>)",
            RegexOptions.IgnoreCase);

    private static bool AttributeEquals(string openingTag, string attribute, string value) =>
        Regex.IsMatch(
            openingTag ?? "",
            $@"\b{Regex.Escape(attribute)}\s*=\s*[""']{Regex.Escape(value)}[""']",
            RegexOptions.IgnoreCase);

    private static bool AttributeContainsToken(string openingTag, string attribute, string token)
    {
        Match match = Regex.Match(
            openingTag ?? "",
            $@"\b{Regex.Escape(attribute)}\s*=\s*[""'](?<value>[^""']*)[""']",
            RegexOptions.IgnoreCase);
        return match.Success &&
            match.Groups["value"].Value
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Any(value => string.Equals(value, token, StringComparison.OrdinalIgnoreCase));
    }

    private string BuildPreviewDocument()
    {
        string html = SanitizeHtml(HtmlCode);
        string css = SanitizeCss(CssCode);

        return $"""
            <!DOCTYPE html>
            <html lang="en">
            <head>
                <meta charset="UTF-8">
                <meta name="viewport" content="width=device-width, initial-scale=1.0">
                <title>Responsive Dashboard Recovery</title>
                <style>{PreviewStyles}\n{css}</style>
            </head>
            <body>
                {html}
            </body>
            </html>
            """;
    }

    private static string SanitizeHtml(string html)
    {
        string value = html ?? "";
        value = Regex.Replace(value, @"<script\b[\s\S]*?</script\s*>", "", RegexOptions.IgnoreCase);
        value = Regex.Replace(value, @"\s+on[a-z]+\s*=\s*(?:""[^""]*""|'[^']*')", "", RegexOptions.IgnoreCase);
        value = Regex.Replace(value, @"javascript\s*:", "", RegexOptions.IgnoreCase);
        value = Regex.Replace(value, @"\s+(?:src|href)\s*=\s*[""']https?://[^""']*[""']", "", RegexOptions.IgnoreCase);
        return value;
    }

    private static string SanitizeCss(string css)
    {
        string value = css ?? "";
        value = Regex.Replace(value, @"@import[^;]+;", "", RegexOptions.IgnoreCase);
        value = Regex.Replace(value, @"url\s*\([^)]*\)", "none", RegexOptions.IgnoreCase);
        value = Regex.Replace(value, @"expression\s*\([^)]*\)", "", RegexOptions.IgnoreCase);
        return value;
    }

    private static bool HasTag(string html, string tag) =>
        Regex.IsMatch(html ?? "", $@"<\s*{Regex.Escape(tag)}\b", RegexOptions.IgnoreCase);

    private static int CountTags(string html, string tag) =>
        Regex.Matches(html ?? "", $@"<\s*{Regex.Escape(tag)}\b", RegexOptions.IgnoreCase).Count;

    private static bool HasId(string html, string id) =>
        Regex.IsMatch(html ?? "", $@"\bid\s*=\s*[""']{Regex.Escape(id)}[""']", RegexOptions.IgnoreCase);

    private static bool HasClass(string html, string className) =>
        Regex.IsMatch(html ?? "", $@"\bclass\s*=\s*[""'][^""']*\b{Regex.Escape(className)}\b[^""']*[""']", RegexOptions.IgnoreCase);

    private static bool HasAnchorClass(string html, string className) =>
        Regex.IsMatch(html ?? "", $@"<a\b[^>]*\bclass\s*=\s*[""'][^""']*\b{Regex.Escape(className)}\b[^""']*[""']", RegexOptions.IgnoreCase);

    private static string StripCssComments(string css) =>
        Regex.Replace(css ?? "", @"/\*.*?\*/", "", RegexOptions.Singleline);

    private static bool RuleContains(string css, string selector, string declarationPattern)
    {
        MatchCollection rules = Regex.Matches(
            css ?? "",
            @"(?<selectors>[^{}]+)\{(?<body>[^{}]*)\}",
            RegexOptions.Singleline);

        foreach (Match rule in rules)
        {
            if (rule.Groups["selectors"].Value.IndexOf(selector, StringComparison.OrdinalIgnoreCase) < 0)
            {
                continue;
            }

            if (Regex.IsMatch(rule.Groups["body"].Value, declarationPattern, RegexOptions.IgnoreCase | RegexOptions.Singleline))
            {
                return true;
            }
        }

        return false;
    }

    private static bool HasReadableSelector(string css, string selector)
    {
        MatchCollection rules = Regex.Matches(
            css ?? "",
            @"(?<selectors>[^{}]+)\{(?<body>[^{}]*)\}",
            RegexOptions.Singleline);

        foreach (Match rule in rules)
        {
            if (rule.Groups["selectors"].Value.IndexOf(selector, StringComparison.OrdinalIgnoreCase) < 0)
            {
                continue;
            }

            string body = rule.Groups["body"].Value;
            string foreground = DeclarationValue(body, "color");
            string background = DeclarationValue(body, "background-color");

            if (string.IsNullOrWhiteSpace(background))
            {
                background = DeclarationValue(body, "background");
            }

            if (TryParseCssColor(foreground, out double foregroundLuminance) &&
                TryParseCssColor(background, out double backgroundLuminance))
            {
                double light = Math.Max(foregroundLuminance, backgroundLuminance);
                double dark = Math.Min(foregroundLuminance, backgroundLuminance);
                return (light + .05) / (dark + .05) >= 4.5;
            }
        }

        return false;
    }

    private static string DeclarationValue(string body, string property)
    {
        Match match = Regex.Match(
            body ?? "",
            $@"(?:^|;)\s*{Regex.Escape(property)}\s*:\s*(?<value>[^;]+)",
            RegexOptions.IgnoreCase);
        return match.Success ? match.Groups["value"].Value.Trim() : "";
    }

    private static bool TryParseCssColor(string value, out double luminance)
    {
        luminance = 0;
        string color = (value ?? "").Trim().ToLowerInvariant();
        color = color switch
        {
            "white" => "#ffffff",
            "black" => "#000000",
            "navy" => "#000080",
            _ => color
        };

        Match hex = Regex.Match(color, @"^#(?<hex>[0-9a-f]{3}|[0-9a-f]{6})$", RegexOptions.IgnoreCase);
        if (!hex.Success)
        {
            return false;
        }

        string digits = hex.Groups["hex"].Value;
        if (digits.Length == 3)
        {
            digits = string.Concat(digits.Select(character => new string(character, 2)));
        }

        int red = Convert.ToInt32(digits[..2], 16);
        int green = Convert.ToInt32(digits.Substring(2, 2), 16);
        int blue = Convert.ToInt32(digits.Substring(4, 2), 16);

        static double Channel(int component)
        {
            double componentValue = component / 255d;
            return componentValue <= .03928
                ? componentValue / 12.92
                : Math.Pow((componentValue + .055) / 1.055, 2.4);
        }

        luminance = .2126 * Channel(red) + .7152 * Channel(green) + .0722 * Channel(blue);
        return true;
    }

