@page "/minigames/gcl"
@using CaveCode.CourseEngine
@using Microsoft.JSInterop
@inject CourseEngineService CourseEngine
@inject ProgressionService ProgressionService
@inject AchievementService AchievementService
@inject IJSRuntime JS

<PageTitle>GCL+ Control Line Lab Minigame | CaveCode Academy</PageTitle>

@if (!AccessReady)
{
    <main class="gcl-access-screen">
        <section>
            <span class="gcl-access-mark">GCL+</span>
            <p class="gcl-eyebrow">CONTROL LINE LAB</p>
            <h1>Preparing the sequence workshop</h1>
            <p>Checking your GCL+ course checkpoint on this device.</p>
        </section>
    </main>
}
else if (!AccessGranted)
{
    <main class="gcl-access-screen">
        <section>
            <span class="gcl-access-mark">GCL+</span>
            <p class="gcl-eyebrow">CHAPTER 1 ACCESS GATE</p>
            <h1>Control Line Lab minigame is still locked</h1>

            @if (ProgressLoadFailed)
            {
                <p>
                    CaveCode could not read the local GCL+ course checkpoint.
                    Open the GCL+ course once, then return to this page.
                </p>
            }
            else
            {
                <p>
                    Complete all eight Line Foundations modules before
                    entering the sequence repair workshop.
                </p>

                <div class="gcl-gate-progress">
                    <strong>@CompletedChapterModules / 8</strong>
                    <span>Chapter 1 modules complete</span>
                </div>
            }

            <div class="gcl-access-actions">
                <NavLink class="gcl-primary" href="/gcl">
                    Open GCL+ Chapter 1 →
                </NavLink>
                <NavLink class="gcl-secondary" href="/minigames">
                    Back to Minigames
                </NavLink>
            </div>
        </section>
    </main>
}
else
{
    <main class="gcl-minigame-shell">
        <header class="gcl-mg-header">
            <div class="gcl-mg-title-group">
                <span class="gcl-mg-logo">GCL+</span>
                <div>
                    <p class="gcl-eyebrow">SEQUENCE REPAIR · MISSION 1</p>
                    <h1>Control Line Lab</h1>
                    <p>
                        Restore damaged control sequences using variables,
                        If / IfOnce, OnFor prove timers, Limit, and stage flags.
                    </p>
                </div>
            </div>

            <nav class="gcl-mg-header-actions" aria-label="Control Line Lab navigation">
                <NavLink href="/minigames">Minigames</NavLink>
                <NavLink href="/gcl">Course</NavLink>
                <NavLink href="/">Academy Home</NavLink>
            </nav>
        </header>

        <section class="gcl-mg-board">
            <div class="gcl-mg-mission-card">
                <h2>Mission @CurrentMissionIndex of @Missions.Length</h2>
                <p class="gcl-mg-brief">@CurrentMission.Brief</p>

                <div class="gcl-mg-broken">
                    <h3>Damaged sequence</h3>
                    <pre><code>@CurrentMission.BrokenCode</code></pre>
                </div>

                <label class="gcl-mg-editor-label" for="gcl-repair-editor">Your repair</label>
                <textarea id="gcl-repair-editor"
                          class="gcl-mg-editor"
                          rows="12"
                          @bind="PlayerCode"
                          @bind:event="oninput"
                          spellcheck="false"></textarea>

                <div class="gcl-mg-actions">
                    <button type="button" class="gcl-primary" @onclick="CheckRepairAsync">
                        Validate repair
                    </button>
                    <button type="button" class="gcl-secondary" @onclick="ResetEditor">
                        Reset to damaged code
                    </button>
                    @if (MissionCleared[CurrentMissionIndex])
                    {
                        <button type="button" class="gcl-primary" @onclick="NextMission">
                            Next mission →
                        </button>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(Feedback))
                {
                    <p class="gcl-mg-feedback @(LastCheckPassed ? "ok" : "bad")">@Feedback</p>
                }
            </div>

            <aside class="gcl-mg-side">
                <h3>Mission checklist</h3>
                <ul>
                    @for (int i = 0; i < Missions.Length; i++)
                    {
                        <li class="@(MissionCleared[i] ? "cleared" : i == CurrentMissionIndex ? "active" : "")">
                            @(i + 1). @Missions[i].Title
                            @if (MissionCleared[i])
                            {
                                <span>✓</span>
                            }
                        </li>
                    }
                </ul>
                <p class="gcl-mg-hint-title">Hint</p>
                <p class="gcl-mg-hint">@CurrentMission.Hint</p>
            </aside>
        </section>
    </main>
}

<style>
    .gcl-access-screen, .gcl-minigame-shell {
        min-height: 100vh;
        padding: 2rem;
        background: var(--bg);
        color: var(--text);
        font-family: Inter, system-ui, sans-serif;
    }
    .gcl-access-mark, .gcl-mg-logo {
        display: inline-block;
        padding: 0.35rem 0.7rem;
        border-radius: 0.5rem;
        background: var(--accent);
        color: var(--accent-contrast, #fff);
        font-weight: 700;
    }
    .gcl-eyebrow { letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); font-size: 0.8rem; }
    .gcl-gate-progress { margin: 1rem 0; font-size: 1.25rem; }
    .gcl-access-actions, .gcl-mg-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1rem; }
    .gcl-primary, .gcl-secondary {
        border: 1px solid var(--border); border-radius: 0.5rem; padding: 0.65rem 1rem; cursor: pointer; text-decoration: none; display: inline-block;
    }
    .gcl-primary { background: var(--accent); color: var(--accent-contrast, #fff); border-color: var(--accent-border); }
    .gcl-secondary { background: var(--surface-raised); color: var(--text); }
    .gcl-mg-header { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; margin-bottom: 1.5rem; }
    .gcl-mg-header-actions { display: flex; gap: 1rem; }
    .gcl-mg-header-actions a { color: var(--accent); }
    .gcl-mg-board { display: grid; grid-template-columns: 1.6fr 0.9fr; gap: 1.25rem; }
    .gcl-mg-mission-card, .gcl-mg-side {
        background: var(--surface); border: 1px solid var(--border); border-radius: 0.85rem; padding: 1.25rem;
    }
    .gcl-mg-broken pre {
        background: var(--bg); padding: 0.85rem; border-radius: 0.5rem; overflow: auto; font-size: 0.85rem; border: 1px solid var(--border);
    }
    .gcl-mg-editor {
        width: 100%; background: var(--bg); color: var(--text); border: 1px solid var(--border);
        border-radius: 0.5rem; padding: 0.75rem; font-family: ui-monospace, monospace; font-size: 0.9rem;
    }
    .gcl-mg-feedback.ok { color: #4ade80; }
    .gcl-mg-feedback.bad { color: #f87171; }
    .gcl-mg-side ul { list-style: none; padding: 0; }
    .gcl-mg-side li { padding: 0.4rem 0; opacity: 0.7; }
    .gcl-mg-side li.active { opacity: 1; color: var(--accent); }
    .gcl-mg-side li.cleared { opacity: 1; color: #4ade80; }
    .gcl-mg-hint { opacity: 0.85; color: var(--text-muted); }
    @@media (max-width: 900px) {
        .gcl-mg-board { grid-template-columns: 1fr; }
    }
</style>

@code {
    private bool AccessReady;
    private bool AccessGranted;
    private bool ProgressLoadFailed;
    private int CompletedChapterModules;
    private int CurrentMissionIndex;
    private string PlayerCode = string.Empty;
    private string Feedback = string.Empty;
    private bool LastCheckPassed;
    private bool[] MissionCleared = Array.Empty<bool>();

    private sealed record GclMission(
        string Title,
        string Brief,
        string BrokenCode,
        string SolutionNormalized,
        string Hint,
        string[] RequiredFragments);

    private static readonly GclMission[] Missions =
    {
        new GclMission(
            "Variable shell",
            "Declare Mode as Integer and set it to 1 with a short comment above.",
            "Variable Mode As\nMode =",
            "variable mode as integer mode = 1",
            "Use Variable Mode As Integer and Mode = 1. A // comment above is good practice.",
            new[] { "variable mode as integer", "mode = 1" }),
        new GclMission(
            "Guarded enable",
            "When Enable equals 1, set OutCmd to 1 inside If ... Then ... End If.",
            "Variable Enable As Integer\nVariable OutCmd As Integer\nEnable = 1\nOutCmd = 1",
            "if enable = 1 then outcmd = 1 end if",
            "Wrap the OutCmd assignment so it only runs while Enable equals 1.",
            new[] { "if enable = 1 then", "outcmd = 1", "end if" }),
        new GclMission(
            "Rising-edge reset",
            "Clear FailLatched with IfOnce when Reset equals 1.",
            "Variable Reset As Integer\nVariable FailLatched As Integer\nReset = 1\nFailLatched = 1\nIf Reset = 1 Then\n  FailLatched = 0\nEnd If",
            "ifonce reset = 1 then faillatched = 0 end if",
            "Replace If with IfOnce so the clear is edge-triggered.",
            new[] { "ifonce reset = 1 then", "faillatched = 0", "end if" }),
        new GclMission(
            "Prove timer alarm",
            "Latch FanAlarm when FanCmd is 1 and FanStatus is 0 OnFor 30S.",
            "Variable FanCmd As Integer\nVariable FanStatus As Integer\nVariable FanAlarm As Integer\nIf FanStatus = 0 Then\n  FanAlarm = 1\nEnd If",
            "if fancmd = 1 and fanstatus = 0 onfor 30s then fanalarm = 1 end if",
            "Require both the command and the failed status, then prove with OnFor 30S.",
            new[] { "fancmd = 1", "fanstatus = 0", "onfor 30s", "fanalarm = 1" }),
        new GclMission(
            "Limited damper command",
            "Set Cmd to Limit(PidOut + Bias, MinPos, 100.0).",
            "Variable PidOut As Real\nVariable Bias As Real\nVariable MinPos As Real\nVariable Cmd As Real\nCmd = PidOut",
            "cmd = limit(pidout + bias, minpos, 100.0)",
            "Add Bias inside Limit and pass MinPos as the low bound.",
            new[] { "limit(", "pidout + bias", "minpos", "100" })
    };

    private GclMission CurrentMission => Missions[CurrentMissionIndex];

    protected override async Task OnInitializedAsync()
    {
        MissionCleared = new bool[Missions.Length];
        try
        {
            CourseProgressSnapshot progress =
                await CourseEngine.GetProgressAsync(CourseIds.Gcl);

            CompletedChapterModules = 0;
            int limit = Math.Min(8, progress.ModuleCompleted?.Length ?? 0);
            for (int i = 0; i < limit; i++)
            {
                if (progress.ModuleCompleted[i])
                {
                    CompletedChapterModules++;
                }
            }

            AccessGranted = CompletedChapterModules >= 8;
            if (AccessGranted)
            {
                PlayerCode = CurrentMission.BrokenCode;
            }
        }
        catch
        {
            ProgressLoadFailed = true;
            AccessGranted = false;
        }
        finally
        {
            AccessReady = true;
        }
    }

    private void ResetEditor()
    {
        PlayerCode = CurrentMission.BrokenCode;
        Feedback = string.Empty;
        LastCheckPassed = false;
    }

    private async Task CheckRepairAsync()
    {
        string normalized = Normalize(PlayerCode);
        bool ok = true;

        foreach (string fragment in CurrentMission.RequiredFragments)
        {
            if (!normalized.Contains(fragment, StringComparison.Ordinal))
            {
                ok = false;
                break;
            }
        }

        LastCheckPassed = ok;
        if (ok)
        {
            MissionCleared[CurrentMissionIndex] = true;
            Feedback = "Sequence restored. Required control tokens are present.";
            try
            {
                await ProgressionService.AwardMinigameRunAsync(
                    CourseIds.Gcl,
                    $"gcl-mission-{CurrentMissionIndex + 1}",
                    25,
                    normalized.Length);
            }
            catch
            {
                // Local award is best-effort when services differ by environment.
            }
        }
        else
        {
            Feedback = "Not yet. Compare your line to the hint and required keywords.";
        }
    }

    private void NextMission()
    {
        if (CurrentMissionIndex < Missions.Length - 1)
        {
            CurrentMissionIndex++;
            PlayerCode = CurrentMission.BrokenCode;
            Feedback = string.Empty;
            LastCheckPassed = false;
        }
        else
        {
            Feedback = "All Control Line Lab missions cleared.";
            LastCheckPassed = true;
        }
    }

    private static string Normalize(string source)
    {
        if (string.IsNullOrWhiteSpace(source))
        {
            return string.Empty;
        }

        return string.Join(
            " ",
            source
                .Replace("\r", " ")
                .Replace("\n", " ")
                .ToLowerInvariant()
                .Split(' ', StringSplitOptions.RemoveEmptyEntries));
    }
}
