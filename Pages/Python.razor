            "print(f\"{name}: {value}\")",
            "facility_name = \"Crystal Cavern\"\noperator = input(\"Enter operator name: \")\ntemperature = 18.5\npressure = 42.0\nfan_running = True\nprint(f\"{facility_name} | {operator} | {temperature}°C | {pressure} PSI | Fan: {fan_running}\")",
            "facility_name = \"___\"\noperator = input(\"___\")\ntemperature = ___\npressure = ___\nfan_running = ___\nprint(f\"{facility_name} | {operator} | {temperature}°C | {pressure} PSI | Fan: {fan_running}\")",
            "What does the f before the final string allow?",
            new[] { "The string becomes a file", "The line repeats forever", "Variables can be inserted with braces", "The values become Booleans" },
            2,
            "An f-string inserts expressions written inside braces.",
            "facility_name = \"Crystal Cavern\"\noperator = input(\"Enter operator name: \")\ntemperature = \"18.5\"\npressure = 42.0\nfan_running = true\nprint(\"{facility_name} | {operator} | {temperature}\")",
            "Repair the numeric temperature, Boolean capitalization, and missing f-string prefix.",
            /* CAVECODE_PYTHON_MODULE_8_RECALLPROMPT_REPAIR */
        /* CAVECODE_PYTHON_MODULE_8_RECALLPROMPT_REPAIR */
        "Rebuild the complete startup summary from memory. Use these exact identifiers: f, facility_name, fan_running, input, operator, pressure, print, temperature. Use these exact values: 18.5, 42.0, \"Crystal Cavern\", \"Enter operator name: \", True, \"{facility_name} | {operator} | {temperature}°C | {pressure} PSI | Fan: {fan_running}\".",
