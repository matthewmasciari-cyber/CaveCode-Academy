    private string ExercisePrompt(TrainingStage stage) => stage switch
    {
        TrainingStage.Guided => "The target remains visible. Correct characters turn green and incorrect characters turn red.",
        TrainingStage.Fill => "The editor begins with missing pieces. Replace every blank so the line becomes valid Python.",
        TrainingStage.Debug => CurrentLesson.DebugPrompt,
        TrainingStage.Recall => CurrentLesson.RecallPrompt,
        TrainingStage.Transfer => CurrentLesson.TransferPrompt,
        _ => ""
    };

    private string NextStageLabel()
    {
        TrainingStage next = (int)CurrentStage < (int)TrainingStage.Complete
            ? (TrainingStage)((int)CurrentStage + 1)
            : TrainingStage.Complete;

        return StageLabel(next).ToLowerInvariant();
    }

    private IEnumerable<string> ConceptPoints(Lesson lesson)
    {
        yield return "Read Python from top to bottom and use indentation to show which lines belong together.";
        yield return "Python is case-sensitive, so True, False, variable names, and function names must match exactly.";
        yield return "The facility preview applies this module's automation result after you pass a stage.";
    }

    private PreviewState Preview
    {
        get
        {
            PreviewState state = new();

            for (int index = 0; index < Lessons.Count; index++)
            {
                if (ModuleCompleted[index])
                {
                    ApplyPreviewEffect(state, index + 1);
                }
            }

            if (!ModuleCompleted[CurrentModuleIndex] && StagePassed)
            {
                ApplyPreviewEffect(state, CurrentModuleIndex + 1);
            }

            return state;
        }
    }

