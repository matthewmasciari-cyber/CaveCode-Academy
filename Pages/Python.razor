            "facility_name == \"Crystal Cavern\"",
            "Use one equals sign for assignment; two equals signs compare values.",
            "Create facility_name with the text \"Crystal Cavern\".",
            "Create controller_name with the text \"Cave Pi 1\".",
            "controller_name = \"Cave Pi 1\"",
