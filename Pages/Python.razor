@page "/python"
@using System.Text.RegularExpressions
@using System.Linq
@using System.Text.Json.Serialization
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject AchievementService AchievementService
@inject ProgressionService ProgressionService

<PageTitle>Python Automation Quest | CaveCode Academy</PageTitle>

<div class="academy">
    <aside class="sidebar">
        <!-- CAVECODE_OFFICIAL_BRANDING_PASS_2_V1 -->
        <div class="cavecode-course-academy-brand"
             aria-label="CaveCode Academy">
            <span class="cavecode-context-logo-surface cavecode-context-logo-surface--course">
                <img class="cavecode-context-logo-image"
                     src="branding/cavecode-academy-logo.svg?v=1"
                     alt="" />
            </span>
        </div>
        <div class="brand">
            <span class="brand-mark">Py</span>
            <div>
                <h1>Python Quest</h1>
                    <!-- CAVECODE_OFFICIAL_BRANDING_PASS_3_V1 -->
            </div>
        </div>

        <nav class="course-nav" aria-label="Course navigation">
            <AcademyHomeButton Compact="true" />
        </nav>

        <AuthPanel />

        @* CAVECODE_SHARED_PROGRESS_PANEL_86A *@
        <CourseProgressPanel
            Label="Course progress"
            CompletedModules="@CompletedModuleCount"
            TotalModules="@Lessons.Count" />

        <div class="lesson-list">
            @{
                string? lastChapter = null;
            }

            @for (int index = 0; index < Lessons.Count; index++)
            {
                int lessonIndex = index;
                Lesson lesson = Lessons[index];
                bool unlocked = IsLessonUnlocked(index);
                bool active = index == CurrentModuleIndex;

                if (lesson.Chapter != lastChapter)
                {
                    lastChapter = lesson.Chapter;
                    <h2>@lesson.Chapter</h2>
                }

                <button type="button"
                        class="lesson-button @(active ? "active" : "") @(ModuleCompleted[index] ? "complete" : "")"
                        disabled="@(!unlocked)"
                        @onclick="() => SelectLesson(lessonIndex)">
                    <span class="lesson-number">
                        @if (ModuleCompleted[index])
                        {
                            <span class="lesson-complete-mark">✓</span>
                        }
                        else if (unlocked)
                        {
                            <span>@(index + 1)</span>
                        }
                        else
                        {
                            <LockMark Compact="true" />
                        }
                    </span>
                    <span class="lesson-copy">
                        <strong class="cavecode-lesson-title" style="display:block; width:100%; min-width:0; max-width:100%; white-space:normal !important; overflow:visible !important; text-overflow:clip !important; overflow-wrap:anywhere; word-break:normal; line-height:1.3;">@lesson.Title</strong>
                        <small>@ModuleMastery(index)% mastery</small>
                    </span>
                </button>
            }
        </div>
    </aside>

    <main class="lesson-main">
        <header class="lesson-header">
            <div>
                <p class="eyebrow">MODULE @(CurrentModuleIndex + 1) OF @Lessons.Count · @CurrentLesson.Topic.ToUpperInvariant()</p>
                <h2>@CurrentLesson.Title</h2>
                <p>@CurrentLesson.Teaching</p>
            </div>
            <div class="mastery-ring">
                <strong>@ModuleMastery(CurrentModuleIndex)%</strong>
                <span>mastery</span>
            </div>
        </header>

        @* CAVECODE_SHARED_STAGE_TABS_86B *@
        <CourseStageTabs
            AriaLabel="Training stages"
            CurrentStage="@((int)CurrentStage)"
            HighestCompletedStage="@SharedHighestCompletedStage"
            UnlockedThroughStage="@SharedUnlockedThroughStage"
            StageSelected="@SelectSharedStage" />

        <section class="stage-card">
            <div class="stage-heading">
                <div>
                    <p class="eyebrow">STAGE @((int)CurrentStage + 1) · @StageLabel(CurrentStage).ToUpperInvariant()</p>
                    <h3>@StageHeading(CurrentStage)</h3>
                </div>
                <span class="support-badge">@SupportLabel(CurrentStage)</span>
            </div>

            @if (CurrentStage == TrainingStage.Learn)
            {
                <div class="learn-grid">
                    <div>
                        <h4>Understand the idea</h4>
                        <p>@CurrentLesson.Teaching</p>

                        <div class="reference-example">
                            <span>Reference example</span>
                            <pre><code>@CurrentLesson.ExampleCode</code></pre>
                        </div>

                        <div class="concept-points">
                            @foreach (string point in ConceptPoints(CurrentLesson))
                            {
                                <div><span>•</span><p>@point</p></div>
                            }
                        </div>
                    </div>

                    <div class="memory-aid">
                        <span class="mini-label">Visual memory aid</span>
                        <div class="flow">
                            <div>CODE</div><span>→</span><div>SIGNAL</div><span>→</span><div>FACILITY</div>
                        </div>
                        <p>@CurrentLesson.PreviewMessage</p>
                    </div>
                </div>

                <button type="button" class="primary" @onclick="CompleteLearnStage">
                    Begin guided typing →
                </button>
            }
            else if (CurrentStage == TrainingStage.Predict)
            {
                <div class="prediction-card">
                    <h4>Predict before running</h4>
                    <p>@CurrentLesson.PredictionQuestion</p>

                    <div class="prediction-options">
                        @for (int index = 0; index < CurrentLesson.PredictionOptions.Length; index++)
                        {
                            int optionIndex = index;
                            string option = CurrentLesson.PredictionOptions[index];

                            <button type="button"
                                    class="@PredictionClass(index)"
                                    @onclick="() => SelectPrediction(optionIndex)">
                                <span>@((char)('A' + index))</span>
                                @option
                            </button>
                        }
                    </div>

                    @if (SelectedPrediction.HasValue)
                    {
                        <div class="feedback @(StagePassed ? "success" : "error")">
                            @Feedback
                        </div>
                    }
                </div>

                @if (StagePassed)
                {
                    <button type="button" class="primary" @onclick="AdvanceStage">
                        Continue to debugging →
                    </button>
                }
            }
            else if (CurrentStage == TrainingStage.Complete)
            {
                <div class="completion-panel">
                    <div class="completion-icon">✓</div>
                    <h3>Module mastery reached</h3>
                    <p>You practiced the concept through explanation, copying, completion, prediction, debugging, recall, and transfer.</p>

                    <div class="completion-summary">
                        <div><span>Concept</span><strong>@CurrentLesson.Topic</strong></div>
                        <div><span>Core code</span><code>@CurrentLesson.TargetCode</code></div>
                        <div><span>Facility result</span><strong>@CurrentLesson.PreviewMessage</strong></div>
                    </div>

                    <button type="button" class="primary" @onclick="FinishModule">
                        @(CurrentModuleIndex == Lessons.Count - 1 ? "Finish the course" : "Complete module and unlock next →")
                    </button>
                </div>
            }
            else
            {
                <div class="exercise-intro">
                    <h4>@ExerciseTitle(CurrentStage)</h4>
                    <p>@ExercisePrompt(CurrentStage)</p>
                </div>

                @if (CurrentStage == TrainingStage.Debug)
                {
                    <div class="compiler-note">
                        <strong>Compiler clue</strong>
                        <p>@CurrentLesson.DebugPrompt</p>
                    </div>
                }

                @if (ShowTargetGuide)
                {
                    <div class="typing-guide">
                        <div class="editor-bar">
                            <span>target.py</span>
                            <span>FOLLOW ALONG</span>
                        </div>
                        <div class="character-guide">
                            @for (int index = 0; index < CurrentExpectedCode.Length; index++)
                            {
                                char character = CurrentExpectedCode[index];
                                string cssClass = GetCharacterClass(index);

                                if (character == '\n')
                                {
                                    <span class="@cssClass newline-mark">↵</span><br />
                                }
                                else if (character == ' ')
                                {
                                    <span class="@cssClass space-mark">&nbsp;</span>
                                }
                                else
                                {
                                    <span class="@cssClass">@character</span>
                                }
                            }
                        </div>
                    </div>
                }
                else if (HintVisible)
                {
                    <div class="revealed-target">
                        <span>Hint target</span>
                        <pre><code>@CurrentExpectedCode</code></pre>
                    </div>
                }

                @* CAVECODE_SHARED_CODE_EDITOR_86C *@
                <CourseCodeEditor
                    FileName="facility_training.py"
                    LanguageLabel="PYTHON"
                    AriaLabel="Python practice editor"
                    @bind-Value="StudentCode"
                    TargetLength="@CurrentExpectedCode.Length"
                    Accuracy="@Accuracy"
                    ErrorCount="@ErrorCount" />

                @* CAVECODE_SHARED_EXERCISE_ACTIONS_86D *@
                <CourseExerciseActions
                    Feedback="@Feedback"
                    StagePassed="@StagePassed"
                    ContinueLabel="@NextStageLabel()"
                    OnCheck="@CheckCode"
                    OnHint="@ShowHint"
                    OnReset="@ResetStage"
                    OnContinue="@AdvanceStage" />
            }
        </section>
    </main>

    <aside class="preview-panel">
        <header class="preview-header">
            <div>
                <p class="eyebrow">LIVE FACILITY PREVIEW</p>
                <h2>@Preview.FacilityName</h2>
            </div>
            <span class="live">LIVE</span>
        </header>

        <div class="facility-diagram">
            <div class="facility-titlebar">
                <span>CRYSTAL CAVERN CONTROL</span>
                <span>@Preview.Mode</span>
            </div>
            <div class="equipment-grid">
                <div class="equipment-node @(Preview.DoorClosed ? "active" : "")">
                    <span>DOOR</span>
                    <strong>@(Preview.DoorClosed ? "CLOSED" : "OPEN")</strong>
                </div>
                <div class="equipment-node @(Preview.FanRunning ? "active" : "")">
                    <span>FAN</span>
                    <strong>@(Preview.FanRunning ? "RUNNING" : "OFF")</strong>
                </div>
                <div class="equipment-node @(Preview.PumpRunning ? "active" : "")">
                    <span>PUMP</span>
                    <strong>@(Preview.PumpRunning ? "RUNNING" : "OFF")</strong>
                </div>
                <div class="equipment-node @(Preview.AlarmActive ? "alarm" : "active")">
                    <span>ALARM</span>
                    <strong>@(Preview.AlarmActive ? "ACTIVE" : "NORMAL")</strong>
                </div>
            </div>
            <div class="signal-line"></div>
            <div class="controller-node">
                <span>PYTHON CONTROLLER</span>
                <strong>@Preview.Status</strong>
            </div>
        </div>

        <div class="preview-stats">
            <div><span>Temperature</span><strong>@Preview.Temperature.ToString("0.0") °C</strong></div>
            <div><span>Pressure</span><strong>@Preview.Pressure.ToString("0.0") PSI</strong></div>
            <div><span>Oxygen</span><strong>@Preview.Oxygen.ToString("0.0")%</strong></div>
            <div><span>Mode</span><strong>@Preview.Mode</strong></div>
            <div><span>Sensors</span><strong>@Preview.SensorCount online</strong></div>
            <div><span>Cycles</span><strong>@Preview.CycleCount</strong></div>
        </div>

        <div class="health-track">
            <div class="health-fill" style="width: @(Math.Clamp(Preview.Readiness, 0, 100))%"></div>
        </div>

        <section class="inventory-card">
            <span>Data and logging</span>
            <strong>@Preview.DataPoints readings · @Preview.LogStatus</strong>
        </section>

        <section class="terminal">
            <div class="terminal-title">
                <span>AUTOMATION TERMINAL</span>
                <span>READ ONLY</span>
            </div>
            <p>[ACADEMY] Python module @(CurrentModuleIndex + 1) loaded.</p>
            <p>[STAGE] @StageLabel(CurrentStage) training active.</p>
            <p>[@(StagePassed ? "PASS" : "READY")] @(StagePassed ? CurrentLesson.PreviewMessage : Preview.Status)</p>
        </section>
    </aside>
</div>

@if (ShowXpAward && LastProgressAward is not null)
{
    <button type="button"
            class="xp-award-toast"
            @onclick="DismissXpAward">
        <span>MODULE REWARD</span>
        <strong>+@LastProgressAward.XpAwarded XP</strong>
        <small>
            Level @LastProgressAward.State.Level
            · @LastProgressAward.State.TotalXp total XP
        </small>
    </button>
}
@if (ShowAchievementUnlock && ChapterAchievement is not null)
{
    <div class="achievement-unlock-overlay"
         role="presentation"
         @onclick="DismissAchievementUnlock">
        <section class="achievement-unlock-dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="achievement-unlock-title"
                 @onclick:stopPropagation="true">
            <span class="achievement-unlock-kicker">
                CHAPTER @ChapterAchievement.Chapter COMPLETE
            </span>
            <div class="achievement-unlock-medal">◆</div>
            <h2 id="achievement-unlock-title">
                @ChapterAchievement.Name
            </h2>
            <p>@ChapterAchievement.Description</p>

            <div class="achievement-unlock-rewards">
                <div>
                    <span>TITLE REWARD</span>
                    <strong>@ChapterAchievement.TitleReward</strong>
                </div>
                <div>
                    <span>CODE CRYSTALS</span>
                    <strong>◆ @ChapterAchievement.Crystals</strong>
                </div>
            </div>

            <small>
                Reward unlocked. Visit Achievements to claim it.
            </small>

                        <div class="minigame-unlock-note">
                <span>MINIGAME PRACTICE UNLOCKED</span>
                <strong>
                    Chapter @ChapterAchievement.Chapter ·
                    8 unique randomized rooms
                </strong>
                <small>
                    Focus on this chapter or combine every completed
                    chapter in a cumulative mastery campaign.
                </small>
            </div>

            <div class="achievement-unlock-actions mastery-actions">
                <NavLink href="/minigames/python">
                    Practice chapter
                </NavLink>
                <NavLink href="/achievements">
                    View achievement
                </NavLink>
                <button type="button"
                        @onclick="DismissAchievementUnlock">
                    Continue learning
                </button>
            </div>
        </section>
    </div>
}

@if (ShowChapterOneSignInPrompt)
{
    <div class="save-progress-overlay" role="presentation" @onclick="DismissSavePrompt">
        <section class="save-progress-dialog" role="dialog" aria-modal="true" aria-labelledby="save-progress-title" @onclick:stopPropagation="true">
            <span class="save-progress-kicker">CHAPTER 1 COMPLETE</span>
            <h2 id="save-progress-title">Protect your CaveCode progress</h2>
            <p>Great work—you finished Foundations. Sign in now and CaveCode will return you to Chapter 2 after authentication.</p>
            <AuthPanel />
            <button type="button" class="continue-guest" @onclick="DismissSavePrompt">Continue without signing in</button>
            <small>Your current course position is already preserved on this device.</small>
        </section>
    </div>
}

<!-- CAVECODE_PYTHON_CSS_EXTRACTION_85B -->
<link rel="stylesheet" href="css/python-course.css?v=85b" />

@code {
    private enum TrainingStage
    {
        Learn,
        Guided,
        Fill,
        Predict,
        Debug,
        Recall,
        Transfer,
        Complete
    }

    private sealed record Lesson(
        string Chapter,
        string Topic,
        string Title,
        string Teaching,
        string ExampleCode,
        string TargetCode,
        string FillStarter,
        string PredictionQuestion,
        string[] PredictionOptions,
        int PredictionCorrect,
        string PredictionExplanation,
        string BrokenCode,
        string DebugPrompt,
        string RecallPrompt,
        string TransferPrompt,
        string TransferCode,
        string PreviewMessage
    );

    private sealed class CourseProgressSnapshot
    {
        [JsonPropertyName("currentModuleIndex")]
        public int CurrentModuleIndex { get; set; }

        [JsonPropertyName("currentStage")]
        public int CurrentStage { get; set; }

        [JsonPropertyName("highestCompletedStage")]
        public int[] HighestCompletedStage { get; set; } = Array.Empty<int>();

        [JsonPropertyName("moduleCompleted")]
        public bool[] ModuleCompleted { get; set; } = Array.Empty<bool>();
    }

    private sealed class PreviewState
    {
        public string FacilityName { get; set; } = "Crystal Cavern";
        public double Temperature { get; set; } = 18.5;
        public double Pressure { get; set; } = 42.0;
        public double Oxygen { get; set; } = 20.9;
        public string Mode { get; set; } = "OFF";
        public bool FanRunning { get; set; }
        public bool PumpRunning { get; set; }
        public bool AlarmActive { get; set; }
        public bool DoorClosed { get; set; }
        public int SensorCount { get; set; } = 1;
        public int CycleCount { get; set; }
        public int DataPoints { get; set; }
        public int Readiness { get; set; }
        public string LogStatus { get; set; } = "No log yet";
        public string Status { get; set; } = "Complete the current training stage.";
    }

    private static readonly List<Lesson> Lessons = new()
    {
        new Lesson(
            "Chapter 1 · Control-Room Foundations",
            "Output",
            "Boot the Control Terminal",
            "Python uses print() to send text to the terminal. Text belongs inside quotation marks.",
            "print(\"System ready\")",
            "print(\"Cave control terminal online.\")",
            "print(\"___\")",
            "What does print() do?",
            new[] { "Repeats a loop", "Stores a password", "Creates a sensor", "Displays a value in the terminal" },
            3,
            "print() displays the value placed inside its parentheses.",
            "print(Cave control terminal online.)",
            "The message is text, so it needs quotation marks.",
            /* CAVECODE_PYTHON_MODULE_1_RECALLPROMPT_REPAIR */
        "From memory, display \"Cave control terminal online.\". Use the exact identifier print.",
            /* CAVECODE_PYTHON_MODULE_1_TRANSFERPROMPT_REPAIR */
        "Display \"Ventilation controller ready.\". Use the exact identifier print.",
            "print(\"Ventilation controller ready.\")",
            "The facility terminal now displays a startup message."
        ),
        new Lesson(
            "Chapter 1 · Control-Room Foundations",
            "Variables",
            "Name the Facility",
            "A variable gives a value a reusable name. Python creates the variable when you assign a value with =.",
            "zone_name = \"North Tunnel\"",
            "facility_name = \"Crystal Cavern\"",
            "facility_name = \"___\"",
            "Which symbol assigns a value to a variable?",
            new[] { ":", "==", "#", "=" },
