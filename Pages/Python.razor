    private PreviewState Preview
    {
        get
        {
            PreviewState state = new();

            for (int index = 0; index < Lessons.Count; index++)
            {
                if (ModuleCompleted[index])
                {
                    ApplyPreviewEffect(state, index + 1);
                }
            }

            if (!ModuleCompleted[CurrentModuleIndex] && StagePassed)
            {
                ApplyPreviewEffect(state, CurrentModuleIndex + 1);
            }

            return state;
        }
    }

