        Session.IsStageComplete((int)stage);

    // CAVECODE_COURSE_SESSION_TRANSITIONS_87B
    private void SelectLesson(int index)
    {
        if (!Session.TrySelectLesson(
                index,
                CourseStageCatalog.StageCount))
        {
            return;
        }

        PrepareStage();
    }


    // CAVECODE_SHARED_STAGE_TABS_86B
    private int SharedHighestCompletedStage =>
        ModuleCompleted[CurrentModuleIndex]
            ? CourseStageCatalog.StageCount - 1
            : HighestCompletedStage[CurrentModuleIndex];

    private int SharedUnlockedThroughStage =>
        ModuleCompleted[CurrentModuleIndex]
            ? CourseStageCatalog.StageCount - 1
            : Math.Clamp(
                HighestCompletedStage[CurrentModuleIndex] + 1,
                0,
                CourseStageCatalog.StageCount - 1);

    private void SelectSharedStage(int stageIndex) =>
        SelectStage((TrainingStage)stageIndex);

    private void SelectStage(TrainingStage stage)
    {
        if (!Session.TrySelectStage((int)stage))
        {
            return;
        }

        PrepareStage();
    }

    private void PrepareStage()
    {
        Feedback = "";
        HintVisible = false;
        SelectedPrediction = null;

        bool alreadyComplete =
            ModuleCompleted[CurrentModuleIndex] ||
            (int)CurrentStage <= HighestCompletedStage[CurrentModuleIndex];

        StagePassed = alreadyComplete;

        StudentCode = CurrentStage switch
        {
            TrainingStage.Guided => alreadyComplete ? CurrentLesson.TargetCode : "",
            TrainingStage.Fill => alreadyComplete ? CurrentLesson.TargetCode : CurrentLesson.FillStarter,
            TrainingStage.Debug => alreadyComplete ? CurrentLesson.TargetCode : CurrentLesson.BrokenCode,
            TrainingStage.Recall => alreadyComplete ? CurrentLesson.TargetCode : "",
            TrainingStage.Transfer => alreadyComplete ? CurrentLesson.TransferCode : "",
            _ => ""
        };
    }

    private string CurrentExpectedCode => CurrentStage switch
    {
        TrainingStage.Guided => CurrentLesson.TargetCode,
        TrainingStage.Fill => CurrentLesson.TargetCode,
        TrainingStage.Debug => CurrentLesson.TargetCode,
        TrainingStage.Recall => CurrentLesson.TargetCode,
        TrainingStage.Transfer => CurrentLesson.TransferCode,
        _ => ""
    };

    private bool ShowTargetGuide =>
        CurrentStage is TrainingStage.Guided or TrainingStage.Fill;

    private int ErrorCount
    {
        get
        {
            if (string.IsNullOrEmpty(CurrentExpectedCode))
            {
                return 0;
            }

            int errors = 0;

            for (int index = 0; index < StudentCode.Length; index++)
            {
                if (index >= CurrentExpectedCode.Length ||
                    StudentCode[index] != CurrentExpectedCode[index])
                {
                    errors++;
                }
            }

            return errors;
        }
    }

    private int Accuracy
    {
        get
        {
            if (StudentCode.Length == 0)
            {
                return 0;
            }

            int correct = Math.Max(0, StudentCode.Length - ErrorCount);
            return correct * 100 / StudentCode.Length;
        }
    }

    private string GetCharacterClass(int index)
    {
        if (index >= StudentCode.Length)
        {
            return index == StudentCode.Length
                ? "character-current"
                : "character-pending";
        }

        return StudentCode[index] == CurrentExpectedCode[index]
            ? "character-correct"
            : "character-wrong";
    }

    private void CompleteLearnStage()
    {
        MarkStageComplete();
        AdvanceStage();
    }

    private async Task CheckCode()
    {
        HintVisible = false;

        if (CodesMatch(StudentCode, CurrentExpectedCode))
        {
            StagePassed = true;
            Feedback = CurrentStage switch
            {
                TrainingStage.Debug => "Correct repair. The broken code now matches the intended Python.",
                TrainingStage.Recall => "Correct recall. You rebuilt the code without the visible guide.",
                TrainingStage.Transfer => "Correct transfer. You applied the concept to a new situation.",
                _ => "Correct. Every required part of the code is present."
            };
            await ProgressionService.AwardStageAsync(
                "python",
                CurrentModuleIndex,
                (int)CurrentStage,
                StudentCode
            );
        }
        else
        {
            StagePassed = false;
            Feedback = CurrentStage switch
            {
                TrainingStage.Debug => "The bug is not fully repaired yet. Use the compiler clue and inspect each token.",
                TrainingStage.Recall => "Not yet. Rebuild the same structure from memory, or reveal the hint.",
                TrainingStage.Transfer => "The new scenario is close, but the code does not match the requested result.",
                _ => "Not quite. Red characters differ from the target code."
            };
        }
    }

    private static bool CodesMatch(string actual, string expected)
    {
        string Normalize(string code) =>
            Regex.Replace(code.Replace("\r\n", "\n").Trim(), @"\s+", " ");

        return Normalize(actual) == Normalize(expected);
    }

    private void SelectPrediction(int index)
    {
        SelectedPrediction = index;

        if (index == CurrentLesson.PredictionCorrect)
        {
            StagePassed = true;
            Feedback = "Correct. " + CurrentLesson.PredictionExplanation;
        }
        else
        {
            StagePassed = false;
            Feedback = "Not quite. Think about the exact Python rule demonstrated in the example.";
        }
    }

    private string PredictionClass(int index)
    {
        if (!SelectedPrediction.HasValue)
        {
            return "";
        }

        if (index == CurrentLesson.PredictionCorrect)
        {
            return "correct";
        }

        return index == SelectedPrediction.Value ? "wrong" : "";
    }

    private void ShowHint()
    {
        HintVisible = true;
    }

    private void ResetStage()
    {
        PrepareStage();
    }

    private void AdvanceStage()
    {
        MarkStageComplete();

        if ((int)CurrentStage < (int)TrainingStage.Complete)
        {
            CurrentStage = (TrainingStage)((int)CurrentStage + 1);
            PrepareStage();
        }
    }

    private void MarkStageComplete() =>
        Session.MarkCurrentStageComplete();

    private async Task FinishModule()
    {
        int finishedModuleIndex = CurrentModuleIndex;

        Session.CompleteModule(
            finishedModuleIndex,
            CourseStageCatalog.StageCount);

        ProgressionAwardResult progressionAward =
            await ProgressionService.AwardModuleAsync(
                "python",
                finishedModuleIndex
            );

        if (progressionAward.NewlyAwarded)
        {
            LastProgressAward = progressionAward;
            ShowXpAward = true;
        }


        if (Session.MoveToNextModule(Lessons.Count))
        {
            PrepareStage();
        }
        else
        {
            Feedback = "Course complete. You restored and automated the full underground facility.";
            StagePassed = true;
        }

        await SaveProgressAsync();
        await HandleChapterCompletionAsync("python", finishedModuleIndex);

        if (finishedModuleIndex == ChapterOneLastModuleIndex)
        {
            bool signedIn = false;

            try
            {
                signedIn = await JS.InvokeAsync<bool>(
                    "caveCodeAuth.isSignedIn"
                );
            }
            catch
            {
                // If auth is unavailable, the learner can still continue.
            }

            if (!signedIn)
            {
                if (ShowAchievementUnlock)
                {
                    PendingChapterOneSignInPrompt = true;
                }
                else
                {
                    ShowChapterOneSignInPrompt = true;
                }
            }
        }
    }

    private void DismissXpAward()
    {
        ShowXpAward = false;
        LastProgressAward = null;
    }

    private async Task HandleChapterCompletionAsync(
        string course,
        int finishedModuleIndex
    )
    {
        int chapter = ChapterNumberForModule(finishedModuleIndex);

        if (chapter == 0)
        {
            return;
        }

        try
        {
            AchievementUnlockResult? result =
                await AchievementService.UnlockChapterAsync(
                    course,
                    chapter
                );

            if (result is not null && result.NewlyUnlocked)
            {
                ChapterAchievement = result;
                ShowAchievementUnlock = true;
            }
        }
        catch
        {
            // Achievements never interrupt course progression.
        }
    }

    private static int ChapterNumberForModule(int moduleIndex) =>
        moduleIndex is 7 or 15 or 23 or 31 or 39
            ? moduleIndex / 8 + 1
            : 0;

    private void DismissAchievementUnlock()
    {
        ShowAchievementUnlock = false;
        ChapterAchievement = null;

        if (PendingChapterOneSignInPrompt)
        {
            PendingChapterOneSignInPrompt = false;
            ShowChapterOneSignInPrompt = true;
        }
    }

    private async Task SaveProgressAsync()
    {
        CourseProgressSnapshot snapshot = new()
        {
            CurrentModuleIndex = CurrentModuleIndex,
            CurrentStage = (int)CurrentStage,
            HighestCompletedStage = HighestCompletedStage.ToArray(),
            ModuleCompleted = ModuleCompleted.ToArray()
        };

        try
        {
            await JS.InvokeVoidAsync(
                "caveCodeAuth.saveCourseProgressFor",
                "python",
                snapshot
            );
        }
        catch
        {
            // Local progress is optional; never interrupt a lesson for it.
        }
    }

