@page "/python"
@using System.Text.RegularExpressions
@using System.Linq
@using System.Text.Json.Serialization
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject AchievementService AchievementService
@inject ProgressionService ProgressionService

<PageTitle>Python Automation Quest | CaveCode Academy</PageTitle>

<div class="academy">
    <aside class="sidebar">
        <!-- CAVECODE_OFFICIAL_BRANDING_PASS_2_V1 -->
        <div class="cavecode-course-academy-brand"
             aria-label="CaveCode Academy">
            <span class="cavecode-context-logo-surface cavecode-context-logo-surface--course">
                <img class="cavecode-context-logo-image"
                     src="branding/cavecode-academy-logo.svg?v=1"
                     alt="" />
            </span>
        </div>
        <div class="brand">
            <span class="brand-mark">Py</span>
            <div>
                <h1>Python Quest</h1>
                    <!-- CAVECODE_OFFICIAL_BRANDING_PASS_3_V1 -->
            </div>
        </div>

        <nav class="course-nav" aria-label="Course navigation">
            <AcademyHomeButton Compact="true" />
        </nav>

        <AuthPanel />

        <section class="course-progress">
            <div class="row-between">
                <span>Course progress</span>
                <strong>@CourseProgress%</strong>
            </div>
            <div class="progress-track">
                <div class="progress-fill" style="width: @(CourseProgress)%"></div>
            </div>
            <small>@CompletedModuleCount / @Lessons.Count modules complete</small>
        </section>

        <div class="lesson-list">
            @{
                string? lastChapter = null;
            }

            @for (int index = 0; index < Lessons.Count; index++)
            {
                int lessonIndex = index;
                Lesson lesson = Lessons[index];
                bool unlocked = IsLessonUnlocked(index);
                bool active = index == CurrentModuleIndex;

                if (lesson.Chapter != lastChapter)
                {
                    lastChapter = lesson.Chapter;
                    <h2>@lesson.Chapter</h2>
                }

                <button type="button"
                        class="lesson-button @(active ? "active" : "") @(ModuleCompleted[index] ? "complete" : "")"
                        disabled="@(!unlocked)"
                        @onclick="() => SelectLesson(lessonIndex)">
                    <span class="lesson-number">
                        @if (ModuleCompleted[index])
                        {
                            <span class="lesson-complete-mark">✓</span>
                        }
                        else if (unlocked)
                        {
                            <span>@(index + 1)</span>
                        }
                        else
                        {
                            <LockMark Compact="true" />
                        }
                    </span>
                    <span class="lesson-copy">
                        <strong>@lesson.Title</strong>
                        <small>@ModuleMastery(index)% mastery</small>
                    </span>
                </button>
            }
        </div>
    </aside>

    <main class="lesson-main">
        <header class="lesson-header">
            <div>
                <p class="eyebrow">MODULE @(CurrentModuleIndex + 1) OF @Lessons.Count · @CurrentLesson.Topic.ToUpperInvariant()</p>
                <h2>@CurrentLesson.Title</h2>
                <p>@CurrentLesson.Teaching</p>
            </div>
            <div class="mastery-ring">
                <strong>@ModuleMastery(CurrentModuleIndex)%</strong>
                <span>mastery</span>
            </div>
        </header>

        <nav class="stage-tabs" aria-label="Training stages">
            @foreach (TrainingStage stage in Enum.GetValues<TrainingStage>())
            {
                TrainingStage selectedStage = stage;
                bool unlocked = IsStageUnlocked(stage);

                <button type="button"
                        class="stage-tab @(CurrentStage == stage ? "active" : "") @(IsStageComplete(stage) ? "done" : "")"
                        disabled="@(!unlocked)"
                        @onclick="() => SelectStage(selectedStage)">
                    <span>@((int)stage + 1)</span>
                    @StageLabel(stage)
                </button>
            }
        </nav>

        <section class="stage-card">
            <div class="stage-heading">
                <div>
                    <p class="eyebrow">STAGE @((int)CurrentStage + 1) · @StageLabel(CurrentStage).ToUpperInvariant()</p>
                    <h3>@StageHeading(CurrentStage)</h3>
                </div>
                <span class="support-badge">@SupportLabel(CurrentStage)</span>
            </div>

            @if (CurrentStage == TrainingStage.Learn)
            {
                <div class="learn-grid">
                    <div>
                        <h4>Understand the idea</h4>
                        <p>@CurrentLesson.Teaching</p>

                        <div class="reference-example">
                            <span>Reference example</span>
                            <pre><code>@CurrentLesson.ExampleCode</code></pre>
                        </div>

                        <div class="concept-points">
                            @foreach (string point in ConceptPoints(CurrentLesson))
                            {
                                <div><span>•</span><p>@point</p></div>
                            }
                        </div>
                    </div>

                    <div class="memory-aid">
                        <span class="mini-label">Visual memory aid</span>
                        <div class="flow">
                            <div>CODE</div><span>→</span><div>SIGNAL</div><span>→</span><div>FACILITY</div>
                        </div>
                        <p>@CurrentLesson.PreviewMessage</p>
                    </div>
                </div>

                <button type="button" class="primary" @onclick="CompleteLearnStage">
                    Begin guided typing →
                </button>
            }
            else if (CurrentStage == TrainingStage.Predict)
            {
                <div class="prediction-card">
                    <h4>Predict before running</h4>
                    <p>@CurrentLesson.PredictionQuestion</p>

                    <div class="prediction-options">
                        @for (int index = 0; index < CurrentLesson.PredictionOptions.Length; index++)
                        {
                            int optionIndex = index;
                            string option = CurrentLesson.PredictionOptions[index];

                            <button type="button"
                                    class="@PredictionClass(index)"
                                    @onclick="() => SelectPrediction(optionIndex)">
                                <span>@((char)('A' + index))</span>
                                @option
                            </button>
                        }
                    </div>

                    @if (SelectedPrediction.HasValue)
                    {
                        <div class="feedback @(StagePassed ? "success" : "error")">
                            @Feedback
                        </div>
                    }
                </div>

                @if (StagePassed)
                {
                    <button type="button" class="primary" @onclick="AdvanceStage">
                        Continue to debugging →
                    </button>
                }
            }
            else if (CurrentStage == TrainingStage.Complete)
            {
                <div class="completion-panel">
                    <div class="completion-icon">✓</div>
                    <h3>Module mastery reached</h3>
                    <p>You practiced the concept through explanation, copying, completion, prediction, debugging, recall, and transfer.</p>

                    <div class="completion-summary">
                        <div><span>Concept</span><strong>@CurrentLesson.Topic</strong></div>
                        <div><span>Core code</span><code>@CurrentLesson.TargetCode</code></div>
                        <div><span>Facility result</span><strong>@CurrentLesson.PreviewMessage</strong></div>
                    </div>

                    <button type="button" class="primary" @onclick="FinishModule">
                        @(CurrentModuleIndex == Lessons.Count - 1 ? "Finish the course" : "Complete module and unlock next →")
                    </button>
                </div>
            }
            else
            {
                <div class="exercise-intro">
                    <h4>@ExerciseTitle(CurrentStage)</h4>
                    <p>@ExercisePrompt(CurrentStage)</p>
                </div>

                @if (CurrentStage == TrainingStage.Debug)
                {
                    <div class="compiler-note">
                        <strong>Compiler clue</strong>
                        <p>@CurrentLesson.DebugPrompt</p>
                    </div>
                }

                @if (ShowTargetGuide)
                {
                    <div class="typing-guide">
                        <div class="editor-bar">
                            <span>target.py</span>
                            <span>FOLLOW ALONG</span>
                        </div>
                        <div class="character-guide">
                            @for (int index = 0; index < CurrentExpectedCode.Length; index++)
                            {
                                char character = CurrentExpectedCode[index];
                                string cssClass = GetCharacterClass(index);

                                if (character == '\n')
                                {
                                    <span class="@cssClass newline-mark">↵</span><br />
                                }
                                else if (character == ' ')
                                {
                                    <span class="@cssClass space-mark">&nbsp;</span>
                                }
                                else
                                {
                                    <span class="@cssClass">@character</span>
                                }
                            }
                        </div>
                    </div>
                }
                else if (HintVisible)
                {
                    <div class="revealed-target">
                        <span>Hint target</span>
                        <pre><code>@CurrentExpectedCode</code></pre>
                    </div>
                }

                <div class="code-editor">
                    <div class="editor-bar">
                        <span>facility_training.py</span>
                        <span>PYTHON</span>
                    </div>

                    <textarea @bind="StudentCode"
                              @bind:event="oninput"
                              spellcheck="false"
                              aria-label="Python practice editor"></textarea>

                    <div class="typing-stats">
                        <div><span>Characters</span><strong>@StudentCode.Length / @CurrentExpectedCode.Length</strong></div>
                        <div><span>Accuracy</span><strong>@Accuracy%</strong></div>
                        <div><span>Errors</span><strong>@ErrorCount</strong></div>
                    </div>
                </div>

                <div class="action-row">
                    <button type="button" class="primary" @onclick="CheckCode">Check code</button>
                    <button type="button" class="secondary" @onclick="ShowHint">Hint</button>
                    <button type="button" class="secondary" @onclick="ResetStage">Reset</button>
                </div>

                @if (!string.IsNullOrWhiteSpace(Feedback))
                {
                    <div class="feedback @(StagePassed ? "success" : "error")">
                        @Feedback
                    </div>
                }

                @if (StagePassed)
                {
                    <button type="button" class="primary continue-button" @onclick="AdvanceStage">
                        Continue to @NextStageLabel() →
                    </button>
                }
            }
        </section>
    </main>

    <aside class="preview-panel">
        <header class="preview-header">
            <div>
                <p class="eyebrow">LIVE FACILITY PREVIEW</p>
                <h2>@Preview.FacilityName</h2>
            </div>
            <span class="live">LIVE</span>
        </header>

        <div class="facility-diagram">
            <div class="facility-titlebar">
                <span>CRYSTAL CAVERN CONTROL</span>
                <span>@Preview.Mode</span>
            </div>
            <div class="equipment-grid">
                <div class="equipment-node @(Preview.DoorClosed ? "active" : "")">
                    <span>DOOR</span>
                    <strong>@(Preview.DoorClosed ? "CLOSED" : "OPEN")</strong>
                </div>
                <div class="equipment-node @(Preview.FanRunning ? "active" : "")">
                    <span>FAN</span>
                    <strong>@(Preview.FanRunning ? "RUNNING" : "OFF")</strong>
                </div>
                <div class="equipment-node @(Preview.PumpRunning ? "active" : "")">
                    <span>PUMP</span>
                    <strong>@(Preview.PumpRunning ? "RUNNING" : "OFF")</strong>
                </div>
                <div class="equipment-node @(Preview.AlarmActive ? "alarm" : "active")">
                    <span>ALARM</span>
                    <strong>@(Preview.AlarmActive ? "ACTIVE" : "NORMAL")</strong>
                </div>
            </div>
            <div class="signal-line"></div>
            <div class="controller-node">
                <span>PYTHON CONTROLLER</span>
                <strong>@Preview.Status</strong>
            </div>
        </div>

        <div class="preview-stats">
            <div><span>Temperature</span><strong>@Preview.Temperature.ToString("0.0") °C</strong></div>
            <div><span>Pressure</span><strong>@Preview.Pressure.ToString("0.0") PSI</strong></div>
            <div><span>Oxygen</span><strong>@Preview.Oxygen.ToString("0.0")%</strong></div>
            <div><span>Mode</span><strong>@Preview.Mode</strong></div>
            <div><span>Sensors</span><strong>@Preview.SensorCount online</strong></div>
            <div><span>Cycles</span><strong>@Preview.CycleCount</strong></div>
        </div>

        <div class="health-track">
            <div class="health-fill" style="width: @(Math.Clamp(Preview.Readiness, 0, 100))%"></div>
        </div>

        <section class="inventory-card">
            <span>Data and logging</span>
            <strong>@Preview.DataPoints readings · @Preview.LogStatus</strong>
        </section>

        <section class="terminal">
            <div class="terminal-title">
                <span>AUTOMATION TERMINAL</span>
                <span>READ ONLY</span>
            </div>
            <p>[ACADEMY] Python module @(CurrentModuleIndex + 1) loaded.</p>
            <p>[STAGE] @StageLabel(CurrentStage) training active.</p>
            <p>[@(StagePassed ? "PASS" : "READY")] @(StagePassed ? CurrentLesson.PreviewMessage : Preview.Status)</p>
        </section>
    </aside>
</div>

@if (ShowXpAward && LastProgressAward is not null)
{
    <button type="button"
            class="xp-award-toast"
            @onclick="DismissXpAward">
        <span>MODULE REWARD</span>
        <strong>+@LastProgressAward.XpAwarded XP</strong>
        <small>
            Level @LastProgressAward.State.Level
            · @LastProgressAward.State.TotalXp total XP
        </small>
    </button>
}
@if (ShowAchievementUnlock && ChapterAchievement is not null)
{
    <div class="achievement-unlock-overlay"
         role="presentation"
         @onclick="DismissAchievementUnlock">
        <section class="achievement-unlock-dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="achievement-unlock-title"
                 @onclick:stopPropagation="true">
            <span class="achievement-unlock-kicker">
                CHAPTER @ChapterAchievement.Chapter COMPLETE
            </span>
            <div class="achievement-unlock-medal">◆</div>
            <h2 id="achievement-unlock-title">
                @ChapterAchievement.Name
            </h2>
            <p>@ChapterAchievement.Description</p>

            <div class="achievement-unlock-rewards">
                <div>
                    <span>TITLE REWARD</span>
                    <strong>@ChapterAchievement.TitleReward</strong>
                </div>
                <div>
                    <span>CODE CRYSTALS</span>
                    <strong>◆ @ChapterAchievement.Crystals</strong>
                </div>
            </div>

            <small>
                Reward unlocked. Visit Achievements to claim it.
            </small>

                        <div class="minigame-unlock-note">
                <span>MINIGAME PRACTICE UNLOCKED</span>
                <strong>
                    Chapter @ChapterAchievement.Chapter ·
                    8 unique randomized rooms
                </strong>
                <small>
                    Focus on this chapter or combine every completed
                    chapter in a cumulative mastery campaign.
                </small>
            </div>

            <div class="achievement-unlock-actions mastery-actions">
                <NavLink href="/minigames/python">
                    Practice chapter
                </NavLink>
                <NavLink href="/achievements">
                    View achievement
                </NavLink>
                <button type="button"
                        @onclick="DismissAchievementUnlock">
                    Continue learning
                </button>
            </div>
        </section>
    </div>
}

@if (ShowChapterOneSignInPrompt)
{
    <div class="save-progress-overlay" role="presentation" @onclick="DismissSavePrompt">
        <section class="save-progress-dialog" role="dialog" aria-modal="true" aria-labelledby="save-progress-title" @onclick:stopPropagation="true">
            <span class="save-progress-kicker">CHAPTER 1 COMPLETE</span>
            <h2 id="save-progress-title">Protect your CaveCode progress</h2>
            <p>Great work—you finished Foundations. Sign in now and CaveCode will return you to Chapter 2 after authentication.</p>
            <AuthPanel />
            <button type="button" class="continue-guest" @onclick="DismissSavePrompt">Continue without signing in</button>
            <small>Your current course position is already preserved on this device.</small>
        </section>
    </div>
}

<style>
    * { box-sizing: border-box; }
    html, body { margin: 0; min-height: 100%; background: var(--bg-deep); }
    button, textarea { font: inherit; }

    .academy {
        display: grid;
        grid-template-columns: 280px minmax(520px, 1fr) 360px;
        min-height: 100vh;
        color: var(--text);
        background: var(--bg);
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .sidebar {
        padding: 20px 14px;
        overflow-y: auto;
        background: var(--surface);
        border-right: 1px solid var(--border);
    }

    .brand { display: flex; align-items: center; gap: 12px; padding: 4px 6px 18px; }
    .brand-mark {
        display: grid; width: 46px; height: 46px; place-items: center;
        color: var(--accent-contrast); background: var(--accent); border-radius: 11px; font-weight: 900;
    }
    .brand h1 { margin: 0; font-size: 21px; }
    .brand p { margin: 3px 0 0; color: var(--text-muted); font-size: 12px; line-height: 1.4; }

    .course-nav {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
        margin: 0 0 14px;
    }
    .course-nav a {
        padding: 9px 10px;
        color: var(--text-muted);
        text-align: center;
        text-decoration: none;
        background: var(--surface-raised);
        border: 1px solid var(--border);
        border-radius: 8px;
        font-size: 10px;
        font-weight: 800;
    }
    .course-nav a:hover, .course-nav a.active {
        color: var(--text);
        background: var(--surface-hover);
        border-color: var(--accent-border);
    }

    .course-progress {
        padding: 15px; margin-bottom: 18px; background: var(--surface-raised);
        border: 1px solid var(--border); border-radius: 11px;
    }
    .row-between { display: flex; justify-content: space-between; gap: 12px; font-size: 13px; }
    .progress-track, .health-track {
        height: 9px; margin: 10px 0 8px; overflow: hidden;
        background: var(--surface-strong); border-radius: 99px;
    }
    .progress-fill, .health-fill { height: 100%; background: var(--accent); transition: width .25s ease; }
    .course-progress small { color: var(--text-muted); }

    .lesson-list h2 {
        margin: 20px 8px 8px; color: var(--text-muted); font-size: 11px;
        letter-spacing: .9px; text-transform: uppercase;
    }
    .lesson-button {
        display: flex; width: 100%; align-items: center; gap: 10px;
        padding: 10px; margin-bottom: 6px; color: var(--text);
        text-align: left; background: transparent; border: 1px solid transparent;
        border-radius: 9px; cursor: pointer;
    }
    .lesson-button:hover:not(:disabled) { background: var(--surface-hover); }
    .lesson-button.active { background: var(--accent-surface); border-color: var(--accent-border); }
    .lesson-button.complete { color: var(--accent-soft); }
    .lesson-button:disabled { color: var(--text-dim); cursor: not-allowed; opacity: .62; }
    .lesson-number {
        display: grid; flex: 0 0 31px; height: 31px; place-items: center;
        background: var(--surface-strong); border-radius: 8px; font-size: 12px;
    }
    .lesson-button.active .lesson-number, .lesson-button.complete .lesson-number {
        color: var(--accent-contrast); background: var(--accent);
    }
    .lesson-copy { min-width: 0; }
    .lesson-copy strong, .lesson-copy small { display: block; }
    .lesson-copy strong { overflow: hidden; font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }
    .lesson-copy small { margin-top: 3px; color: var(--text-muted); font-size: 10px; }

    .lesson-main { padding: 28px; overflow-y: auto; }
    .lesson-header {
        display: flex; justify-content: space-between; gap: 24px;
        max-width: 950px; margin: 0 auto;
    }
    .lesson-header h2 { margin: 0 0 7px; font-size: 28px; }
    .lesson-header > div:first-child > p:last-child {
        max-width: 760px; margin: 0; color: var(--text-muted); line-height: 1.55;
    }
    .eyebrow {
        margin: 0 0 6px; color: var(--accent); font-size: 11px;
        font-weight: 850; letter-spacing: 1px;
    }
    .mastery-ring {
        display: grid; flex: 0 0 86px; height: 86px; place-items: center;
        align-content: center; background: var(--accent-surface); border: 2px solid var(--accent-border); border-radius: 50%;
    }
    .mastery-ring strong { font-size: 18px; }
    .mastery-ring span { color: var(--text-muted); font-size: 10px; }

    .stage-tabs {
        display: grid; grid-template-columns: repeat(8, minmax(70px, 1fr));
        max-width: 950px; margin: 23px auto 0; overflow: hidden;
        border: 1px solid var(--border); border-radius: 11px;
    }
    .stage-tab {
        min-height: 57px; padding: 8px 5px; color: var(--text-muted);
        background: var(--surface); border: 0; border-right: 1px solid var(--border);
        cursor: pointer; font-size: 11px;
    }
    .stage-tab:last-child { border-right: 0; }
    .stage-tab span {
        display: grid; width: 21px; height: 21px; margin: 0 auto 4px;
        place-items: center; background: var(--surface-strong); border-radius: 50%; font-size: 10px;
    }
    .stage-tab.active { color: var(--text); background: var(--accent-surface); }
    .stage-tab.active span, .stage-tab.done span { color: var(--accent-contrast); background: var(--accent); }
    .stage-tab:disabled { opacity: .38; cursor: not-allowed; }

    .stage-card {
        max-width: 950px; min-height: 560px; padding: 23px;
        margin: 18px auto 0; background: var(--surface-soft);
        border: 1px solid var(--border); border-radius: 13px;
    }
    .stage-heading { display: flex; justify-content: space-between; gap: 16px; align-items: flex-start; }
    .stage-heading h3 { margin: 0; font-size: 21px; }
    .support-badge {
        padding: 7px 10px; color: var(--warning-text); background: var(--warning-surface);
        border: 1px solid var(--warning-border); border-radius: 99px; font-size: 10px; font-weight: 800;
    }

    .learn-grid { display: grid; grid-template-columns: 1.25fr .75fr; gap: 18px; margin: 23px 0; }
    .learn-grid h4, .exercise-intro h4, .prediction-card h4 { margin: 0 0 8px; font-size: 17px; }
    .learn-grid p, .exercise-intro p, .prediction-card p { color: var(--text-muted); line-height: 1.6; }
    .reference-example, .revealed-target {
        padding: 15px; margin: 16px 0; background: var(--code-bg);
        border: 1px solid var(--surface-strong); border-radius: 9px;
    }
    .reference-example > span, .revealed-target > span, .mini-label {
        color: var(--text-muted); font-size: 10px; font-weight: 800; letter-spacing: .8px; text-transform: uppercase;
    }
    pre { margin: 10px 0 0; overflow: auto; white-space: pre-wrap; }
    code { color: var(--code-text); font-family: Consolas, Monaco, monospace; }
    .concept-points div { display: flex; gap: 9px; }
    .concept-points span { color: var(--accent); }
    .concept-points p { margin: 5px 0; }
    .memory-aid {
        padding: 18px; background: var(--surface-raised); border: 1px solid var(--border); border-radius: 11px;
    }
    .flow { display: flex; align-items: center; justify-content: center; gap: 7px; margin: 20px 0; }
    .flow div { padding: 11px 9px; background: var(--surface-soft); border-radius: 7px; font-size: 11px; font-weight: 800; }
    .flow span { color: var(--accent); }

    .exercise-intro { margin: 22px 0 14px; }
    .compiler-note {
        padding: 13px 15px; margin-bottom: 13px; color: var(--warning-text);
        background: var(--warning-surface); border-left: 4px solid var(--warning-accent);
    }
    .compiler-note p { margin: 5px 0 0; color: var(--warning-muted); }

    .typing-guide, .code-editor {
        margin-top: 14px; overflow: hidden; background: var(--code-bg);
        border: 1px solid var(--border-strong); border-radius: 10px;
    }
    .editor-bar {
        display: flex; justify-content: space-between; padding: 9px 13px;
        color: var(--text-muted); background: var(--surface); border-bottom: 1px solid var(--border);
        font-size: 10px; font-weight: 800; letter-spacing: .7px;
    }
    .character-guide {
        min-height: 76px; padding: 18px; white-space: pre-wrap;
        font: 18px/1.55 Consolas, Monaco, monospace;
    }
    .character-correct { color: var(--accent); }
    .character-wrong {
        color: var(--danger); background: rgba(255, 85, 85, .16);
        text-decoration: underline; text-decoration-thickness: 2px;
    }
    .character-current { color: var(--code-text); background: var(--accent-border); animation: pulse 1s infinite; }
