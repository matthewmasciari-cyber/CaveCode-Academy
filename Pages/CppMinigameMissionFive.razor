@page "/minigames/cpp/mission-5"
@using CaveCode.CourseEngine
@using Microsoft.JSInterop
@inject CourseEngineService CourseEngine
@inject ProgressionService ProgressionService
@inject AchievementService AchievementService
@inject IJSRuntime JS

<PageTitle>C++ Engine Foundry Mission 5 | CaveCode Academy</PageTitle>

@if (!AccessReady)
{
    <main class="m5-gate">
        <section>
            <strong>C++</strong>
            <h1>Preparing the Chapter 1 Finale</h1>
            <p>Checking Chapter 1 and Mission 4 completion.</p>
        </section>
    </main>
}
else if (!AccessGranted)
{
    <main class="m5-gate">
        <section>
            <strong>C++</strong>
            <h1>Full System Recovery is locked</h1>
            <p>
                Complete C++ Chapter 1 and Engine Foundry Mission 4
                before entering the finale.
            </p>
            <NavLink href="/minigames/cpp/mission-4">
                Open Mission 4 →
            </NavLink>
        </section>
    </main>
}
else
{
    <main class="m5-shell">
        <header>
            <div>
                <p>ENGINE FOUNDRY · MISSION 5 · PASS 7E-4B-2</p>
                <h1>Recover the Full Control System</h1>
                <span>
                    Combine variables, arrays, functions, and structs
                    into one final Chapter 1 repair.
                </span>
            </div>

            <nav>
                <NavLink href="/minigames/cpp">Mission 1</NavLink>
                <NavLink href="/minigames/cpp/mission-2">Mission 2</NavLink>
                <NavLink href="/minigames/cpp/mission-3">Mission 3</NavLink>
                <NavLink href="/minigames/cpp/mission-4">Mission 4</NavLink>
                <NavLink class="selected" href="/minigames/cpp/mission-5">
                    Mission 5
                </NavLink>
                <NavLink href="/minigames">Hub</NavLink>
            </nav>
        </header>

        <section class="notice">
            <strong>Chapter 1 finale complete</strong>
            <span>
                Mission 5 records, rewards, validated lines, campaign bonus,
                achievements, title unlocks, celebration state, and leaderboard
                synchronization are active.
            </span>
        </section>

        <section class="record-summary" aria-label="Mission 5 and campaign record">
            <div><small>Best score</small><strong>@SavedState.BestScore.ToString("N0")</strong></div>
            <div><small>Fastest clear</small><strong>@FastestClearLabel</strong></div>
            <div><small>Total clears</small><strong>@SavedState.TotalClears</strong></div>
            <div><small>Campaign</small><strong>@(CampaignProgress.Completed ? "Complete" : "In progress")</strong></div>
        </section>

        @if (ShowCampaignCelebration)
        {
            <section class="campaign-celebration" role="status">
                <span class="campaign-badge">C++</span>
                <div>
                    <small>CHAPTER 1 COMPLETE</small>
                    <h2>Engine Foundry Restored</h2>
                    <p>
                        You repaired all five Engine Foundry missions and
                        completed the Chapter 1 campaign.
                    </p>
                    <strong>Title unlocked: Foundry Systems Engineer</strong>
                </div>
            </section>
        }

        <section class="profiles">
            <div>
                <h2>@CurrentProfile.Title</h2>
                <p>@CurrentProfile.Description</p>
            </div>

            <div class="profile-buttons">
                @foreach (DamageProfile profile in Profiles)
                {
                    <button class="@(SelectedProfile == profile.Id ? "selected" : "")"
                            @onclick="() => SelectProfile(profile.Id)">
                        <strong>@profile.ShortName</strong>
                        <span>@profile.Focus</span>
                    </button>
                }
            </div>
        </section>

        <div class="grid">
            <aside class="panel">
                <h2>Final system checklist</h2>
                <strong>@Checks.Count(check => check.Met) / 6</strong>

                @foreach (MissionCheck check in Checks)
                {
                    <div class="check @(check.Met ? "met" : "")">
                        <b>@(check.Met ? "✓" : "○")</b>
                        <span>
                            <strong>@check.Label</strong>
                            <small>@check.Description</small>
                        </span>
                    </div>
                }

                <div class="status">
                    <small>FINALE STATUS</small>
                    <strong>@MissionStatus</strong>
                    <span>@WorkspaceMessage</span>
                </div>

                <section class="score-panel">
                    <div><small>Projected</small><strong>@ProjectedScore / 1000</strong></div>
                    <div><small>Requirements</small><strong>@RequirementPoints / 840</strong></div>
                    <div><small>Time bonus</small><strong>@CurrentTimeBonus / 160</strong></div>
                    <div><small>Hint penalty</small><strong>-@HintPenalty</strong></div>
                    <div><small>Elapsed</small><strong>@ElapsedLabel</strong></div>
                </section>

                @if (SubmissionComplete)
                {
                    <section class="result @(MissionPassed ? "passed" : "failed")">
                        <strong>@(MissionPassed ? "FINALE PASSED" : "FINALE FAILED")</strong>
                        <span>@FinalScore / 1000 · @FinalElapsedLabel</span>
                        <p>@ResultMessage</p>

                        @if (RewardProcessing)
                        {
                            <small>Saving finale and campaign rewards…</small>
                        }
                        else if (!string.IsNullOrWhiteSpace(RewardMessage))
                        {
                            <small>@RewardMessage</small>
                        }

                        @if (MissionAchievement?.NewlyUnlocked == true)
                        {
                            <small>
                                Achievement unlocked: Full System Recovered ·
                                Title available: Control Systems Programmer
                            </small>
                        }

                        @if (CampaignAchievement?.NewlyUnlocked == true)
                        {
                            <small>
                                Campaign achievement unlocked: Engine Foundry Restored ·
                                Title available: Foundry Systems Engineer
                            </small>
                        }
                    </section>
                }
            </aside>

            <section class="editor-panel">
                <div class="toolbar">
                    <strong>FullSystemRecovery.cpp</strong>
                    <span>@LineCount lines</span>
                </div>

                <textarea @bind="EditorCode"
                          @bind:event="oninput"
                          spellcheck="false"></textarea>

                <div class="controls">
                    <button class="primary" @onclick="RunSimulation">
                        Run full-system test
                    </button>
                    <button @onclick="ResetWorkspace">Reset profile</button>
                    <button @onclick="ToggleHint">
                        @(HintVisible ? "Hide hint" : "Hint")
                    </button>

                    <button class="submit"
                            disabled="@SubmissionComplete"
                            @onclick="SubmitMission">
                        Submit finale
                    </button>

                    @if (SubmissionComplete)
                    {
                        <button @onclick="NewAttempt">
                            New attempt
                        </button>
                    }
                </div>

                @if (HintVisible)
                {
                    <div class="hint">
                        <strong>@CurrentProfile.HintTitle</strong>
                        <p>@CurrentProfile.HintText</p>
                    </div>
                }
            </section>

            <aside class="side">
                <section class="panel">
                    <h2>Finale reference</h2>
                    <p><code>struct SystemState</code></p>
                    <p><code>bool canRunSystem(...)</code></p>
                    <p><code>for (int value : temperatures)</code></p>
                    <p><code>return systemReady;</code></p>
                </section>

                <section class="console">
                    <strong>SIMULATED SYSTEM OUTPUT</strong>

                    @if (ConsoleLines.Count == 0)
                    {
                        <p>[READY] Run the full-system test.</p>
                    }
                    else
                    {
                        @foreach (string line in ConsoleLines)
                        {
                            <p>@line</p>
                        }
                    }
                </section>
            </aside>
        </div>
    </main>
}

<style>
    .m5-shell,.m5-gate{min-height:100vh;box-sizing:border-box;color:var(--text,#edf4ff);background:var(--bg,#08111f);font-family:Inter,system-ui,sans-serif}
    .m5-shell{padding:22px}.m5-gate{display:grid;place-items:center;padding:24px}.m5-gate section,.panel,.editor-panel,.profiles,.console{background:var(--surface-soft,#111c2c);border:1px solid var(--border,#2b3b52);border-radius:13px}
    .m5-gate section{width:min(620px,100%);padding:32px;text-align:center}.m5-gate a,.m5-shell a,.controls button,.profile-buttons button{color:var(--text,#edf4ff);background:var(--surface-strong,#172539);border:1px solid var(--border,#2b3b52);border-radius:9px;padding:10px 13px;text-decoration:none;font-weight:800;cursor:pointer}
    header{max-width:1600px;margin:0 auto 15px;display:flex;justify-content:space-between;gap:18px;align-items:center}header p{color:var(--accent,#61dafb);font-size:10px;font-weight:900}header span,.profiles p,.notice span,.status span,.check small,.hint p{color:var(--text-muted,#aab8cb)}nav{display:flex;flex-wrap:wrap;gap:8px}.selected{border-color:var(--accent,#61dafb)!important}
    .notice{max-width:1600px;margin:0 auto 15px;padding:12px 15px;background:var(--accent-surface,rgba(97,218,251,.1));border:1px solid var(--accent-border,#4f7990);border-radius:10px;display:flex;gap:12px}
    .profiles{max-width:1600px;margin:0 auto 15px;padding:16px;display:grid;grid-template-columns:.8fr 1.2fr;gap:16px}.profile-buttons{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.profile-buttons button{text-align:left}.profile-buttons span{display:block;margin-top:4px;font-size:8px;color:var(--text-muted,#aab8cb)}
    .grid{max-width:1600px;margin:auto;display:grid;grid-template-columns:265px minmax(470px,1fr) 345px;gap:14px}.panel{padding:16px}.check{display:grid;grid-template-columns:24px 1fr;gap:8px;padding:9px;margin:7px 0;background:var(--surface,#0d1726);border:1px solid var(--border,#2b3b52);border-radius:8px}.check small{display:block;font-size:8px}.check.met{border-color:var(--accent-border,#4f7990)}.status{display:grid;gap:4px;padding:10px;margin-top:10px;background:var(--surface,#0d1726);border-radius:8px}
        .record-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));max-width:1600px;gap:10px;margin:0 auto 15px}
    .record-summary div{display:grid;gap:4px;padding:12px;background:var(--surface-soft,#111c2c);border:1px solid var(--border,#2b3b52);border-radius:10px}
    .record-summary small,.campaign-celebration small{color:var(--text-muted,#aab8cb);font-size:8px;text-transform:uppercase;letter-spacing:.08em}
    .campaign-celebration{display:grid;grid-template-columns:auto 1fr;max-width:1600px;gap:18px;align-items:center;padding:20px;margin:0 auto 15px;background:var(--accent-surface,rgba(97,218,251,.12));border:1px solid var(--accent-border,#4f7990);border-radius:14px}
    .campaign-celebration h2,.campaign-celebration p{margin:4px 0}.campaign-celebration p{color:var(--text-muted,#aab8cb)}
    .campaign-badge{display:grid;width:72px;height:64px;place-items:center;color:var(--accent-contrast,#07111f);background:var(--accent,#61dafb);border-radius:14px;font-weight:950;box-shadow:0 0 24px color-mix(in srgb,var(--accent,#61dafb) 35%,transparent)}
    .result small{color:var(--accent-soft,#9feaff);font-size:9px;line-height:1.45}
    .score-panel{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;margin-top:10px}
    .score-panel div{display:grid;gap:3px;padding:9px;background:var(--surface,#0d1726);border:1px solid var(--border,#2b3b52);border-radius:8px}
    .score-panel small,.result span,.result p{color:var(--text-muted,#aab8cb);font-size:9px}
    .result{display:grid;gap:5px;padding:10px;margin-top:10px;border-radius:8px}
    .result.passed{background:rgba(64,190,110,.12);border:1px solid rgba(96,230,140,.55)}
    .result.failed{background:rgba(230,90,90,.11);border:1px solid rgba(255,120,120,.55)}
    .controls .submit{color:#fff;background:#1769d2;border-color:#7eb8ff}
    .controls .submit:disabled{opacity:.5;cursor:not-allowed}
    .editor-panel{overflow:hidden;display:flex;flex-direction:column}.toolbar{padding:13px;display:flex;justify-content:space-between;background:var(--surface,#0d1726)}textarea{min-height:590px;flex:1;resize:none;padding:18px;color:var(--text,#edf4ff);background:var(--surface-strong,#172539);border:0;font:13px/1.6 Consolas,monospace}.controls{display:flex;gap:9px;padding:12px;background:var(--surface,#0d1726)}.controls .primary{color:var(--accent-contrast,#07111f);background:var(--accent,#61dafb)}.hint{padding:12px 14px;background:var(--accent-surface,rgba(97,218,251,.1))}
    .side{display:grid;gap:14px}.console{padding:14px;min-height:280px;background:#07100c;font:10px Consolas,monospace}
    @@media(max-width:1240px){.grid{grid-template-columns:240px 1fr}.side{grid-column:1/-1;grid-template-columns:1fr 1fr}}
    @@media(max-width:820px){header{align-items:flex-start;flex-direction:column}.record-summary{grid-template-columns:repeat(2,minmax(0,1fr))}.campaign-celebration{grid-template-columns:1fr;text-align:center}.campaign-badge{margin:auto}.profiles,.grid,.side{grid-template-columns:1fr}.profile-buttons{grid-template-columns:1fr}.side{grid-column:auto}}
</style>

@code {
    private const string FullCode =
        "#include <iostream>\n\n"
        + "struct SystemState\n{\n"
        + "    int pressure;\n"
        + "    bool valveOpen;\n"
        + "}\n\n"
        + "bool canRunSystem(int pressure, bool valveOpen)\n"
        + "{\n"
        + "    return pressure > 20 || valveOpen;\n"
        + "}\n\n"
        + "int main()\n"
        + "{\n"
        + "    int temperatures[3] = { 72, 75, 78, 80 };\n"
        + "    int total = 0;\n"
        + "    for (int value : temperatures)\n"
        + "    {\n"
        + "        total = value;\n"
        + "    }\n"
        + "    SystemState system;\n"
        + "    system.pressure = 48;\n"
        + "    system.valveOpen = true;\n"
        + "    bool systemReady = canRunSystem(system.pressure, system.valveOpen);\n"
        + "    std::cout << \"System ready: \" << pressure << \"\\n\";\n"
        + "    return 0;\n"
        + "}\n";

    private const string DataCode =
        "#include <iostream>\n\n"
        + "struct SystemState\n{\n"
        + "    int pressure;\n"
        + "    bool valveOpen;\n"
        + "    bool motorReady;\n"
        + "};\n\n"
        + "bool canRunSystem(int pressure, bool valveOpen, bool motorReady)\n"
        + "{\n"
        + "    bool pressureOk = pressure >= 30 && pressure <= 70;\n"
        + "    bool systemReady = pressureOk && valveOpen && motorReady;\n"
        + "    return systemReady;\n"
        + "}\n\n"
        + "int main()\n"
        + "{\n"
        + "    int temperatures[3] = { 72, 75, 78, 80 };\n"
        + "    int total = 0;\n"
        + "    for (int value : temperatures) total += value;\n"
        + "    SystemState system{ 48, true, true };\n"
        + "    bool systemReady = canRunSystem(system.pressure, system.valveOpen, system.motorReady);\n"
        + "    std::cout << \"System ready: \" << systemReady << \"\\n\";\n"
        + "    return 0;\n"
        + "}\n";

    private const string LogicCode =
        "#include <iostream>\n\n"
        + "struct SystemState\n{\n"
        + "    int pressure;\n"
        + "    bool valveOpen;\n"
        + "    bool motorReady;\n"
        + "};\n\n"
        + "bool canRunSystem(int pressure, bool valveOpen, bool motorReady)\n"
        + "{\n"
        + "    bool pressureOk = pressure < 30 || pressure > 70;\n"
        + "    bool systemReady = pressureOk || valveOpen || motorReady;\n"
        + "    return pressureOk;\n"
        + "}\n\n"
        + "int main()\n"
        + "{\n"
        + "    int temperatures[4] = { 72, 75, 78, 80 };\n"
        + "    int total = 0;\n"
        + "    for (int value : temperatures) total += value;\n"
        + "    SystemState system{ 48, true, true };\n"
        + "    bool systemReady = canRunSystem(system.pressure, system.valveOpen, system.motorReady);\n"
        + "    std::cout << \"System ready: \" << systemReady << \"\\n\";\n"
        + "    return 0;\n"
        + "}\n";

    private bool AccessReady, AccessGranted, ChapterReady, MissionFourReady;
    private bool HintVisible, HasRun, SubmissionComplete, MissionPassed;
    private bool RewardProcessing, RewardsProcessed, ShowCampaignCelebration;
    private int HintsUsed, FinalScore, FinalElapsedSeconds, AccumulatedSeconds;
    private DateTimeOffset? AttemptStartedAt;
    private string ResultMessage = "";
    private string RewardMessage = "";
    private string AttemptId = Guid.NewGuid().ToString("N");
    private MissionFiveState SavedState = new();
    private CampaignState CampaignProgress = new();
    private AchievementUnlockResult? MissionAchievement;
    private AchievementUnlockResult? CampaignAchievement;
    private string SelectedProfile = "full";
    private string EditorCode = FullCode;
    private string WorkspaceMessage = "Repair all six finale requirements.";
    private List<string> ConsoleLines = new();

    private IReadOnlyList<DamageProfile> Profiles => new[]
    {
        new DamageProfile(
            "full",
            "Full Control System Failure",
            "Full Finale",
            "Repair the complete combined system",
            "Struct data, arrays, loop accumulation, function parameters, permissive logic, return value, and output are damaged.",
            "Repair one layer at a time",
            "Start with the four-value array and complete SystemState struct. Then repair canRunSystem so every permissive is required."
        ),
        new DamageProfile(
            "data",
            "System Data Failure",
            "Data Integration",
            "Repair array size and complete system state",
            "The control logic works, but the temperature array and grouped system data do not match the equipment.",
            "Match storage to the readings",
            "Use temperatures[4] and include pressure, valveOpen, and motorReady in SystemState."
        ),
        new DamageProfile(
            "logic",
            "Final Permissive Failure",
            "Control Logic",
            "Repair pressure range, AND logic, and return value",
            "The data model is correct, but unsafe logic permits the full system to run.",
            "Require every safe condition",
            "Use pressure >= 30 && pressure <= 70, combine all three permissives with &&, and return systemReady."
        )
    };

    private DamageProfile CurrentProfile =>
        Profiles.First(profile => profile.Id == SelectedProfile);

    private int LineCount =>
        EditorCode.Replace("\r\n", "\n").Split('\n').Length;

    private string MissionStatus =>
        Checks.All(check => check.Met)
            ? "Full control system structurally ready"
            : HasRun
                ? "Final diagnostics found unresolved repairs"
                : "Finale incident loaded";

    private int PassedRequirementCount =>
        Checks.Count(check => check.Met);

    private int RequirementPoints =>
        PassedRequirementCount * 140;

    private int ElapsedSeconds =>
        SubmissionComplete
            ? FinalElapsedSeconds
            : AccumulatedSeconds +
              (AttemptStartedAt.HasValue
                  ? Math.Max(
                      0,
                      (int)(DateTimeOffset.UtcNow - AttemptStartedAt.Value)
                          .TotalSeconds)
                  : 0);

    private int CurrentTimeBonus =>
        Math.Clamp(
            160 - (ElapsedSeconds / 5) * 5,
            0,
            160);

    private int HintPenalty =>
        HintsUsed * 40;

    private int ProjectedScore =>
        Math.Clamp(
            RequirementPoints +
            CurrentTimeBonus -
            HintPenalty,
            0,
            1000);

    private string ElapsedLabel =>
        FormatTime(ElapsedSeconds);

    private string FinalElapsedLabel =>
        FormatTime(FinalElapsedSeconds);

    private string FastestClearLabel =>
        SavedState.FastestSeconds.HasValue
            ? FormatTime((int)Math.Round(SavedState.FastestSeconds.Value))
            : "--:--";

    private IReadOnlyList<MissionCheck> Checks => new[]
    {
        new MissionCheck(
            "Complete system struct",
            "Declare pressure, valveOpen, and motorReady fields.",
            Has(@"struct\s+SystemState\s*\{") &&
            Has(@"int\s+pressure\s*;") &&
            Has(@"bool\s+valveOpen\s*;") &&
            Has(@"bool\s+motorReady\s*;")
        ),
        new MissionCheck(
            "Four-value array",
            "Store all four temperature readings.",
            Has(@"int\s+temperatures\s*\[\s*4\s*\]\s*=\s*\{\s*72\s*,\s*75\s*,\s*78\s*,\s*80\s*\}")
        ),
        new MissionCheck(
            "Running total loop",
            "Add every temperature with +=.",
            Has(@"for\s*\(\s*int\s+value\s*:\s*temperatures\s*\)") &&
            Has(@"total\s*\+=\s*value\s*;")
        ),
        new MissionCheck(
            "Complete control function",
            "Receive pressure, valveOpen, and motorReady.",
            Has(@"bool\s+canRunSystem\s*\(\s*int\s+pressure\s*,\s*bool\s+valveOpen\s*,\s*bool\s+motorReady\s*\)")
        ),
        new MissionCheck(
            "Safe permissive logic",
            "Require safe pressure and both boolean permissives.",
            Has(@"pressure\s*>=\s*30\s*&&\s*pressure\s*<=\s*70") &&
            Has(@"pressureOk\s*&&\s*valveOpen\s*&&\s*motorReady") &&
            Has(@"return\s+systemReady\s*;")
        ),
        new MissionCheck(
            "Call and report result",
            "Call with struct members and print systemReady.",
            EditorCode.Contains("canRunSystem(system.pressure, system.valveOpen, system.motorReady)") &&
            EditorCode.Contains("\"System ready: \"") &&
            EditorCode.Contains("systemReady")
        )
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            CourseProgressSnapshot progress =
                await CourseEngine.GetProgressAsync(CourseIds.Cpp);

            ChapterReady =
                progress.ModuleCompleted.Length > 7 &&
                progress.ModuleCompleted[7];

            MissionFourState state =
                await JS.InvokeAsync<MissionFourState>(
                    "caveCodeCppMinigame.getMissionFourState");

            MissionFourReady = state.Completed;

            SavedState =
                await JS.InvokeAsync<MissionFiveState>(
                    "caveCodeCppMinigame.getMissionFiveState");

            CampaignProgress =
                await JS.InvokeAsync<CampaignState>(
                    "caveCodeCppMinigame.getChapterOneCampaignState");

            ShowCampaignCelebration =
                CampaignProgress.Completed;

            AccessGranted = ChapterReady && MissionFourReady;
        }
        catch
        {
            AccessGranted = false;
        }

        AccessReady = true;
        await InvokeAsync(StateHasChanged);
    }

    private void SelectProfile(string id)
    {
        SelectedProfile = id;
        EditorCode =
            id == "data"
                ? DataCode
                : id == "logic"
                    ? LogicCode
                    : FullCode;

        HintVisible = false;
        HasRun = false;
        HintsUsed = 0;
        SubmissionComplete = false;
        MissionPassed = false;
        FinalScore = 0;
        FinalElapsedSeconds = 0;
        AccumulatedSeconds = 0;
        AttemptStartedAt = null;
        ResultMessage = "";
        RewardMessage = "";
        RewardProcessing = false;
        RewardsProcessed = false;
        MissionAchievement = null;
        CampaignAchievement = null;
        AttemptId = Guid.NewGuid().ToString("N");
        ConsoleLines.Clear();
        WorkspaceMessage =
            CurrentProfile.Title + " restored to its damaged state.";
    }

    private void RunSimulation()
    {
        if (SubmissionComplete)
        {
            return;
        }

        EnsureClock();
        HasRun = true;
        ConsoleLines.Clear();
        ConsoleLines.Add("[SIM] Full-system diagnostics started.");

        foreach (MissionCheck check in Checks)
        {
            ConsoleLines.Add(
                check.Met
                    ? $"[OK] {check.Label}"
                    : $"[WARN] Unresolved: {check.Label}");
        }

        if (Checks.All(check => check.Met))
        {
            ConsoleLines.Add("[SIM] Average temperature: 76");
            ConsoleLines.Add("[SIM] System ready: true");
            ConsoleLines.Add("[SIM] Chapter 1 control system restored.");
        }

        WorkspaceMessage =
            $"{Checks.Count(check => check.Met)} of 6 finale requirements currently pass.";
    }

    private void ResetWorkspace() =>
        SelectProfile(SelectedProfile);

    private void ToggleHint()
    {
        bool opening = !HintVisible;
        HintVisible = opening;

        if (opening && !SubmissionComplete)
        {
            HintsUsed += 1;
            EnsureClock();
        }
    }

    private async Task SubmitMission()
    {
        if (SubmissionComplete)
        {
            return;
        }

        StopClock();

        FinalElapsedSeconds = AccumulatedSeconds;
        MissionPassed =
            Checks.All(check => check.Met);

        FinalScore =
            Math.Clamp(
                RequirementPoints +
                Math.Clamp(
                    160 -
                    (FinalElapsedSeconds / 5) * 5,
                    0,
                    160) -
                HintPenalty,
                0,
                1000);

        SubmissionComplete = true;
        HasRun = true;

        ResultMessage =
            MissionPassed
                ? "All six finale requirements passed. Campaign rewards remain disabled until Pass 7E-4B-2."
                : $"{PassedRequirementCount} of 6 finale requirements passed. Start a new attempt after repairing the remaining checks.";

        ConsoleLines.Add(
            MissionPassed
                ? $"[RESULT] PASS · {FinalScore}/1000"
                : $"[RESULT] FAIL · {FinalScore}/1000");

        if (MissionPassed)
        {
            await ProcessRewardsAsync();
        }
    }

    private async Task ProcessRewardsAsync()
    {
        if (RewardProcessing || RewardsProcessed)
        {
            return;
        }

        RewardProcessing = true;
        RewardMessage = "";

        try
        {
            MissionFiveRecord result =
                await JS.InvokeAsync<MissionFiveRecord>(
                    "caveCodeCppMinigame.recordMissionFiveClear",
                    AttemptId,
                    FinalScore,
                    FinalElapsedSeconds,
                    SelectedProfile);

            int validatedLines =
                EditorCode.Replace("\r\n", "\n")
                    .Split('\n')
                    .Count(line => !string.IsNullOrWhiteSpace(line));

            await ProgressionService.AwardMinigameRunAsync(
                CourseIds.Cpp,
                result.RewardKey,
                result.XpAwarded,
                validatedLines);

            await AchievementService.AwardMinigameCrystalsAsync(
                result.RewardKey,
                result.CrystalsAwarded);

            MissionAchievement =
                await AchievementService.UnlockChapterAsync(
                    "cpp-minigame",
                    5);

            if (result.CampaignBonusAwarded)
            {
                await ProgressionService.AwardMinigameRunAsync(
                    CourseIds.Cpp,
                    result.CampaignRewardKey,
                    result.CampaignXpAwarded,
                    0);

                await AchievementService.AwardMinigameCrystalsAsync(
                    result.CampaignRewardKey,
                    result.CampaignCrystalsAwarded);

                CampaignAchievement =
                    await AchievementService.UnlockChapterAsync(
                        "cpp-minigame-campaign",
                        1);
            }

            SavedState = result.State;
            CampaignProgress = result.CampaignState;
            ShowCampaignCelebration =
                result.CampaignState.Completed;
            RewardsProcessed = true;

            RewardMessage =
                $"+{result.XpAwarded} C++ XP, " +
                $"◆ {result.CrystalsAwarded} crystals, and " +
                $"{validatedLines} validated C++ lines saved.";

            if (result.CampaignBonusAwarded)
            {
                RewardMessage +=
                    $" Campaign bonus: +{result.CampaignXpAwarded} XP and " +
                    $"◆ {result.CampaignCrystalsAwarded} crystals.";
            }

            try
            {
                await JS.InvokeVoidAsync(
                    "caveCodeProgression.syncLeaderboardProfile");
            }
            catch
            {
            }
        }
        catch (Exception error)
        {
            RewardMessage =
                "Finale passed, but reward saving failed: " +
                error.Message;
        }
        finally
        {
            RewardProcessing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void NewAttempt()
    {
        SelectProfile(SelectedProfile);
        WorkspaceMessage =
            CurrentProfile.Title +
            " loaded as a new scored finale attempt.";
    }

    private void EnsureClock()
    {
        if (!AttemptStartedAt.HasValue)
        {
            AttemptStartedAt =
                DateTimeOffset.UtcNow;
        }
    }

    private void StopClock()
    {
        if (!AttemptStartedAt.HasValue)
        {
            return;
        }

        AccumulatedSeconds +=
            Math.Max(
                0,
                (int)(DateTimeOffset.UtcNow - AttemptStartedAt.Value)
                    .TotalSeconds);

        AttemptStartedAt = null;
    }

    private static string FormatTime(int seconds) =>
        $"{seconds / 60:00}:{seconds % 60:00}";

    private bool Has(string pattern) =>
        System.Text.RegularExpressions.Regex.IsMatch(
            EditorCode,
            pattern);

