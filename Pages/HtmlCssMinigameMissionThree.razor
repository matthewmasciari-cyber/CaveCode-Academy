    private RequirementCheck[] EvaluateRequirements() =>
        Enumerable.Range(0, Requirements.Length)
            .Select(EvaluateRequirement)
            .ToArray();

    private RequirementCheck EvaluateRequirement(int index) => index switch
    {
        0 => EvaluateSemanticNavigation(),
        1 => EvaluateNativeMenuControl(),
        2 => EvaluateNavigationLinks(),
        3 => EvaluateDesktopNavigation(),
        4 => EvaluateNavigationAccess(),
        5 => EvaluateResponsiveNavigation(),
        _ => new(false, "Unknown requirement.")
    };

    private RequirementCheck EvaluateSemanticNavigation()
    {
        bool header =
            Regex.IsMatch(
                HtmlCode ?? "",
                @"<header\b[^>]*\bclass\s*=\s*[""'][^""']*\bsite-header\b[^""']*[""']",
                RegexOptions.IgnoreCase);
        bool brand =
            Regex.IsMatch(
                HtmlCode ?? "",
                @"<a\b[^>]*\bclass\s*=\s*[""'][^""']*\bbrand\b[^""']*[""'][^>]*\bhref\s*=\s*[""']#top[""']",
                RegexOptions.IgnoreCase);
        bool nav =
            Regex.IsMatch(
                HtmlCode ?? "",
                @"<nav\b[^>]*\baria-label\s*=\s*[""']Primary navigation[""']",
                RegexOptions.IgnoreCase);
        bool passed = header && brand && nav;

        return new(
            passed,
            passed
                ? "Semantic site header, brand link, and labeled primary navigation are present."
                : $"Site header: {PassWord(header)}; brand link: {PassWord(brand)}; labeled navigation: {PassWord(nav)}.");
    }

    private RequirementCheck EvaluateNativeMenuControl()
    {
        bool details =
            Regex.IsMatch(
                HtmlCode ?? "",
                @"<details\b[^>]*\bclass\s*=\s*[""'][^""']*\bsite-nav\b[^""']*[""']",
                RegexOptions.IgnoreCase);
        Match summary = Regex.Match(
            HtmlCode ?? "",
            @"<summary\b[^>]*\bclass\s*=\s*[""'][^""']*\bmenu-toggle\b[^""']*[""'][^>]*>(?<text>[\s\S]*?)</summary>",
            RegexOptions.IgnoreCase);
        bool summaryText =
            summary.Success &&
            Regex.Replace(summary.Groups["text"].Value, @"<[^>]+>", "").Trim().Length >= 3;
        bool nestedNav = Regex.IsMatch(
            HtmlCode ?? "",
            @"<details\b[^>]*\bclass\s*=\s*[""'][^""']*\bsite-nav\b[^""']*[""'][^>]*>[\s\S]*?<summary\b[\s\S]*?</summary>[\s\S]*?<nav\b[\s\S]*?</nav>[\s\S]*?</details>",
            RegexOptions.IgnoreCase);
        bool passed = details && summaryText && nestedNav;

        return new(
            passed,
            passed
                ? "A native details and summary menu wraps the primary navigation."
                : $"Details control: {PassWord(details)}; menu label: {PassWord(summaryText)}; nested navigation: {PassWord(nestedNav)}.");
    }

    private RequirementCheck EvaluateNavigationLinks()
    {
        MatchCollection links = Regex.Matches(
            HtmlCode ?? "",
            @"<a\b(?=[^>]*\bclass\s*=\s*[""'][^""']*\bnav-link\b[^""']*[""'])(?=[^>]*\bhref\s*=\s*[""']#(?<id>overview|projects|contact)[""'])[^>]*>",
            RegexOptions.IgnoreCase);

        HashSet<string> targets = links
            .Cast<Match>()
            .Select(match => match.Groups["id"].Value.ToLowerInvariant())
            .ToHashSet();

        bool list =
            HasTag(HtmlCode, "ul") &&
            CountTags(HtmlCode, "li") >= 3 &&
            HasClass(HtmlCode, "nav-list");
        bool matchingSections =
            targets.SetEquals(new[] { "overview", "projects", "contact" }) &&
            targets.All(target => HasId(HtmlCode, target));
        bool passed = list && links.Count == 3 && matchingSections;

        return new(
            passed,
            passed
                ? "Overview, Projects, and Contact links are organized in a list and connect to matching sections."
                : $"Navigation list: {PassWord(list)}; valid links: {links.Count} / 3; matching targets: {PassWord(matchingSections)}.");
    }

    private RequirementCheck EvaluateDesktopNavigation()
    {
        string css = StripCssComments(CssCode);
        bool headerLayout =
            RuleContains(css, ".site-header", @"display\s*:\s*(?:flex|grid)") &&
            RuleContains(css, ".site-header", @"align-items\s*:");
        bool listLayout =
            RuleContains(css, ".nav-list", @"display\s*:\s*flex") &&
            (RuleContains(css, ".nav-list", @"gap\s*:\s*(?!0(?:px|rem|em|%)?\b)[^;]+") ||
             RuleContains(css, ".nav-list", @"column-gap\s*:\s*(?!0(?:px|rem|em|%)?\b)[^;]+"));
        bool toggleHidden =
            RuleContains(css, ".menu-toggle", @"display\s*:\s*none");
        bool navShown =
            RuleContains(css, ".site-nav > nav", @"display\s*:\s*block");
        bool passed = headerLayout && listLayout && toggleHidden && navShown;

        return new(
            passed,
            passed
                ? "Wide screens align the header and links while hiding the native menu summary."
                : $"Header layout: {PassWord(headerLayout)}; link row: {PassWord(listLayout)}; summary hidden: {PassWord(toggleHidden)}; nav shown: {PassWord(navShown)}.");
    }

    private RequirementCheck EvaluateNavigationAccess()
    {
        string css = StripCssComments(CssCode);
        bool linkContrast = HasReadableSelector(css, ".nav-link");
        bool toggleContrast = HasReadableSelector(css, ".menu-toggle");
        bool linkFocus = Regex.IsMatch(
            css,
            @"\.nav-link\s*:\s*focus-visible[\s\S]*?outline\s*:\s*(?!none)[^;]+",
            RegexOptions.IgnoreCase);
        bool toggleFocus = Regex.IsMatch(
            css,
            @"\.menu-toggle\s*:\s*focus-visible[\s\S]*?outline\s*:\s*(?!none)[^;]+",
            RegexOptions.IgnoreCase);
        bool linkPadding =
            RuleContains(css, ".nav-link", @"padding\s*:\s*(?!0(?:px|rem|em|%)?\b)[^;]+");
        bool passed =
            linkContrast &&
            toggleContrast &&
            linkFocus &&
            toggleFocus &&
            linkPadding;

        return new(
            passed,
            passed
                ? "Menu and navigation controls are readable, comfortably sized, and keyboard visible."
                : $"Link contrast: {PassWord(linkContrast)}; menu contrast: {PassWord(toggleContrast)}; link focus: {PassWord(linkFocus)}; menu focus: {PassWord(toggleFocus)}; control spacing: {PassWord(linkPadding)}.");
    }

    private RequirementCheck EvaluateResponsiveNavigation()
    {
        string css = StripCssComments(CssCode);
        Match media = Regex.Match(
            css,
            @"@media\s*\(\s*max-width\s*:\s*(?<width>\d+)px\s*\)\s*\{(?<body>[\s\S]*)$",
            RegexOptions.IgnoreCase);

        int width = media.Success ? int.Parse(media.Groups["width"].Value) : int.MaxValue;
        string body = media.Success ? media.Groups["body"].Value : "";
        bool breakpoint = media.Success && width >= 480 && width <= 820;
        bool toggleVisible = Regex.IsMatch(
            body,
            @"\.menu-toggle[\s\S]*?display\s*:\s*(?:block|flex)",
            RegexOptions.IgnoreCase);
        bool listStacked =
            Regex.IsMatch(
                body,
                @"\.nav-list[\s\S]*?flex-direction\s*:\s*column",
                RegexOptions.IgnoreCase) ||
            Regex.IsMatch(
                body,
                @"\.nav-list[\s\S]*?grid-template-columns\s*:\s*1fr",
                RegexOptions.IgnoreCase);
        bool navWidth = Regex.IsMatch(
            body,
            @"\.site-nav[\s\S]*?width\s*:\s*100%",
            RegexOptions.IgnoreCase);
        bool headerWrap = Regex.IsMatch(
            body,
            @"\.site-header[\s\S]*?flex-wrap\s*:\s*wrap",
            RegexOptions.IgnoreCase);
        bool fixedBodyWidth =
            RuleContains(css, "body", @"width\s*:\s*(?:[8-9]\d{2}|[1-9]\d{3,})px");
        bool passed =
            breakpoint &&
            toggleVisible &&
            listStacked &&
            navWidth &&
            headerWrap &&
            !fixedBodyWidth;

        return new(
            passed,
            passed
                ? $"A {width}px breakpoint reveals and stacks the native menu without fixed-width overflow."
                : $"Breakpoint: {PassWord(breakpoint)}; menu visible: {PassWord(toggleVisible)}; links stacked: {PassWord(listStacked)}; nav width: {PassWord(navWidth)}; header wraps: {PassWord(headerWrap)}; body width removed: {PassWord(!fixedBodyWidth)}.");
    }

    private string BuildPreviewDocument()
    {
        string html = SanitizeHtml(HtmlCode);
        string css = SanitizeCss(CssCode);

        return $"""
            <!DOCTYPE html>
            <html lang="en">
            <head>
                <meta charset="UTF-8">
                <meta name="viewport" content="width=device-width, initial-scale=1.0">
                <title>Mobile Navigation Recovery</title>
                <style>{PreviewStyles}\n{css}</style>
            </head>
            <body>
                {html}
            </body>
            </html>
            """;
    }

    private static string SanitizeHtml(string html)
    {
        string value = html ?? "";
        value = Regex.Replace(value, @"<script\b[\s\S]*?</script\s*>", "", RegexOptions.IgnoreCase);
        value = Regex.Replace(value, @"\s+on[a-z]+\s*=\s*(?:""[^""]*""|'[^']*')", "", RegexOptions.IgnoreCase);
        value = Regex.Replace(value, @"javascript\s*:", "", RegexOptions.IgnoreCase);
        value = Regex.Replace(value, @"\s+(?:src|href)\s*=\s*[""']https?://[^""']*[""']", "", RegexOptions.IgnoreCase);
        return value;
    }

    private static string SanitizeCss(string css)
    {
        string value = css ?? "";
        value = Regex.Replace(value, @"@import[^;]+;", "", RegexOptions.IgnoreCase);
        value = Regex.Replace(value, @"url\s*\([^)]*\)", "none", RegexOptions.IgnoreCase);
        value = Regex.Replace(value, @"expression\s*\([^)]*\)", "", RegexOptions.IgnoreCase);
        return value;
    }

    private static bool HasTag(string? html, string tag) =>
        Regex.IsMatch(html ?? "", $@"<\s*{Regex.Escape(tag)}\b", RegexOptions.IgnoreCase);

    private static int CountTags(string? html, string tag) =>
        Regex.Matches(html ?? "", $@"<\s*{Regex.Escape(tag)}\b", RegexOptions.IgnoreCase).Count;

    private static bool HasId(string? html, string id) =>
        Regex.IsMatch(html ?? "", $@"\bid\s*=\s*[""']{Regex.Escape(id)}[""']", RegexOptions.IgnoreCase);

    private static bool HasClass(string? html, string className) =>
        Regex.IsMatch(html ?? "", $@"\bclass\s*=\s*[""'][^""']*\b{Regex.Escape(className)}\b[^""']*[""']", RegexOptions.IgnoreCase);

    private static bool HasAnchorClass(string html, string className) =>
        Regex.IsMatch(html ?? "", $@"<a\b[^>]*\bclass\s*=\s*[""'][^""']*\b{Regex.Escape(className)}\b[^""']*[""']", RegexOptions.IgnoreCase);

    private static string StripCssComments(string css) =>
        Regex.Replace(css ?? "", @"/\*.*?\*/", "", RegexOptions.Singleline);

    private static bool RuleContains(string css, string selector, string declarationPattern)
    {
        MatchCollection rules = Regex.Matches(
            css ?? "",
            @"(?<selectors>[^{}]+)\{(?<body>[^{}]*)\}",
            RegexOptions.Singleline);

        foreach (Match rule in rules)
        {
            if (rule.Groups["selectors"].Value.IndexOf(selector, StringComparison.OrdinalIgnoreCase) < 0)
            {
                continue;
            }

            if (Regex.IsMatch(rule.Groups["body"].Value, declarationPattern, RegexOptions.IgnoreCase | RegexOptions.Singleline))
            {
                return true;
            }
        }

        return false;
    }

    private static bool HasReadableSelector(string css, string selector)
    {
        MatchCollection rules = Regex.Matches(
            css ?? "",
            @"(?<selectors>[^{}]+)\{(?<body>[^{}]*)\}",
            RegexOptions.Singleline);

        foreach (Match rule in rules)
        {
            if (rule.Groups["selectors"].Value.IndexOf(selector, StringComparison.OrdinalIgnoreCase) < 0)
            {
                continue;
            }

            string body = rule.Groups["body"].Value;
            string foreground = DeclarationValue(body, "color");
            string background = DeclarationValue(body, "background-color");

            if (string.IsNullOrWhiteSpace(background))
            {
                background = DeclarationValue(body, "background");
            }

            if (TryParseCssColor(foreground, out double foregroundLuminance) &&
                TryParseCssColor(background, out double backgroundLuminance))
            {
                double light = Math.Max(foregroundLuminance, backgroundLuminance);
                double dark = Math.Min(foregroundLuminance, backgroundLuminance);
                return (light + .05) / (dark + .05) >= 4.5;
            }
        }

        return false;
    }

    private static string DeclarationValue(string body, string property)
    {
        Match match = Regex.Match(
            body ?? "",
            $@"(?:^|;)\s*{Regex.Escape(property)}\s*:\s*(?<value>[^;]+)",
            RegexOptions.IgnoreCase);
        return match.Success ? match.Groups["value"].Value.Trim() : "";
    }

    private static bool TryParseCssColor(string value, out double luminance)
    {
        luminance = 0;
        string color = (value ?? "").Trim().ToLowerInvariant();
        color = color switch
        {
            "white" => "#ffffff",
            "black" => "#000000",
            "navy" => "#000080",
            _ => color
        };

        Match hex = Regex.Match(color, @"^#(?<hex>[0-9a-f]{3}|[0-9a-f]{6})$", RegexOptions.IgnoreCase);
        if (!hex.Success)
        {
            return false;
        }

        string digits = hex.Groups["hex"].Value;
        if (digits.Length == 3)
        {
            digits = string.Concat(digits.Select(character => new string(character, 2)));
        }

        int red = Convert.ToInt32(digits[..2], 16);
        int green = Convert.ToInt32(digits.Substring(2, 2), 16);
        int blue = Convert.ToInt32(digits.Substring(4, 2), 16);

        static double Channel(int component)
        {
            double componentValue = component / 255d;
            return componentValue <= .03928
                ? componentValue / 12.92
                : Math.Pow((componentValue + .055) / 1.055, 2.4);
        }

        luminance = .2126 * Channel(red) + .7152 * Channel(green) + .0722 * Channel(blue);
        return true;
    }

