    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            CourseProgressSnapshot progress =
                await CourseEngine.GetProgressAsync(CourseIds.HtmlCss);

            ChapterOneCompletedModules =
                progress.ModuleCompleted.Take(8).Count(completed => completed);

            ChapterOneUnlocked =
                progress.ModuleCompleted.Length > ChapterOneFinalModuleIndex &&
                progress.ModuleCompleted[ChapterOneFinalModuleIndex];

            MinigameState =
                await JS.InvokeAsync<HtmlCssMinigameState>(
                    "caveCodeHtmlCssMinigame.getState");
        }
        catch (Exception error)
        {
            AccessError =
                "Interface Rescue could not read the local checkpoint: " +
                error.Message;
        }
        finally
        {
            AccessReady = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task UpdateHtml(ChangeEventArgs args)
    {
