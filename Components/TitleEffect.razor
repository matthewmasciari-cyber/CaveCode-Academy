@* CaveCode title effects — Discord-style name flair *@
<span class="title-effect-wrap @WrapClass" title="@Title">
    <span class="title-effect @EffectClass">@Title</span>
    @if (!string.IsNullOrEmpty(Badge))
    {
        <span class="title-effect-badge" aria-hidden="true">@Badge</span>
    }
</span>

@code {
    [Parameter] public string? Title { get; set; }

    private string EffectClass { get; set; } = "stone";
    private string WrapClass { get; set; } = "";
    private string? Badge { get; set; }

    protected override void OnParametersSet()
    {
        var t = (Title ?? "").Trim();
        var map = Resolve(t);
        EffectClass = map.Effect;
        WrapClass = map.Wrap;
        Badge = map.Badge;
    }

    private static (string Effect, string Wrap, string? Badge) Resolve(string title) =>
        title switch
        {
            "Cave Explorer" => ("stone", "", null),
            "Code Apprentice" => ("electric", "", "⚡"),
            "Academy Pathfinder" => ("electric", "", null),
            "Logic Pathfinder" => ("electric", "title-fx-lightning", "⚡"),
            "Systems Builder" => ("circuit", "", "▣"),
            "C# Adventurer" => ("fire", "title-fx-softflame", "🔥"),
            "CaveCode Champion" => ("prismatic", "title-fx-sparkle title-fx-rgb", "◆"),
            "Control Room Operator" => ("water", "", "◎"),
            "Automation Trainee" => ("water", "", null),
            "Python Technician" => ("circuit", "", null),
            "Engine Technician" => ("circuit", "", "⚙"),
            "C++ Systems Builder" => ("circuit", "", null),
            "Memory Steward" => ("electric", "", null),
            "C++ Engine Architect" => ("prismatic", "title-fx-sparkle", "◆"),
            "Markup Builder" => ("electric", "", null),
            "Interface Rescuer" => ("water", "", null),
            "Interface Guardian" => ("prismatic", "title-fx-sparkle", "✦"),

            "Control Cadet" => ("control", "", "●"),
            "Sequence Tech" => ("control", "title-fx-pulse", "●"),
            "Interlock Operator" => ("control", "title-fx-lightning", "⚡"),
            "Timing Specialist" => ("control", "title-fx-sparkle", "✦"),
            "Line Boss" => ("control", "title-fx-sparkle title-fx-rgb", "◆"),

            "Pin Rookie" => ("solder", "", "⌁"),
            "Sketch Smith" => ("solder", "title-fx-softflame", "✦"),
            "Sensor Apprentice" => ("solder", "title-fx-pulse", "◎"),
            "Shield Builder" => ("solder", "title-fx-lightning", "⚡"),
            "Board Captain" => ("solder", "title-fx-softflame title-fx-sparkle title-fx-lightning", "⚡"),

            "GPIO Scout" => ("berry", "", "◈"),
            "Pi Tinkerer" => ("berry", "title-fx-pulse", "◈"),
            "Sense Hacker" => ("berry", "title-fx-lightning", "⚡"),
            "Automation Hand" => ("berry", "title-fx-sparkle", "✦"),
            "Lab Lead" => ("berry", "title-fx-sparkle title-fx-rgb", "◆"),

            "Console Cadet" => ("forge", "", ">_"),
            "DOM Jockey" => ("forge", "title-fx-lightning", "⚡"),
            "Event Wrangler" => ("forge", "title-fx-pulse", "✦"),
            "Module Pilot" => ("forge", "title-fx-sparkle", "▣"),
            "Web Forge Ace" => ("forge", "title-fx-sparkle title-fx-rgb title-fx-lightning", "◆"),

            _ when title.Contains("Master", StringComparison.OrdinalIgnoreCase)
                => ("prismatic", "title-fx-sparkle", "◆"),
            _ when title.Contains("Architect", StringComparison.OrdinalIgnoreCase)
                => ("prismatic", "title-fx-sparkle", null),
            _ when title.Contains("Champion", StringComparison.OrdinalIgnoreCase)
                => ("prismatic", "title-fx-rgb title-fx-sparkle", "◆"),
            _ => ("stone", "", null)
        };
}
