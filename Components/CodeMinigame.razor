    }

    .practice-summary strong {
        margin-top: 5px;
        font-size: 14px;
    }

    .practice-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 10px;
    }

    .practice-card {
        display: grid;
        align-content: start;
        gap: 10px;
        min-height: 260px;
        padding: 16px;
        background: var(--surface-soft);
        border: 1px solid var(--border);
