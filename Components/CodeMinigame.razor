</style>

@code {
    [Parameter]
    public string Course { get; set; } = "csharp";

    private MinigameCourseState State = new();
    private MinigameCompletionResult? LastReward;
    private MinigameAnalysisResult Analysis = new();

    private bool Ready;
    private bool ShowReward;
    private bool SystemSuccess;
    private bool AllowNavigation;

    private string SelectedDifficulty = "standard";
    private string StudentCode = "";
    private string FeedbackHeading = "System waiting";
    private string FeedbackMessage =
        "Complete the objective, then run the system.";
    private string FeedbackClass = "";
    private string SystemStatus =
        "Awaiting challenge check";

    private string? ActiveModal;
    private string? PendingNavigationLocation;

    private string Title =>
        Course == "python"
            ? "Python Control Room"
            : "C# Cave Defense";

    private string Eyebrow =>
        Course == "python"
            ? "UNDERGROUND FACILITY RESPONSE"
            : "CAVE DEFENSE CAMPAIGN";

    private string Subtitle =>
        Course == "python"
            ? "Solve randomized facility incidents with variables, alarms, loops, data, functions, files, and controls."
            : "Survive randomized cave rooms with variables, decisions, methods, collections, objects, movement, and combat.";

    private string Language =>
        Course == "python"
            ? "PYTHON"
            : "C#";

    private string PrimaryName =>
        Course == "python"
            ? "Facility stability"
            : "Explorer health";

    private string SecondaryName =>
        Course == "python"
            ? "Systems restored"
            : "Relics secured";

    private string ThreatName =>
        Course == "python"
            ? "Alarm severity"
            : "Enemy threat";

    private string DifficultyLabel =>
        string.IsNullOrWhiteSpace(State.Difficulty)
            ? "Standard"
            : char.ToUpperInvariant(State.Difficulty[0]) +
              State.Difficulty[1..];

    private string Placeholder =>
        State.Difficulty == "expert"
            ? "Expert mode begins blank."
            : "Write your solution here.";

    private bool ShowCoaching =>
        State.Difficulty is "training" or "standard";

    private int HintRevealPercent =>
        State.Difficulty == "training"
            ? 50
            : 35;

    private string HintCostLabel =>
        State.Difficulty == "training"
            ? "150 points · 10 XP"
            : "200 points · 15 XP";

    private int PotentialScore =>
        Math.Max(
            250,
            (State.Difficulty switch
            {
                "training" => 600,
                "advanced" => 1000,
                "expert" => 1250,
                _ => 800
            }) -
            State.Mistakes * 75 -
            State.HintPenalty
        );

    private string TaskTypeLabel =>
        State.Scenario?.TaskType switch
        {
            "declare" => "Variable Declaration",
            "update" => "Value Update",
            "debug" => "Debugging",
            "condition" => "Conditional Logic",
            "decision" => "Decision Branch",
            "method" => "Method Design",
            "movement" => "Movement Logic",
            "collection" => "Collections",
            "loop" => "Loop Logic",
            "object" => "Object Design",
            "combat" => "Combat Logic",
            "data" => "Data Processing",
            "function" => "Function Design",
            "file" => "File Handling",
            "automation" => "Automation Logic",
            _ => Humanize(
                State.Scenario?.TaskType ??
                "Coding Challenge"
            )
        };

    private string ConceptLabel =>
        string.IsNullOrWhiteSpace(State.Scenario?.Concept)
            ? Humanize(
                State.Scenario?.TemplateId ??
                State.Scenario?.Skill ??
                "Coding structure"
            )
            : State.Scenario.Concept;

    private string ModalIcon =>
        ActiveModal switch
        {
            "reset" => "↻",
            "leave" => "←",
            _ => "!"
        };

    private string ModalEyebrow =>
        ActiveModal switch
        {
            "reset" => "RESET ACTIVE RUN",
            "leave" => "LEAVE MINIGAME",
            _ => "QUIT ACTIVE RUN"
        };

    private string ModalTitle =>
        ActiveModal switch
        {
            "reset" => "Reset the entire campaign?",
            "leave" => "Leave and end this run?",
            _ => "Quit this minigame run?"
        };

    private string ModalMessage =>
        ActiveModal switch
        {
            "reset" =>
                $"A new shuffled practice plan will be generated using {DifficultyLabel} difficulty. Your current score, streak, health or stability, mistakes, hints, and room progress will be erased.",
            "leave" =>
                "Leaving the minigame will immediately end this active run. Its room progress and score cannot be resumed when you return.",
            _ =>
                "The active run will end immediately. Its current room, score, streak, and remaining health or stability cannot be resumed."
        };

    private string ModalCancelLabel =>
        ActiveModal switch
        {
            "reset" => "Keep current run",
            "leave" => "Stay in minigame",
            _ => "Continue playing"
        };

    private string ModalConfirmLabel =>
        ActiveModal switch
        {
            "reset" => "Reset run",
            "leave" => "Leave and end run",
            _ => "Quit run"
        };

    private string ModalConfirmClass =>
        ActiveModal == "reset"
            ? "primary"
            : "decision-danger";

    protected override async Task OnAfterRenderAsync(
        bool firstRender
    )
    {
        if (!firstRender)
        {
            return;
        }

        State =
            await MinigameService
                .GetCourseStateAsync(Course);

        LoadCode();
        await RefreshAnalysis();

        if (State.ActiveRun)
        {
            await JS.InvokeVoidAsync(
                "caveCodeMinigames.bindExitGuard",
                Course
            );
        }

        Ready = true;
        await InvokeAsync(StateHasChanged);
    }

    private static string Humanize(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Coding Challenge";
        }

        return string.Join(
            " ",
            value
                .Replace("_", " ")
                .Replace("-", " ")
                .Split(
                    ' ',
                    StringSplitOptions
                        .RemoveEmptyEntries
                )
                .Select(word =>
                    char.ToUpperInvariant(word[0]) +
                    word[1..]
                )
        );
    }

    private void ChangeDifficulty(
        ChangeEventArgs args
    )
    {
        SelectedDifficulty =
            args.Value?.ToString() ??
            "standard";
    }

    private int MasteryRoomCount =>
        Math.Max(0, State.CompletedChapters * 8);

    private string ChapterName(int chapter) =>
        Course == "python"
            ? chapter switch
            {
                1 => "Variables and Data Types",
                2 => "Conditions and Safety",
                3 => "Loops and Sequences",
                4 => "Collections and Data",
                5 => "Functions and Automation",
                _ => "Locked Chapter"
            }
            : chapter switch
            {
                1 => "Variables and Data Types",
                2 => "Conditions and Decisions",
                3 => "Methods and Movement",
                4 => "Collections and Loops",
                5 => "Classes and Objects",
                _ => "Locked Chapter"
            };

    private string ChapterDescription(int chapter) =>
        Course == "python"
            ? chapter switch
            {
                1 => "Assignments, numeric values, Boolean states, text, and updates.",
                2 => "Comparisons, combined conditions, ranges, branches, and safety decisions.",
                3 => "For loops, while loops, counting, control flow, and ordered sequences.",
                4 => "Lists, dictionaries, indexing, updates, filtering, and summaries.",
                5 => "Functions, parameters, files, classes, relays, and emergency automation.",
                _ => "Complete this learning chapter to reveal its practice pool."
            }
            : chapter switch
            {
                1 => "Whole numbers, fractional values, Boolean states, strings, and value updates.",
                2 => "Comparisons, combined conditions, ranges, branches, and decisions.",
                3 => "Methods, parameters, return values, calls, movement, and sequencing.",
                4 => "Arrays, lists, dictionaries, indexing, counts, and iteration.",
                5 => "Classes, constructors, properties, objects, state, and combat behavior.",
                _ => "Complete this learning chapter to reveal its practice pool."
            };

    private async Task StartFocused(int chapter) =>
        await StartPractice("focused", chapter);

    private async Task StartMastery() =>
        await StartPractice(
            "mastery",
            State.CompletedChapters
        );

    private async Task StartPractice(
        string mode,
        int chapter
    )
    {
        State =
            await MinigameService.StartPracticeAsync(
                Course,
                SelectedDifficulty,
                mode,
                chapter
            );

        SystemSuccess = false;
        FeedbackClass = "";
        FeedbackHeading = "Run initialized";
        FeedbackMessage =
            $"A fixed {State.RoomsTotal}-room shuffle bag was generated. Every structural style will appear exactly once.";
        SystemStatus =
            "Awaiting challenge check";

        LoadCode();
        await RefreshAnalysis();

        await JS.InvokeVoidAsync(
            "caveCodeMinigames.bindExitGuard",
            Course
        );
    }

    private async Task UpdateCode(
        ChangeEventArgs args
    )
    {
        StudentCode =
            args.Value?.ToString() ?? "";

        SystemSuccess = false;
        await RefreshAnalysis();
    }

    private async Task ResetCode()
    {
        LoadCode();
        SystemSuccess = false;
        FeedbackClass = "";
        FeedbackHeading = "Room reset";
        FeedbackMessage =
            "Starter code restored for this difficulty.";
        SystemStatus =
            "Awaiting challenge check";

        await RefreshAnalysis();
    }

    private async Task RunCode()
    {
        MinigameValidationResult check =
            await MinigameService
                .ValidateAsync(
                    Course,
                    StudentCode
                );

        State = check.State;
        SystemStatus = check.SystemStatus;

        if (!check.Valid)
        {
            SystemSuccess = false;
            FeedbackClass = "error";
            FeedbackHeading = check.Heading;
            FeedbackMessage = check.Message;

            if (State.RunFailed)
            {
                StudentCode = "";
                await JS.InvokeVoidAsync(
                    "caveCodeMinigames.unbindExitGuard"
                );
            }

            await RefreshAnalysis();
            return;
        }

        SystemSuccess = true;
        FeedbackClass = "success";
        FeedbackHeading = check.Heading;
        FeedbackMessage = check.Message;

        LastReward =
            await MinigameService.CompleteAsync(
                Course,
                StudentCode
            );

        State = LastReward.State;
        ShowReward = true;

        if (State.RunComplete)
        {
            await JS.InvokeVoidAsync(
                "caveCodeMinigames.unbindExitGuard"
            );
        }
    }

    private async Task Continue()
    {
        ShowReward = false;
        SystemSuccess = false;
        FeedbackClass = "";
        FeedbackHeading =
            State.RunComplete
                ? "Run complete"
                : "Next room ready";
        FeedbackMessage =
            State.RunComplete
                ? "Review your results."
                : "Complete the new randomized objective.";
        SystemStatus =
            State.RunComplete
                ? "Campaign stabilized"
                : "Awaiting challenge check";

        LoadCode();
        await RefreshAnalysis();
    }

    private async Task UseHint()
    {
        MinigameHintResult result =
            await MinigameService
                .UseHintAsync(Course, StudentCode);

        State = result.State;
        FeedbackClass =
            result.Allowed
                ? ""
                : "error";
        FeedbackHeading =
            result.Allowed
                ? $"{result.RevealPercent}% readable hint revealed"
                : "Hint unavailable";
        FeedbackMessage = result.Message;

        await RefreshAnalysis();
    }

    private void OpenResetModal()
    {
        ActiveModal = "reset";
        PendingNavigationLocation = null;
    }

    private void OpenQuitModal()
    {
        ActiveModal = "quit";
        PendingNavigationLocation = null;
    }

    private void CloseDecisionModal()
    {
        ActiveModal = null;
        PendingNavigationLocation = null;
    }

    private async Task ConfirmDecision()
    {
        string? decision = ActiveModal;
        string? target =
            PendingNavigationLocation;

        ActiveModal = null;
        PendingNavigationLocation = null;

        if (decision == "reset")
        {
            await ResetRun();
            return;
        }

        await TerminateRun();

        if (
            decision == "leave" &&
            !string.IsNullOrWhiteSpace(target)
        )
        {
            AllowNavigation = true;
            Navigation.NavigateTo(target);
        }
    }

    private async Task ResetRun()
    {
        State =
            await MinigameService
                .ResetRunAsync(Course);

        LastReward = null;
        ShowReward = false;
        SystemSuccess = false;
        FeedbackClass = "";
        FeedbackHeading = "Run reset";
        FeedbackMessage =
            "A new no-repeat practice plan was generated using the same difficulty and chapter pool.";
        SystemStatus =
            "Awaiting challenge check";

        LoadCode();
        await RefreshAnalysis();
    }

    private Task HandleInternalNavigation(
        LocationChangingContext context
    )
    {
        if (
            !State.ActiveRun ||
            AllowNavigation
        )
        {
            return Task.CompletedTask;
        }

        context.PreventNavigation();
        PendingNavigationLocation =
            context.TargetLocation;
        ActiveModal = "leave";

        return InvokeAsync(StateHasChanged);
    }

    private async Task TerminateRun()
    {
        State =
            await MinigameService
                .EndRunAsync(Course);

        await JS.InvokeVoidAsync(
            "caveCodeMinigames.unbindExitGuard"
        );

        StudentCode = "";
        SystemSuccess = false;
        ShowReward = false;
        FeedbackClass = "";
        FeedbackHeading = "Run ended";
        FeedbackMessage =
            "The active minigame session has been closed.";
        SystemStatus = "Run inactive";
    }

    private async Task RefreshAnalysis()
    {
        if (
            !State.ActiveRun ||
            State.Scenario is null ||
            !ShowCoaching
        )
        {
            Analysis =
                new MinigameAnalysisResult();

            return;
        }

        Analysis =
            await MinigameService.AnalyzeAsync(
                Course,
                StudentCode
            );

        await InvokeAsync(StateHasChanged);
    }

    private void LoadCode()
    {
        StudentCode =
            State.Scenario?.StarterCode ?? "";
    }
}
