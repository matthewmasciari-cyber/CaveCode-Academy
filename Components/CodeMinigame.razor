@using Microsoft.AspNetCore.Components.Routing
@inject MinigameService MinigameService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<NavigationLock ConfirmExternalNavigation="@State.ActiveRun"
                OnBeforeInternalNavigation="HandleInternalNavigation" />

<div class="mg-page">
    <header class="mg-header">
        <AcademyHomeButton />

        <div>
            <p class="eyebrow">@Eyebrow</p>
            <h1>@Title</h1>
            <p>@Subtitle</p>
        </div>

        <ProgressIdentity Compact="true" />
    </header>

    @if (!Ready)
    {
        <section class="card loading-card">
            Loading minigame state…
        </section>
    }
    else if (!State.ActiveRun)
    {
        <main class="launch">
            @if (State.RunComplete || State.RunFailed)
            {
                <section class="card result @(State.RunComplete ? "good" : "bad")">
                    <p class="eyebrow">
                        @(State.RunComplete
                            ? "RUN COMPLETE"
                            : "RUN ENDED")
                    </p>

                    <h2>
                        @(State.RunComplete
                            ? "Campaign stabilized"
                            : "System stability reached zero")
                    </h2>

                    <div class="stats">
                        <div>
                            <span>Last score</span>
                            <strong>@State.LastScore.ToString("N0")</strong>
                        </div>

                        <div>
                            <span>Best score</span>
                            <strong>@State.BestScore.ToString("N0")</strong>
                        </div>

                        <div>
                            <span>Completed runs</span>
                            <strong>@State.CompletedRuns</strong>
                        </div>

                        <div>
                            <span>Failed runs</span>
                            <strong>@State.FailedRuns</strong>
                        </div>
                    </div>
                </section>
            }

            <section class="card launch-card chapter-practice-launch">
                <p class="eyebrow">
                    CHAPTER MASTERY PRACTICE
                </p>

                @if (!State.PracticeUnlocked)
                {
                    <div class="practice-locked-panel">
                        <span class="practice-lock-icon">🔒</span>
                        <div>
                            <h2>Complete Chapter 1 to unlock</h2>
                            <p>
                                Minigames open only after a full learning
                                chapter is complete. Finish Chapter 1 to
                                unlock its eight-room focused practice run.
                            </p>
                        </div>
                    </div>
                }
                else
                {
                    <h2>
                        @State.CompletedChapters chapter
                        @(State.CompletedChapters == 1 ? "section" : "sections")
                        unlocked
                    </h2>

                    <p>
                        Every completed chapter contributes eight different
                        coding structures. A run uses each selected structure
                        exactly once, then randomizes its order, names, values,
                        entities, locations, and story details.
                    </p>

                    <label>
                        <span>Difficulty</span>

                        <select value="@SelectedDifficulty"
                                @onchange="ChangeDifficulty">
                            <option value="training">
                                Training — direct guidance and starter code
                            </option>

                            <option value="standard">
                                Standard — balanced guidance
                            </option>

                            <option value="advanced">
                                Advanced — minimal structure
                            </option>

                            <option value="expert">
                                Expert — blank editor
                            </option>
                        </select>
                    </label>

                    <div class="practice-summary">
                        <div>
                            <span>Unlocked styles</span>
                            <strong>@(State.CompletedChapters * 8)</strong>
                        </div>
                        <div>
                            <span>Focused run</span>
                            <strong>8 rooms</strong>
                        </div>
                        <div>
                            <span>Mastery run</span>
                            <strong>@MasteryRoomCount rooms</strong>
                        </div>
                        <div>
                            <span>Best score</span>
                            <strong>@State.BestScore.ToString("N0")</strong>
                        </div>
                    </div>

                    <div class="practice-grid">
                        @for (int chapter = 1; chapter <= 5; chapter++)
                        {
                            int chapterNumber = chapter;
                            bool unlocked =
                                chapterNumber <= State.CompletedChapters;

                            <article class="practice-card @(unlocked ? "unlocked" : "locked")">
                                <div class="practice-card-topline">
                                    <span>CHAPTER @chapterNumber</span>
                                    <strong>
                                        @(unlocked ? "UNLOCKED" : "LOCKED")
                                    </strong>
                                </div>

                                <h3>@ChapterName(chapterNumber)</h3>
                                <p>@ChapterDescription(chapterNumber)</p>

                                <div class="practice-card-facts">
                                    <span>8 unique structures</span>
                                    <span>Randomized every run</span>
                                </div>

                                <button type="button"
                                        class="@(unlocked ? "primary" : "secondary")"
                                        disabled="@(!unlocked)"
                                        @onclick="() => StartFocused(chapterNumber)">
                                    @(unlocked
                                        ? $"Practice Chapter {chapterNumber} →"
                                        : $"Complete Chapter {chapterNumber}")
                                </button>
                            </article>
                        }
                    </div>

                    <section class="mastery-card">
                        <div>
                            <span class="eyebrow">CUMULATIVE MASTERY</span>
                            <h3>
                                Chapters 1–@State.CompletedChapters
                                Mastery Campaign
                            </h3>
                            <p>
                                @MasteryRoomCount rooms ·
                                @MasteryRoomCount unique structures ·
                                no repeated question style
                            </p>
                        </div>

                        <button type="button"
                                class="primary"
                                @onclick="StartMastery">
                            Begin @MasteryRoomCount-room mastery run →
                        </button>
                    </section>
                }
            </section>
        </main>
    }
    else if (State.Scenario is not null)
    {
        <main class="game">
            <aside class="card side">
                <div class="row">
                    <span>ROOM</span>
                    <strong>
                        @State.RoomNumber / @State.RoomsTotal
                    </strong>
                </div>

                <div class="rooms">
                    @for (
                        int room = 1;
                        room <= State.RoomsTotal;
                        room++
                    )
                    {
                        <i class="@(room < State.RoomNumber ? "done" : room == State.RoomNumber ? "now" : "")">
                            @(room < State.RoomNumber
                                ? "✓"
                                : room.ToString())
                        </i>
                    }
                </div>

                <div class="meter">
                    <div class="row">
                        <span>@PrimaryName</span>
                        <strong>@State.PrimaryResource%</strong>
                    </div>

                    <b>
                        <i style="width:@State.PrimaryResource%"></i>
                    </b>

                    <small>
                        Wrong submissions reduce this.
                        Reaching zero ends the run.
                    </small>
                </div>

                <div class="meter threat">
                    <div class="row">
                        <span>@ThreatName</span>
                        <strong>@State.Threat%</strong>
                    </div>

                    <b>
                        <i style="width:@State.Threat%"></i>
                    </b>
                </div>

                <div class="stats two">
                    <div>
                        <span>Score</span>
                        <strong>@State.Score.ToString("N0")</strong>
                    </div>

                    <div>
                        <span>Streak</span>
                        <strong>@State.Streak</strong>
                    </div>

                    <div>
                        <span>Mistakes</span>
                        <strong>@State.Mistakes</strong>
                    </div>

                    <div>
                        <span>@SecondaryName</span>
                        <strong>@State.SecondaryResource</strong>
                    </div>
                </div>

                <div class="run-controls">
                    <button class="secondary"
                            @onclick="OpenResetModal">
                        Reset full run
                    </button>

                    <button class="secondary danger-button"
                            @onclick="OpenQuitModal">
                        Quit run
                    </button>
                </div>
            </aside>

            <section class="card challenge">
                <div class="practice-pool-banner">
                    <div>
                        <span>QUESTION POOL</span>
                        <strong>@State.PracticeLabel</strong>
                    </div>
                    <div>
                        <span>RUN PLAN</span>
                        <strong>
                            @State.RoomsTotal unique rooms · no style repeats
                        </strong>
                    </div>
                </div>
                <section class="mission-card">
                    <div class="mission-topline">
                        <span>
                            ROOM @State.RoomNumber MISSION ·
                            CHAPTER @State.Scenario.Chapter
                        </span>

                        <div class="mission-labels">
                            <strong>Task: @TaskTypeLabel</strong>
                            <strong>Concept: @ConceptLabel</strong>
                        </div>
                    </div>

                    <h2>@State.Scenario.Title</h2>

                    <div class="mission-story">
                        <span>MISSION BRIEF</span>
                        <p>@State.Scenario.Brief</p>
                    </div>
                </section>

                @if (State.Difficulty != "training")
                {
                    <div class="objective">
                        <span>OBJECTIVE</span>
                        <strong>@State.Scenario.Objective</strong>
                    </div>
                }

                @if (ShowCoaching)
                {
                    <section class="coaching-panel">
                        <div class="coaching-heading">
                            <div>
                                <span>LIVE CODING GUIDANCE</span>

                                <strong>
                                    @Analysis.MatchedElements of
                                    @Analysis.RequiredElements required
                                    elements found
                                </strong>
                            </div>

                            <button type="button"
                                    class="hint-button"
                                    disabled="@State.HintUsed"
                                    @onclick="UseHint">
                                @(State.HintUsed
                                    ? "Hint used"
                                    : $"Reveal {HintRevealPercent}% of missing code")
                            </button>
                        </div>

                        <div class="coaching-grid">
                            <div>
                                <span>Solution characters</span>
                                <strong>
                                    @Analysis.SolutionCharacters
                                </strong>
                            </div>

                            <div>
                                <span>Expected range</span>
                                <strong>
                                    @Analysis.TargetMinimum–@Analysis.TargetMaximum
                                </strong>
                            </div>

                            <div>
                                <span>Editor total</span>
                                <strong>
                                    @Analysis.EditorCharacters
                                </strong>
                            </div>

                            <div>
                                <span>Hint cost</span>
                                <strong>@HintCostLabel</strong>
                            </div>
                        </div>

                        <div class="completion-row">
                            <span>Completion estimate</span>
                            <strong>
                                @Analysis.CompletionPercent%
                            </strong>
                        </div>

                        <div class="accuracy-track">
                            <i style="width:@Analysis.CompletionPercent%"></i>
                        </div>

                        <div class="syntax-status @(SystemSuccess ? "validated" : "")">
                            <span>Challenge check</span>
                            <strong>
                                @(SystemSuccess
                                    ? "Passed"
                                    : "Not yet run")
                            </strong>
                        </div>

                        @if (State.HintUsed)
                        {
                            <div class="hint-reveal">
                                <span>
                                    @State.HintPercent% OF MISSING STRUCTURE REVEALED
                                </span>

                                <pre>@State.HintReveal</pre>

                                <small>
                                    The displayed hint uses normal
                                    C# or Python spacing. It reduced
                                    this room's score and XP and
                                    removed perfect-run eligibility.
                                </small>
                            </div>
                        }
                    </section>
                }

                <label class="editor">
                    <span>@Language EDITOR</span>

                    <textarea rows="17"
                              spellcheck="false"
                              value="@StudentCode"
                              @oninput="UpdateCode"
                              placeholder="@Placeholder"></textarea>
                </label>

                <div class="actions">
                    <button class="secondary"
                            @onclick="ResetCode">
                        Reset room
                    </button>

                    <button class="primary"
                            @onclick="RunCode">
                        Run system
                    </button>
                </div>

                <div class="feedback @FeedbackClass">
                    <strong>@FeedbackHeading</strong>
                    <span>@FeedbackMessage</span>
                </div>
            </section>

            <aside class="card sim">
                <div class="sim-head">
                    <span>LIVE CONSEQUENCE</span>

                    <strong>
                        @(SystemSuccess ? "STABLE" : "ACTIVE")
                    </strong>
                </div>

                <div class="scene @(SystemSuccess ? "success" : "")">
                    <span>@State.Scenario.VisualIcon</span>
                    <strong>@State.Scenario.SystemName</strong>
                    <small>@SystemStatus</small>
                </div>

                <div class="stats two pad">
                    <div>
                        <span>Primary term</span>
                        <strong>@State.Scenario.PrimaryTerm</strong>
                    </div>

                    <div>
                        <span>Entity</span>
                        <strong>@State.Scenario.Entity</strong>
                    </div>

                    <div>
                        <span>Difficulty</span>
                        <strong>@DifficultyLabel</strong>
                    </div>

                    <div>
                        <span>Possible score</span>
                        <strong>@PotentialScore.ToString("N0")</strong>
                    </div>
                </div>

                <div class="anti">
                    <span>ANTI-REPETITION ACTIVE</span>

                    <p>
                        Avoids the last 12 templates, six primary
                        terms, eight entities, five values, and
                        repeated task structures.
                    </p>
                </div>
            </aside>
        </main>
    }

    @if (ShowReward && LastReward is not null)
    {
        <div class="overlay">
            <section class="reward">
                <p class="eyebrow">
                    @(LastReward.NewVariation
                        ? "NEW VARIATION CLEARED"
                        : "REPEATED VARIATION")
                </p>

                <h2>@LastReward.ScenarioTitle</h2>

                <div class="stats">
                    <div>
                        <span>Room score</span>
                        <strong>
                            +@LastReward.EventScore.ToString("N0")
                        </strong>
                    </div>

                    <div>
                        <span>Experience</span>
                        <strong>+@LastReward.XpAwarded XP</strong>
                    </div>

                    <div>
                        <span>Crystals</span>
                        <strong>
                            +@LastReward.CrystalsAwarded ◆
                        </strong>
                    </div>

                    <div>
                        <span>Validated lines</span>
                        <strong>
                            +@LastReward.ValidatedLines
                        </strong>
                    </div>
                </div>

                @if (!LastReward.NewVariation)
                {
                    <p class="note">
                        Exact repeats receive reduced XP,
                        no crystals, and no duplicate line credit.
                    </p>
                }

                @if (LastReward.RunCompleted)
                {
                    <p class="bonus">
                        RUN COMPLETION BONUS INCLUDED
                    </p>
                }

                @if (LastReward.PerfectRun)
                {
                    <p class="bonus">
                        PERFECT-RUN BONUS INCLUDED
                    </p>
                }

                <button class="primary"
                        @onclick="Continue">
                    @(LastReward.RunCompleted
                        ? "View run results →"
                        : "Enter next room →")
                </button>
            </section>
        </div>
    }

    @if (ActiveModal is not null)
    {
        <div class="overlay decision-overlay">
            <section class="decision-modal">
                <div class="decision-icon">
                    @ModalIcon
                </div>

                <p class="eyebrow">@ModalEyebrow</p>
                <h2>@ModalTitle</h2>
                <p class="decision-copy">@ModalMessage</p>

                <div class="decision-stats">
                    <div>
                        <span>Current room</span>
                        <strong>
                            @State.RoomNumber / @State.RoomsTotal
                        </strong>
                    </div>

                    <div>
                        <span>Score</span>
                        <strong>@State.Score.ToString("N0")</strong>
                    </div>

                    <div>
                        <span>Streak</span>
                        <strong>@State.Streak</strong>
                    </div>

                    <div>
                        <span>@PrimaryName</span>
                        <strong>@State.PrimaryResource%</strong>
                    </div>

                    <div>
                        <span>Difficulty</span>
                        <strong>@DifficultyLabel</strong>
                    </div>
                </div>

                <div class="decision-actions">
                    <button class="secondary"
                            @onclick="CloseDecisionModal">
                        @ModalCancelLabel
                    </button>

                    <button class="@ModalConfirmClass"
                            @onclick="ConfirmDecision">
                        @ModalConfirmLabel
                    </button>
                </div>
            </section>
        </div>
    }
</div>

<style>
    .mg-page {
        min-height: 100vh;
        padding: 24px 18px 54px;
        color: var(--text);
        background:
            radial-gradient(
                circle at 8% 0%,
                var(--accent-surface),
                transparent 29%
            ),
            var(--bg);
        font-family: Inter, system-ui, sans-serif;
    }

    .mg-header,
    .launch,
    .game {
        width: min(1480px, 100%);
        margin: 0 auto;
    }

    .mg-header {
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 20px;
        align-items: start;
    }

    .mg-header h1 {
        margin: 0;
        font-size: clamp(34px, 5vw, 58px);
    }

    .mg-header p:last-child,
    .launch-card > p {
        color: var(--text-muted);
        line-height: 1.6;
    }

    .eyebrow {
        margin: 0 0 6px;
        color: var(--accent);
        font-size: 9px;
        font-weight: 950;
        letter-spacing: 1px;
    }

    .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        box-shadow: 0 16px 54px var(--shadow);
    }

    .loading-card {
        width: min(1480px, 100%);
        margin: 24px auto;
        padding: 20px;
        color: var(--text-muted);
    }

    .launch {
        display: grid;
        gap: 14px;
        margin-top: 26px;
    }

    .launch-card,
    .result {
        padding: 24px;
    }

    .launch-card h2,
    .result h2,
    .reward h2,
    .decision-modal h2 {
        margin: 0;
    }

    .launch-card label {
        display: grid;
        gap: 6px;
        margin: 18px 0;
    }

    .launch-card select {
        padding: 11px;
        color: var(--text);
        background: var(--surface-soft);
        border: 1px solid var(--border);
        border-radius: 9px;
    }

    .stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 8px;
        margin: 14px 0;
    }

    .stats div {
        padding: 10px;
        background: var(--surface-soft);
        border: 1px solid var(--border);
        border-radius: 8px;
    }

    .stats span,
    .stats strong {
        display: block;
    }

    .stats span {
        color: var(--text-muted);
        font-size: 8px;
        text-transform: uppercase;
    }

    .stats strong {
        margin-top: 4px;
        font-size: 13px;
    }

    .stats.two {
        grid-template-columns: repeat(2, 1fr);
    }

    button {
        padding: 11px 13px;
        border-radius: 8px;
        font-weight: 900;
        cursor: pointer;
    }

    .primary {
        color: var(--accent-contrast);
        background: var(--accent);
        border: 1px solid var(--accent);
    }

    .secondary {
        color: var(--text-muted);
        background: var(--surface-soft);
        border: 1px solid var(--border);
    }

    button:disabled {
        opacity: .5;
        cursor: not-allowed;
    }

    .launch-card > button {
        width: 100%;
        margin-top: 8px;
    }

    .result.good {
        border-color: var(--success-border);
        background:
            linear-gradient(
                135deg,
                var(--success-surface),
                var(--surface)
            );
    }

    .result.bad {
        border-color: var(--danger-border);
        background:
            linear-gradient(
                135deg,
                var(--danger-surface),
                var(--surface)
            );
    }

    .game {
        display: grid;
        grid-template-columns:
            minmax(230px, .72fr)
            minmax(440px, 1.5fr)
            minmax(285px, .86fr);
        gap: 13px;
        margin-top: 24px;
    }

    .side {
        display: flex;
        min-height: 720px;
        flex-direction: column;
        gap: 10px;
        padding: 14px;
    }

    .row {
        display: flex;
        justify-content: space-between;
        gap: 8px;
    }

    .row span {
        color: var(--text-muted);
        font-size: 8px;
        text-transform: uppercase;
    }

    .rooms {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 5px;
    }

    .rooms i {
        display: grid;
        height: 30px;
        place-items: center;
        background: var(--surface-strong);
        border: 1px solid var(--border);
        border-radius: 7px;
        font-style: normal;
        font-size: 9px;
    }

    .rooms i.done {
        color: var(--accent-contrast);
        background: var(--accent);
    }

    .rooms i.now {
        color: var(--accent);
        background: var(--accent-surface);
        border-color: var(--accent);
    }

    .meter,
    .anti {
        padding: 10px;
        background: var(--surface-soft);
        border: 1px solid var(--border);
        border-radius: 8px;
    }

    .meter b {
        display: block;
        height: 8px;
        margin-top: 7px;
        overflow: hidden;
        background: var(--surface-strong);
        border-radius: 99px;
    }

    .meter b i {
        display: block;
        height: 100%;
        background: var(--accent);
    }

    .meter.threat b i {
        background: var(--danger-text);
    }

    .meter small {
        display: block;
        margin-top: 6px;
        color: var(--text-muted);
        font-size: 8px;
    }

    .run-controls {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 7px;
        margin-top: auto;
    }

    .danger-button {
        color: var(--danger-text);
        border-color: var(--danger-border);
        background: var(--danger-surface);
    }

    .challenge {
        padding: 19px;
    }

    .mission-card {
        padding: 17px;
        background:
            linear-gradient(
                135deg,
                var(--accent-surface),
                var(--surface-soft)
            );
        border: 1px solid var(--accent-border);
        border-radius: 12px;
    }

    .mission-topline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        color: var(--text-muted);
        font-size: 8px;
        font-weight: 950;
        letter-spacing: .7px;
    }

    .mission-topline strong {
        padding: 6px 8px;
        color: var(--accent);
        background: var(--surface);
        border: 1px solid var(--accent-border);
        border-radius: 7px;
        font-size: 8px;
        text-transform: uppercase;
    }

    .mission-card h2 {
        margin: 10px 0 0;
        font-size: clamp(28px, 3vw, 38px);
        line-height: 1.05;
        letter-spacing: -.6px;
    }

    .mission-story {
        margin-top: 14px;
        padding: 13px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-left: 4px solid var(--accent);
        border-radius: 9px;
    }

    .mission-story span {
        display: block;
        color: var(--accent);
        font-size: 8px;
        font-weight: 950;
        letter-spacing: .8px;
    }

    .mission-story p {
        margin: 6px 0 0;
        color: var(--text);
        font-size: 18px;
        font-weight: 800;
        line-height: 1.45;
    }

    .objective,
    .hint {
        margin-top: 10px;
        padding: 12px;
        background: var(--surface-soft);
        border: 1px solid var(--border);
        border-radius: 9px;
    }

    .objective span,
    .hint span,
    .anti span,
    .coaching-heading span,
    .coaching-grid span,
    .hint-reveal > span,
    .syntax-status span,
    .completion-row span {
        display: block;
        color: var(--accent);
        font-size: 8px;
        font-weight: 950;
        text-transform: uppercase;
    }

    .objective strong,
    .hint strong {
        display: block;
        margin-top: 5px;
        font-size: 11px;
    }

    .training-guidance {
        color: var(--warning-text);
        background: var(--warning-surface);
        border-color: var(--warning-border);
    }

    .coaching-panel {
        margin-top: 10px;
        padding: 13px;
        background: var(--surface-soft);
        border: 1px solid var(--accent-border);
        border-radius: 10px;
    }

    .coaching-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .coaching-heading strong {
