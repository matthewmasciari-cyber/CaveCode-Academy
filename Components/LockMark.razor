<span class="@(Compact ? "lock-mark compact" : "lock-mark")"
      role="img"
      aria-label="Locked"
      title="Locked">
    <i aria-hidden="true"></i>
</span>

<style>
    .lock-mark {
        position: relative;
        display: inline-grid;
        width: 24px;
        height: 24px;
        flex: 0 0 24px;
        place-items: center;
        color: currentColor;
        background: color-mix(in srgb, currentColor 7%, transparent);
        border: 1px solid color-mix(in srgb, currentColor 24%, transparent);
        border-radius: 7px;
    }

    .lock-mark i {
        position: relative;
        display: block;
        width: 10px;
        height: 8px;
        margin-top: 4px;
        background: currentColor;
        border-radius: 2px;
        opacity: .82;
    }

    .lock-mark i::before {
        content: "";
        position: absolute;
        left: 2px;
        top: -6px;
        width: 6px;
        height: 7px;
        box-sizing: border-box;
        border: 2px solid currentColor;
        border-bottom: 0;
        border-radius: 6px 6px 0 0;
    }

    .lock-mark i::after {
        content: "";
        position: absolute;
        left: 4px;
        top: 2px;
        width: 2px;
        height: 3px;
        background: var(--surface, #17212c);
        border-radius: 99px;
    }

    .lock-mark.compact {
        width: 18px;
        height: 18px;
        flex-basis: 18px;
        border-radius: 5px;
    }

    .lock-mark.compact i { transform: scale(.78); }
</style>

@code {
    [Parameter]
    public bool Compact { get; set; }
}
